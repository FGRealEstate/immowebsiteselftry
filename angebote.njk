---
layout: base.njk
title: Immobilienangebote Berlin, Leipzig & Dresden | Fischer & Geserich
permalink: angebote.html
description: "Aktuelle Immobilienangebote von Fischer & Geserich: Eigennutz, Kapitalanlage und Projekte mit klarer Strategie-Kennzeichnung und direkter Anfrage."
canonicalPath: /angebote.html
---
<div class="fg-offers-v3"><section class="fg-library-hero"><div class="fg-premium-shell"><p class="fg-premium-kicker fg-premium-kicker-light">Aktuelle Immobilien</p><h1>Objekte nach Strategie statt nur nach Zimmerzahl.</h1><p>Eigennutz, Kapitalanlage und Projekte werden gleichwertig dargestellt. Investmentobjekte erhalten zusätzliche Kennzahlen, wenn die dafür nötigen Daten in Propstack gepflegt sind.</p></div></section>
<section class="fg-premium-shell"><div class="fg-offer-filter"><form id="property-filter-form" class="fg-offer-filter-grid"><select id="filter-strategie" class="fg-offer-filter-control"><option value="">Strategie (Alle)</option><option value="eigennutz">Eigennutz</option><option value="kapitalanlage">Kapitalanlage</option></select><select id="filter-vermarktung" class="fg-offer-filter-control"><option value="">Vermarktung (Alle)</option>{% for type in propstack.filters.marketingTypes %}<option value="{{ type }}">{{ type }}</option>{% endfor %}</select><select id="filter-objektart" class="fg-offer-filter-control"><option value="">Objektart (Alle)</option>{% for type in propstack.filters.propertyTypes %}<option value="{{ type }}">{{ type }}</option>{% endfor %}</select><input id="filter-preis" class="fg-offer-filter-control" inputmode="numeric" placeholder="Max. Preis (€)"><select id="filter-sortierung" class="fg-offer-filter-control"><option value="">Sortierung</option><option value="price-asc">Preis aufsteigend</option><option value="price-desc">Preis absteigend</option><option value="yield-desc">Rendite absteigend</option><option value="area-desc">Fläche absteigend</option></select><button class="btn-85 fg-offer-filter-button" type="submit"><i class="fas fa-search"></i> Angebote filtern</button></form><button id="filter-reset" type="button" class="mt-4 text-sm font-bold text-primary">Filter zurücksetzen</button></div>
<section><div class="fg-offer-section-head"><div><p class="fg-premium-kicker">Projekte</p><h2>Projektangebote</h2></div><span class="fg-library-count">{{ propstack.projects | length }} Projekte</span></div><div class="fg-offer-grid">{% for project in propstack.projects %}<article class="fg-offer-card fg-project-card offer-filter-card" data-strategie="{{ project.strategy_keys | join(',') }}" data-vermarktung="{{ project.marketing_type }}" data-objektart="projekt" data-preis="{{ project.min_price_raw or '' }}" data-flaeche="{{ project.max_area or '' }}" data-rendite=""><a href="{{ project.url }}" class="fg-offer-card-media">{% if project.main_image %}<img src="{{ project.main_image }}" alt="{{ project.name }}" loading="lazy">{% else %}<div class="h-full grid place-items-center text-primary"><i class="fas fa-building text-5xl"></i></div>{% endif %}<div class="fg-offer-badges"><span class="fg-offer-badge gold">Projekt</span><span class="fg-offer-badge">{{ project.strategy }}</span></div></a><div class="fg-offer-card-body"><div class="fg-offer-card-eyebrow"><span>{{ project.available_unit_count }} Einheiten</span><span>{{ project.marketing_type }}</span></div><h3>{{ project.name }}</h3><p class="fg-offer-location"><i class="fas fa-location-dot"></i> {{ project.location or 'Standort auf Anfrage' }}</p><p class="fg-offer-price">{{ project.price_range or 'Preis auf Anfrage' }}</p><div class="fg-offer-facts"><div class="fg-offer-fact"><small>Wohnflächen</small><strong>{{ project.area_range or 'variabel' }}</strong></div><div class="fg-offer-fact"><small>Zimmer</small><strong>{{ project.room_range or 'variabel' }}</strong></div></div><a href="{{ project.url }}" class="fg-offer-card-link"><span>Projekt ansehen</span><i class="fas fa-arrow-right"></i></a></div></article>{% endfor %}</div></section>
<section style="padding:22px 0 80px"><div class="fg-offer-section-head"><div><p class="fg-premium-kicker">Einzelobjekte</p><h2>Aktuelle Einheiten</h2></div><span class="fg-library-count"><b id="object-count">{{ propstack.standaloneProperties | length }}</b> Treffer</span></div>{% if propstack.standaloneProperties and propstack.standaloneProperties.length %}<div id="property-grid" class="fg-offer-grid">{% for property in propstack.standaloneProperties %}<article class="fg-offer-card offer-filter-card property-card" data-strategie="{{ property.strategy_key }}" data-vermarktung="{{ property.marketing_type or '' }}" data-objektart="{{ property.property_type or '' }}" data-preis="{{ property.price_raw or '' }}" data-flaeche="{{ property.living_space_raw or '' }}" data-rendite="{{ property.gross_yield_raw or '' }}"><a href="{{ property.url }}" class="fg-offer-card-media">{% if property.main_image %}<img src="{{ property.main_image }}" alt="{{ property.title }}" loading="lazy">{% else %}<div class="h-full grid place-items-center text-primary"><i class="fas fa-home text-5xl"></i></div>{% endif %}<div class="fg-offer-badges"><span class="fg-offer-badge gold">{{ property.strategy }}</span>{% if property.marketing_type %}<span class="fg-offer-badge">{{ property.marketing_type }}</span>{% endif %}</div></a><div class="fg-offer-card-body"><div class="fg-offer-card-eyebrow"><span>{{ property.property_type or 'Immobilie' }}</span>{% if property.unit_number %}<span>{{ property.unit_number }}</span>{% endif %}</div><h3>{{ property.title }}</h3><p class="fg-offer-location"><i class="fas fa-location-dot"></i> {{ property.location or 'Standort auf Anfrage' }}</p><p class="fg-offer-price">{{ property.price or 'Preis auf Anfrage' }}</p><div class="fg-offer-facts">{% if property.living_space %}<div class="fg-offer-fact"><small>Wohnfläche</small><strong>{{ property.living_space }}</strong></div>{% endif %}{% if property.rooms %}<div class="fg-offer-fact"><small>Zimmer</small><strong>{{ property.rooms }}</strong></div>{% endif %}{% if property.is_investment and property.gross_yield %}<div class="fg-offer-fact"><small>Bruttorendite</small><strong>{{ property.gross_yield }}</strong></div>{% endif %}{% if property.is_investment and property.cold_rent %}<div class="fg-offer-fact"><small>Kaltmiete</small><strong>{{ property.cold_rent }}</strong></div>{% endif %}</div><a href="{{ property.url }}" class="fg-offer-card-link"><span>Objekt ansehen</span><i class="fas fa-arrow-right"></i></a></div></article>{% endfor %}</div><div id="no-results" class="fg-library-empty">Keine passenden Immobilien gefunden.</div>{% else %}<div class="fg-premium-card text-center">Aktuell sind keine Einzelobjekte freigegeben.</div>{% endif %}</section></section>
<section class="fg-premium-section fg-premium-section-dark"><div class="fg-premium-shell"><div class="fg-premium-cta"><div><p class="fg-premium-kicker fg-premium-kicker-light">Nichts Passendes dabei?</p><h2>Gesuch hinterlegen statt täglich Portale prüfen.</h2><p>Ihr Suchprofil läuft über unsere bestehende Propstack-Strecke und kann passend zu neuen Angeboten berücksichtigt werden.</p></div><a href="/gesuch-anlegen/" class="btn-85 px-7 py-4">Gesuch anlegen <i class="fas fa-arrow-right"></i></a></div></div></section></div>
<script>
(function(){const form=document.getElementById('property-filter-form'),cards=[...document.querySelectorAll('.offer-filter-card')],count=document.getElementById('object-count'),no=document.getElementById('no-results');if(!form||!cards.length)return;const parse=v=>{const n=Number(String(v||'').replace(/\./g,'').replace(',','.').replace(/[^0-9.]/g,''));return Number.isFinite(n)?n:0};function run(e){e?.preventDefault();const strategy=document.getElementById('filter-strategie').value.toLowerCase(),marketing=document.getElementById('filter-vermarktung').value.toLowerCase(),type=document.getElementById('filter-objektart').value.toLowerCase(),max=parse(document.getElementById('filter-preis').value),sort=document.getElementById('filter-sortierung').value;let visible=cards.filter(c=>(!strategy||String(c.dataset.strategie||'').split(',').includes(strategy))&&(!marketing||c.dataset.vermarktung.toLowerCase()===marketing)&&(!type||c.dataset.objektart.toLowerCase().includes(type))&&(!max||!parse(c.dataset.preis)||parse(c.dataset.preis)<=max));cards.forEach(c=>c.hidden=!visible.includes(c));const grid=document.getElementById('property-grid');if(grid){const units=visible.filter(c=>c.classList.contains('property-card'));if(sort){units.sort((a,b)=>sort==='price-asc'?parse(a.dataset.preis)-parse(b.dataset.preis):sort==='price-desc'?parse(b.dataset.preis)-parse(a.dataset.preis):sort==='yield-desc'?parse(b.dataset.rendite)-parse(a.dataset.rendite):sort==='area-desc'?parse(b.dataset.flaeche)-parse(a.dataset.flaeche):0);units.forEach(c=>grid.appendChild(c))}if(count)count.textContent=units.length;if(no)no.style.display=units.length?'none':'block'}}form.addEventListener('submit',run);['filter-strategie','filter-vermarktung','filter-objektart','filter-sortierung'].forEach(id=>document.getElementById(id)?.addEventListener('change',run));document.getElementById('filter-reset')?.addEventListener('click',()=>{form.reset();document.getElementById('filter-preis').value='';run()});run()})();
</script>
