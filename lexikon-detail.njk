---
layout: base.njk
pagination:
  data: labContent.lexicon
  size: 1
  alias: entry
permalink: "lexikon/{{ entry.slug }}/index.html"
eleventyComputed:
  title: "{{ entry.term }} – Immobilienlexikon"
  description: "{{ entry.definition }}"
---
<main class="content-detail shell"><nav class="breadcrumbs"><a href="/investment-lab.html">Investment Lab</a><span>›</span><a href="/investment-lab.html#lexikon">Lexikon</a><span>›</span><span>{{ entry.term }}</span></nav><article class="science-article"><header><span class="lab-kicker">{{ entry.category or "IMMOBILIENLEXIKON" }}</span><h1>{{ entry.term }}</h1><p class="lead">{{ entry.definition }}</p></header><section><h2>Einordnung</h2><p>{{ entry.explanation or entry.definition }}</p></section>{% if entry.formula %}<section><h2>Rechenlogik</h2><div class="lab-formula-card"><div class="lab-formula">{{ entry.formula }}</div></div></section>{% endif %}{% if entry.practiceExample %}<section class="lab-example-section"><h2>Praxisbeispiel</h2><div class="lab-interpretation"><p>{{ entry.practiceExample }}</p></div></section>{% endif %}{% if entry.checklist and entry.checklist.length %}<section><h2>Prüffragen</h2><ul>{% for item in entry.checklist %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}{% if entry.sources and entry.sources.length %}<section class="lab-source-section"><h2>Quellen &amp; Rechtsgrundlagen</h2><ul>{% for source in entry.sources %}<li><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label }}</a></li>{% endfor %}</ul></section>{% endif %}<aside class="article-note"><strong>Hinweis</strong><p>Die Erläuterung dient der fachlichen Orientierung und ersetzt keine individuelle Rechts-, Steuer- oder Finanzierungsberatung.</p></aside><a class="lab-btn lab-btn-gold" href="/investment-lab.html">Im Investment Lab weiterarbeiten</a></article></main>
