---
pagination:
  data: collections.sitemapSections
  size: 1
  alias: section
permalink: "sitemap-{{ section.key }}.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ section.title }} — {{ section.count }} URLs, erzeugt beim Build. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for url in section.urls %}
  <url>
    <loc>https://fg-realestate.de{{ url.loc }}</loc>
    <lastmod>{{ url.lastmod }}</lastmod>
  </url>
{%- endfor %}
</urlset>
