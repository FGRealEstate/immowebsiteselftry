<section class="lab-hero lab-hero-final lab-hero-v2">
  <div class="lab-shell lab-hero-v2-grid">
    <div class="lab-hero-v2-copy">
      <span class="lab-kicker">F&amp;G INVESTMENT LAB</span>
      <h1>Immobilien besser entscheiden.</h1>
      <p class="lab-hero-lead">Rechnen, einordnen und vergleichen – mit einem Arbeitsbereich für Kapitalanlage, Finanzierung, Standorte und Immobilienwissen.</p>
      <div class="lab-hero-points" aria-label="Investment Lab Funktionen">
        <span><i class="fas fa-calculator"></i> Rechner</span>
        <span><i class="fas fa-book-open"></i> Wissen</span>
        <span><i class="fas fa-location-dot"></i> Standorte</span>
        <span><i class="fas fa-spell-check"></i> Lexikon</span>
      </div>
    </div>

    <aside class="lab-command-card" aria-label="Schnelleinstieg Investment Lab">
      <span class="lab-command-label">Direkt einsteigen</span>
      <h2>Womit möchten Sie starten?</h2>
      <div class="lab-command-grid">
        <button type="button" data-lab-jump="tools"><i class="fas fa-chart-line"></i><span><strong>Kapitalanlage prüfen</strong><small>Rendite, Cashflow &amp; Finanzierung</small></span><i class="fas fa-arrow-right"></i></button>
        <button type="button" data-lab-jump="knowledge"><i class="fas fa-lightbulb"></i><span><strong>Frage verstehen</strong><small>Zusammenhänge kompakt erklärt</small></span><i class="fas fa-arrow-right"></i></button>
        <button type="button" data-lab-jump="locations"><i class="fas fa-map-location-dot"></i><span><strong>Standort einordnen</strong><small>Mikrolage, Chancen &amp; Risiken</small></span><i class="fas fa-arrow-right"></i></button>
        <button type="button" data-lab-jump="lexicon"><i class="fas fa-book"></i><span><strong>Begriff nachschlagen</strong><small>Immobilienwissen ohne Umwege</small></span><i class="fas fa-arrow-right"></i></button>
      </div>
    </aside>

    <form class="lab-navigator lab-navigator-v2" data-lab-navigator>
      <label for="lab-global-search">Eine Frage reicht.</label>
      <p>Beschreiben Sie, was Sie wissen oder berechnen möchten. Wir führen Sie zum passenden Werkzeug.</p>
      <div class="lab-navigator-row">
        <input id="lab-global-search" type="search" autocomplete="off" placeholder="z. B. Wie viel Eigenkapital brauche ich für eine Kapitalanlage?" data-global-search>
        <button type="submit" class="lab-btn lab-btn-gold"><span>Antwort finden</span><i class="fas fa-arrow-right"></i></button>
      </div>
      <div class="lab-quick-links">
        <button type="button" data-query="Eigenkapitalrendite">Eigenkapitalrendite</button>
        <button type="button" data-query="Kaufpreisrahmen">Kaufpreisrahmen</button>
        <button type="button" data-query="Hausgeld">Hausgeld verstehen</button>
        <button type="button" data-query="Standort Leipzig">Standort Leipzig</button>
      </div>
      <div class="lab-navigator-result" data-global-result hidden></div>
    </form>
  </div>
</section>

<main class="lab-shell lab-main" data-investment-lab>
  <nav class="lab-tabs" aria-label="Investment Lab Bereiche">
    <button class="is-active" data-lab-tab="tools">Rechner</button>
    <button data-lab-tab="knowledge">Immobilienwissen</button>
    <button data-lab-tab="locations">Standorte</button>
    <button data-lab-tab="lexicon">Lexikon</button>
  </nav>

  <section class="lab-panel is-active" data-lab-panel="tools">
    <section class="lab-featured-calculator">
      <div>
        <span class="lab-kicker">HAUPTRECHNER</span>
        <h2>Investitionsrechner für Ihre Immobilien-Kapitalanlage</h2>
        <p>Prüfen Sie Kaufpreis, Miete, Finanzierung, Steuern, Cashflow, Tilgung, Restschuld und Vermögensentwicklung in einer geführten Gesamtrechnung.</p>
        <div class="lab-featured-actions">
          <button type="button" class="lab-btn lab-btn-gold" data-toggle-investment>Investitionsrechner öffnen</button>
          <a class="lab-btn lab-btn-ghost-dark" href="/ankaufsberatung.html">Ergebnis besprechen</a>
        </div>
      </div>
      <div class="lab-featured-metrics">
        <span>Cashflow</span><span>Steuerwirkung</span><span>Restschuld</span><span>EK-Rendite</span>
      </div>
    </section>
    <div class="lab-investment-embed" data-investment-embed hidden>
      <div class="lab-embed-head"><strong>Investitionsrechner</strong><button type="button" data-toggle-investment>Schließen</button></div>
      <iframe title="F&G Investitionsrechner" loading="lazy" data-src="/investitionsrechner.html?embedded=1"></iframe>
    </div>
    <div class="lab-section-head">
      <div><span class="lab-kicker">WEITERE RECHNER</span><h2>Wählen Sie die Frage – nicht die Formel.</h2><p>Die kompakten Rechner öffnen sich direkt im Investment Lab.</p></div>
      <div class="lab-search"><input type="search" placeholder="Rechner suchen …" data-tool-search></div>
    </div>
    <div class="lab-tool-grid" data-tool-grid></div>
    <div class="lab-workspace" data-lab-workspace hidden></div>
    <div class="lab-saved" data-lab-saved></div>
  </section>

  <section class="lab-panel" data-lab-panel="knowledge">
    <div class="lab-section-head"><div><span class="lab-kicker">IMMOBILIENWISSEN</span><h2>Fundierte Antworten statt isolierter Kennzahlen.</h2><p>Definition, Einordnung, Rechenlogik, Einflussgrößen, Grenzen, Praxisbeispiel und Interpretation.</p></div><div class="lab-search"><input type="search" placeholder="Thema oder Frage suchen …" data-knowledge-search></div></div>
    <div class="lab-filter-row" data-knowledge-filters></div><div class="lab-article-grid" data-article-grid></div><article class="lab-reader" data-article-reader hidden></article>
  </section>
  <section class="lab-panel" data-lab-panel="locations">
    <div class="lab-section-head"><div><span class="lab-kicker">STANDORTANALYSEN</span><h2>Ein Markt beginnt bei der Mikrolage.</h2><p>Orientierungswerte, Chancen, Risiken, Infrastruktur und regionale Einordnung.</p></div><div class="lab-search"><input type="search" placeholder="Berlin, Potsdam, Bernau …" data-location-search></div></div>
    <div class="lab-location-grid" data-location-grid></div><article class="lab-reader lab-location-reader" data-location-reader hidden></article>
  </section>
  <section class="lab-panel" data-lab-panel="lexicon">
    <div class="lab-section-head"><div><span class="lab-kicker">IMMOBILIENLEXIKON</span><h2>Fachbegriffe verständlich und belastbar eingeordnet.</h2><p>Definitionen, Zusammenhänge, Rechenlogiken und praktische Prüffragen.</p></div><div class="lab-search"><input type="search" placeholder="Begriff suchen …" data-lexicon-search></div></div>
    <div class="lab-az" data-az></div><div class="lab-lexicon-list" data-lexicon-list></div><article class="lab-reader lab-lexicon-reader" data-lexicon-reader hidden></article>
  </section>

  <section class="lab-cta"><div><span class="lab-kicker">ERGEBNISSE GEMEINSAM EINORDNEN</span><h2>Eine Berechnung zeigt Zusammenhänge. Die Entscheidung braucht Kontext.</h2><p>In der Ankaufsberatung prüfen wir Annahmen, Unterlagen, Finanzierung und Risiken gemeinsam.</p></div><a href="/ankaufsberatung.html" class="lab-btn lab-btn-gold">Ankaufsberatung anfragen</a></section>
</main>
<script>
document.addEventListener('click', function (event) {
  const trigger = event.target.closest('[data-lab-jump]');
  if (!trigger) return;
  const target = trigger.getAttribute('data-lab-jump');
  const tab = document.querySelector('[data-lab-tab="' + target + '"]');
  if (tab) {
    tab.click();
    document.querySelector('.lab-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
});
</script>
<script>window.FG_LAB_DATA={{ labContent | json | safe }};</script>
<script src="/investment-lab.js" defer></script>
