{%- set stimmen = [
  { autor: "Marc", zitat: "ohne mir irgendetwas schönzureden", berater: "timon", thema: "Kauf" },
  { autor: "Jennifer", zitat: "zu keiner Zeit zu etwas gedrängt gefühlt", berater: "lennart", thema: "Ankaufsberatung" },
  { autor: "Maria", zitat: "Man hatte nie das Gefühl, dass einem einfach irgendeine Finanzierung verkauft werden soll", thema: "Finanzierung" },
  { autor: "Jan", zitat: "dass unsere Interessen als Eigentümer ernst genommen werden", thema: "Vermietung" }
] %}
{%- set kurz = ["Justin", "Philipp", "Wil", "Aurelio", "Theodor", "Anna", "Finn", "VIVESS", "Constantin"] %}
{%- set laufband = [] %}
{%- for name in kurz %}{% for r in google.reviews | selectattr("text") %}{% if r.author == name and r.text.length <= 200 %}{% set _ = laufband.push(r) %}{% endif %}{% endfor %}{% endfor %}
<section class="fgs-section fgs-reviews" id="bewertungen" aria-labelledby="bewertungen-titel">
  <div class="fgs-wrap">
    <div class="fgs-head"><h2 id="bewertungen-titel">Was Kunden über uns sagen</h2></div>
    <div class="fgs-reviews-grid">
      <div class="fgs-reviews-aside">
        <p class="fgs-reviews-score">{{ google.rating }}<span class="fgs-sr"> von 5 Sternen</span></p>
        <p class="fgs-reviews-stars" aria-hidden="true">★★★★★</p>
        <p class="fgs-reviews-count">{{ google.rating }} von 5 · {{ google.count }} Google-Bewertungen</p>
        <p class="fgs-reviews-links"><a class="fgs-link" href="{{ google.url }}" target="_blank" rel="noopener">Alle Bewertungen</a>{{ textlink(nav.menu[5].items[3] | navHref, "So bewerten Sie uns") }}</p>
      </div>
      <ul class="fgs-reviews-list" role="list">
        {#- Update 22 §6: drei Pull-Quotes in einer Reihe (Marc, Jennifer, Maria); Jan steht weiter auf /bewertungen/ -#}
        {%- for s in stimmen.slice(0, 3) %}{% for r in google.reviews | selectattr("text") %}{% if r.author == s.autor %}
        {{ stimme(r, s) }}
        {%- endif %}{% endfor %}{% endfor %}
      </ul>
    </div>
  </div>
  {%- if laufband.length %}
  {#- Update 23 A3: kein Pause-Knopf mehr; das Laufband hält unter der Maus, unter dem Finger und bei Tastaturfokus an (fg-system.js, CSS) -#}
  <div class="fgs-ticker" id="fgs-laufband" aria-label="Weitere Bewertungen auf Google" role="region">
    <ul class="fgs-ticker-track" role="list">
      {%- for r in laufband %}
      {{ kurzstimme(r) }}
      {%- endfor %}
      {%- for r in laufband %}
      {{ kurzstimme(r, true) }}
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}
</section>
{% else %}
<section class="fgs-section" id="bewertungen" aria-labelledby="bewertungen-titel">
  <div class="fgs-wrap">
    <div class="fgs-head fgs-head--centre">
      <h2 class="fgs-h2-chapter" id="bewertungen-titel">Was Kunden über uns sagen</h2>
      <p>Die aktuelle Gesamtbewertung unseres Google-Unternehmensprofils. Alle Rezensionen lesen Sie im Original direkt bei Google.</p>
      <p>{{ google.rating }} von 5 · {{ google.count }} Bewertungen auf Google</p>
      <div class="fgs-btns"><a class="fgs-btn fgs-btn--secondary" href="{{ google.url }}" target="_blank" rel="noopener">Rezensionen bei Google lesen</a>{{ textlink(nav.menu[5].items[3] | navHref, "So bewerten Sie uns") }}</div>
    </div>
  </div>
</section>
{% endif %}

{# 10. Häufige Fragen (5 sichtbar, Rest hinter „Weitere Fragen“; Update 7 §2). Texte nach Update 20 in faqListe oben. #}
{{ faq(faqItems, sichtbar=5) }}

{# 11. Abschlussband. Design-Pass 3 §3.11: Rahmen mit Foto (Video nach dem Download-OK), die fünf Anliegen als Glas-Pillen ohne Unterzeilen, ohne die Zeile „Das erste Gespräch …“ (nicht in der Liste des Briefs). #}
{% call closing({ kontakt: "lennart", satz: "Wie können wir helfen?", button: "bewertung" }) %}
  <p>Wählen Sie Ihr Anliegen oder rufen Sie uns einfach an.</p>
  <ul class="fgs-closing-links" role="list">
    <li><a href="/verkaufen.html">Immobilie verkaufen</a></li>
    <li><a href="/kaufen.html">Immobilie kaufen</a></li>
    <li><a href="/finanzierungsberatung.html">Finanzierung</a></li>
    <li><a href="/vermieten.html">Immobilie vermieten</a></li>
    <li><a href="/mieten.html">Immobilie mieten</a></li>
  </ul>
{% endcall %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://fg-realestate.de/#faq",
  "isPartOf": { "@id": "https://fg-realestate.de/#website" },
  "about": { "@id": "https://fg-realestate.de/#organization" },
  "mainEntity": [
    {% for item in faqItems %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
