<script>
document.addEventListener("DOMContentLoaded", function () {
    const cards = Array.from(document.querySelectorAll(".home-property-card"));
    const prevDesktop = document.getElementById("home-slider-prev");
    const nextDesktop = document.getElementById("home-slider-next");
    const slider = document.getElementById("home-property-slider");
    const status = document.getElementById("home-slider-status");

    if (cards.length) {
        const visibleCount = 3;
        const maxCards = Math.min(cards.length, 9);
        let startIndex = 0;

        function updateCards() {
            cards.forEach(function (card, index) {
                const isVisible = index >= startIndex && index < startIndex + visibleCount;
                card.classList.toggle("hidden", !isVisible);
            });
            const visibleNow = cards.filter((card, index) => index >= startIndex && index < Math.min(startIndex + visibleCount, maxCards));
            slider?.classList.toggle("is-centered", visibleNow.length < 3);
            if (status) {
                const first = Math.min(startIndex + 1, maxCards);
                const last = Math.min(startIndex + visibleCount, maxCards);
                status.textContent = `${String(first).padStart(2,"0")}–${String(last).padStart(2,"0")} / ${String(maxCards).padStart(2,"0")}`;
            }
        }
        function next() {
            if (maxCards <= visibleCount) return;
            startIndex += visibleCount;
            if (startIndex >= maxCards) startIndex = 0;
            updateCards();
        }
        function prev() {
            if (maxCards <= visibleCount) return;
            startIndex -= visibleCount;
            if (startIndex < 0) startIndex = Math.max(0, maxCards - visibleCount);
            updateCards();
        }
        if (nextDesktop) nextDesktop.addEventListener("click", next);
        if (prevDesktop) prevDesktop.addEventListener("click", prev);
        updateCards();
    }

    document.querySelectorAll(".fg-home-v2-faq-list details").forEach(function(detail){
        detail.addEventListener("toggle", function(){
            const icon = detail.querySelector("summary i");
            if (icon) {
                icon.classList.toggle("fa-plus", !detail.open);
                icon.classList.toggle("fa-minus", detail.open);
            }
        });
    });
});
</script>

