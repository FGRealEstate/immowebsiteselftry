<script>
document.addEventListener("DOMContentLoaded", function () {
    const cards = Array.from(document.querySelectorAll(".home-property-card"));
    const prevDesktop = document.getElementById("home-slider-prev");
    const nextDesktop = document.getElementById("home-slider-next");
    const slider = document.getElementById("home-property-slider");
    const status = document.getElementById("home-slider-status");

    if (cards.length) {
        const visibleCount = 3;
        const maxCards = Math.min(cards.length, 9);
        let startIndex = 0;

        function updateCards() {
            cards.forEach(function (card, index) {
                const isVisible = index >= startIndex && index < startIndex + visibleCount;
                card.classList.toggle("hidden", !isVisible);
            });
            const visibleNow = cards.filter((card, index) => index >= startIndex && index < Math.min(startIndex + visibleCount, maxCards));
            slider?.classList.toggle("is-centered", visibleNow.length < 3);
            if (status) {
                const first = Math.min(startIndex + 1, maxCards);
                const last = Math.min(startIndex + visibleCount, maxCards);
                status.textContent = `${String(first).padStart(2,"0")}–${String(last).padStart(2,"0")} / ${String(maxCards).padStart(2,"0")}`;
            }
        }
        function next() {
            if (maxCards <= visibleCount) return;
            startIndex += visibleCount;
            if (startIndex >= maxCards) startIndex = 0;
            updateCards();
        }
        function prev() {
            if (maxCards <= visibleCount) return;
            startIndex -= visibleCount;
            if (startIndex < 0) startIndex = Math.max(0, maxCards - visibleCount);
            updateCards();
        }
        if (nextDesktop) nextDesktop.addEventListener("click", next);
        if (prevDesktop) prevDesktop.addEventListener("click", prev);
        updateCards();
    }

    document.querySelectorAll(".fg-home-deepdive-list details").forEach(function(detail){
        detail.addEventListener("toggle", function(){
            const icon = detail.querySelector("summary i");
            if (!icon) return;
            icon.classList.toggle("fa-plus", !detail.open);
            icon.classList.toggle("fa-minus", detail.open);
        });
    });

    document.querySelectorAll(".fg-home-v2-faq-list details").forEach(function(detail){
        detail.addEventListener("toggle", function(){
            const icon = detail.querySelector("summary i");
            if (icon) {
                icon.classList.toggle("fa-plus", !detail.open);
                icon.classList.toggle("fa-minus", detail.open);
            }
        });
    });

    const faqQuestionToggle = document.querySelector("[data-faq-question-toggle]");
    const faqQuestionPanel = document.getElementById("faq-question-panel");
    const faqQuestionForm = document.querySelector("[data-faq-question-form]");
    const faqQuestionStatus = document.querySelector("[data-faq-question-status]");

    faqQuestionToggle?.addEventListener("click", function () {
        if (!faqQuestionPanel) return;
        const willOpen = faqQuestionPanel.hidden;
        faqQuestionPanel.hidden = !willOpen;
        faqQuestionToggle.setAttribute("aria-expanded", String(willOpen));
        faqQuestionToggle.classList.toggle("is-open", willOpen);
        const icon = faqQuestionToggle.querySelector("i");
        if (icon) {
            icon.classList.toggle("fa-arrow-right", !willOpen);
            icon.classList.toggle("fa-xmark", willOpen);
        }
        if (willOpen) {
            requestAnimationFrame(function () {
                faqQuestionPanel.querySelector('input[name="name"]')?.focus({ preventScroll: true });
            });
        }
    });

    faqQuestionForm?.addEventListener("submit", async function (event) {
        event.preventDefault();
        if (!faqQuestionForm.reportValidity()) return;

        const submit = faqQuestionForm.querySelector('button[type="submit"]');
        const original = submit.innerHTML;
        submit.disabled = true;
        submit.textContent = "Wird gesendet …";
        if (faqQuestionStatus) faqQuestionStatus.hidden = true;

        const fd = new FormData(faqQuestionForm);
        const payload = {
            name: fd.get("name"),
            email: fd.get("email"),
            phone: fd.get("phone"),
            question: fd.get("question"),
            company_website: fd.get("company_website"),
            privacy_consent: fd.get("privacy_consent") === "true",
            source_url: location.href + "#faq"
        };

        try {
            const response = await fetch("/.netlify/functions/website-question", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.error || "Versand fehlgeschlagen");

            faqQuestionForm.reset();
            if (faqQuestionStatus) {
                faqQuestionStatus.className = "fg-faq-question-status is-success";
                faqQuestionStatus.textContent = "Vielen Dank. Ihre Frage wurde direkt an uns gesendet.";
                faqQuestionStatus.hidden = false;
            }
        } catch (error) {
            if (faqQuestionStatus) {
                faqQuestionStatus.className = "fg-faq-question-status is-error";
                faqQuestionStatus.textContent = "Die Nachricht konnte gerade nicht versendet werden. Bitte schreiben Sie an info@fg-realestate.de.";
                faqQuestionStatus.hidden = false;
            }
        } finally {
            submit.disabled = false;
            submit.innerHTML = original;
        }
    });
});
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://fg-realestate.de/#faq",
  "isPartOf": { "@id": "https://fg-realestate.de/#website" },
  "about": { "@id": "https://fg-realestate.de/#organization" },
  "mainEntity": [
    {% for item in mangoTexte.faq.A %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
