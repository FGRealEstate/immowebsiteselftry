---
layout: base.njk
permalink: "standorte/index.html"
title: "Standorte - Immobilienmärkte Berlin, Brandenburg und Sachsen"
description: "Standortanalysen mit Kaufpreisorientierung, Mietniveau, Rendite, Chancen und Risiken für Berlin, Brandenburg und Sachsen."
canonicalPath: /standorte/
---
<div class="fg-location-index">
  <section class="fg-library-hero fg-location-index-hero">
    <div class="fg-premium-shell">
      <p class="fg-premium-kicker fg-premium-kicker-light">Investment Lab · Standorte</p>
      <h1>Standorte nicht pauschal bewerten. Mikrolagen verstehen.</h1>
      <p>{{ labContent.locations | length }} Standortanalysen mit Kaufpreisorientierung, Mietniveau sowie einer klaren Einordnung von Chancen und Risiken.</p>
    </div>
  </section>

  <section class="fg-location-index-section">
    <div class="fg-premium-shell">
      <div class="fg-library-toolbar fg-location-toolbar">
        <label class="fg-library-search">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input type="search" placeholder="Standort oder Region suchen …" aria-label="Standort oder Region suchen" data-library-search>
        </label>
        <span class="fg-library-count"><b data-library-count>{{ labContent.locations | length }}</b> Standortanalysen</span>
      </div>

      <div class="fg-library-grid fg-location-card-grid" data-library-grid>
        {% for entry in labContent.locations %}
        <a class="fg-location-card" href="/standorte/{{ entry.slug }}/" data-library-card data-search="{{ entry.name }} {{ entry.region }} {{ entry.chance }} {{ entry.risk }} {{ entry.view }}">
          <header class="fg-location-card-header">
            <div>
              <span class="fg-location-card-region">{{ entry.region }}</span>
              <h2>{{ entry.name }}</h2>
            </div>
            <span class="fg-location-card-icon" aria-hidden="true"><i class="fas fa-arrow-up-right-from-square"></i></span>
          </header>

          <dl class="fg-location-card-facts">
            <div><dt>Kaufpreis</dt><dd>{{ entry.priceValue or entry.price }}</dd></div>
            <div><dt>Mietniveau</dt><dd>{{ entry.rentValue or entry.rent }}</dd></div>
            <div><dt>Rendite</dt><dd>{{ entry.yieldValue or entry.yield }}</dd></div>
          </dl>

          <p class="fg-location-card-summary">{{ entry.view }}</p>
          <span class="fg-location-card-link">Standortanalyse öffnen <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        {% endfor %}
      </div>

      <div class="fg-library-empty" data-library-empty>Kein Standort passt zu dieser Suche.</div>

      <div class="fg-location-area-cta">
        <div>
          <p class="fg-premium-kicker fg-premium-kicker-light">Unser Tätigkeitsgebiet</p>
          <h2>Maklergeschäft regional. Finanzierungen deutschlandweit.</h2>
          <p>{{ serviceArea.text }}</p>
        </div>
        <a href="/kontakt.html" class="btn-85 px-7 py-4">Standort besprechen <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>
</div>

{% include "library-filter-script.njk" %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"CollectionPage",
  "@id":"https://fg-realestate.de/standorte/",
  "url":"https://fg-realestate.de/standorte/",
  "name":"Standortanalysen",
  "isPartOf":{"@id":"https://fg-realestate.de/#website"},
  "about":{"@id":"https://fg-realestate.de/#organization"},
  "mainEntity":{"@type":"ItemList","numberOfItems":{{ labContent.locations | length }},"itemListElement":[{% for entry in labContent.locations %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ entry.name | dump | safe }},"url":"https://fg-realestate.de/standorte/{{ entry.slug }}/"}{% if not loop.last %},{% endif %}{% endfor %}]}
}
</script>
