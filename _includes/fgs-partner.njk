{#- Update 62 §2 (17.11.2026): Block „Gutachten über unseren Partner Gutachten.org“, Text wörtlich aus dem Brief, Angaben aus
    _data/partner.js. Nur sichtbar mit partner.aktiv (Schalter freigaben.partner).
    Vor dem Einbinden setzen:
      partnerProdukte     Liste der Produkte (restnutzungsdauer, kaufpreisaufteilung, verkehrswert), je ein Link
      partnerEbene        Überschriftenebene, 2 (Standard) oder 3, wenn der Block unter einer H2 steht
      partnerEingebettet  true: ohne eigenen Abschnitt (der Block steht in einem bestehenden Abschnitt)
    Alle Links: neuer Tab, rel="sponsored noopener"; data-partner und data-produkt für partner_click (fg-design.js). -#}
{%- if partner.aktiv %}
{%- set pg = partner.gutachten %}
{%- set ph = "h" + (partnerEbene or 2) %}
{%- set pid = "partner-gutachten-" + (partnerProdukte | join("-")) %}
{%- if not partnerEingebettet %}
<section class="fgs-section fgs-pblock" aria-labelledby="{{ pid }}">
  <div class="fgs-wrap">
{%- endif %}
    <div class="fgs-pblock-box">
      <div class="fgs-pblock-body">
        <div class="fgs-pblock-marke">
          {%- if pg.logo %}
          <img src="{{ pg.logo.src }}" alt="{{ pg.name }}" width="{{ pg.logo.breite }}" height="{{ pg.logo.hoehe }}" loading="lazy" decoding="async">
          {%- else %}
          <span class="fgs-pblock-name">{{ pg.name }}</span>
          {%- endif %}
        </div>
        <div class="fgs-pblock-text">
          <{{ ph }} id="{{ pid }}">Gutachten über unseren Partner Gutachten.org</{{ ph }}>
          <p>Für Gutachten arbeiten wir mit Gutachten.org zusammen, einem Angebot der Evalion GmbH aus Berlin.</p>
          <ul class="fgs-pblock-produkte">
            {%- for key in partnerProdukte %}{% set pr = pg.produkte[key] %}
            <li><a href="{{ pr.url }}" target="_blank" rel="sponsored noopener" data-partner="{{ pg.id }}" data-produkt="{{ key }}">{{ pr.text }}</a></li>
            {%- endfor %}
          </ul>
          <p>Mit dem Code <strong>{{ pg.code }}</strong> erhalten Sie im Checkout 10&nbsp;% Rabatt.</p>
          <div class="fgs-pblock-aktion">
            <a class="fgs-btn fgs-btn--secondary" href="{{ pg.link }}" target="_blank" rel="sponsored noopener" data-partner="{{ pg.id }}" data-produkt="allgemein">Zu Gutachten.org</a>
            <span class="fgs-pblock-code" aria-label="Rabattcode {{ pg.code }}">{{ pg.code }}</span>
          </div>
          <p class="fgs-pblock-kennung"><em>Partnerlink: Für Aufträge über diese Links erhalten wir eine Provision.</em></p>
        </div>
      </div>
    </div>
{%- if not partnerEingebettet %}
  </div>
</section>
{%- endif %}
{%- endif %}
