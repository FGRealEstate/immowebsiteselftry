<!DOCTYPE html>
<html lang="de">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# SEO-Grundwerte; bestehende Seiten können description, canonicalPath, ogTitle und ogDescription im Frontmatter überschreiben. #}
    {% set siteName = "Fischer & Geserich Real Estate" %}
    {% set companyName = "Fischer & Geserich Real Estate" %}
    {% set siteUrl = "https://fg-realestate.de" %}
    {% set currentPath = canonicalPath or page.url or "/" %}
    {% if currentPath == "/index.html" %}{% set currentPath = "/" %}{% endif %}
    {% set canonicalUrl = siteUrl + currentPath %}
    {% set pageTitle = title or siteName %}
    {% set metaDescription = description or "Fischer & Geserich Real Estate begleitet Eigentümer, Käufer und Investoren beim Immobilienverkauf, Immobilienkauf und bei der Immobilienfinanzierung in Berlin und deutschlandweit." %}
    {% set socialTitle = ogTitle or pageTitle %}
    {% set socialDescription = ogDescription or metaDescription %}
    {#- Update 23 B6: ohne eigenes ogImage das Hero-Foto der Seite als 1200 × 630 (scripts/og-bilder.py → _data/ogBilder.json);
        Seiten ohne Eintrag nehmen „standard“, Impressum, Datenschutz und AGB das Logo. -#}
    {% set ogAuto = false if ogImage else (ogBilder.seiten[page.url] or ogBilder.standard) %}
    {% set ogAuto = false if ogAuto == "logo" else ogAuto %}
    {% set socialImage = ogImage or ((siteUrl + ogAuto.bild) if ogAuto else (siteUrl + "/images/fg-logo-gold-transparent.png")) %}
    {% set socialImageAlt = ogImageAlt or ((ogAuto.alt or socialTitle) if ogAuto else ('Logo von ' + siteName)) %}
    {% set robotsContent = robots or "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" %}

    <title>{% if pageTitle == siteName or pageTitle == companyName or "Fischer & Geserich" in pageTitle %}{{ pageTitle }}{% else %}{{ pageTitle }} | {{ siteName }}{% endif %}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="application-name" content="{{ siteName }}">
    <meta name="apple-mobile-web-app-title" content="{{ siteName }}">
    <meta name="robots" content="{{ robotsContent }}">
    <link rel="canonical" href="{{ canonicalUrl }}">

    <!-- Eindeutiger Markenname für Google, Bing und soziale Netzwerke -->
    <meta property="og:locale" content="de_DE">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:site_name" content="{{ siteName }}">
    <meta property="og:title" content="{{ socialTitle }}">
    <meta property="og:description" content="{{ socialDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ socialImage }}">
    <meta property="og:image:alt" content="{{ socialImageAlt }}">
    {% if ogAuto %}<meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/jpeg">{% endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ socialTitle }}">
    <meta name="twitter:description" content="{{ socialDescription }}">
    <meta name="twitter:image" content="{{ socialImage }}">

    {% if currentPath == "/" %}
