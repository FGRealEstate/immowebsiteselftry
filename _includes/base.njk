    {% elseif currentPath != "/404.html" and not customSchema %}{# Seiten mit customSchema bringen ihr eigenes JSON-LD mit (Gebietsseiten). #}
    {% set schemaType = structuredDataType or "WebPage" %}
    {% set schemaName = structuredDataName or pageTitle %}
    {% set schemaDesc = structuredDataDescription or metaDescription %}
    {% set schemaPath = currentPath %}
    {% set schemaCrumb = structuredDataCrumb or pageTitle %}
    {% set schemaArea = structuredDataArea or "Berlin und Deutschland" %}
    {% include "page-schema.njk" %}
    {% endif %}

    <!-- Favicon / App Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="48x48" href="/images/favicons/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicons/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png">
    <link rel="manifest" href="/images/favicons/site.webmanifest">
    <meta name="theme-color" content="#08082F">

    <!-- F&G Consent Manager: Website bleibt sichtbar; Tracking startet erst nach Einwilligung -->
    <link rel="stylesheet" href="/vendor/cookieconsent/cookieconsent.css">
    <link rel="stylesheet" href="/consent-manager.css">
    <script defer src="/vendor/cookieconsent/cookieconsent.umd.js"></script>
    <script defer src="/consent-manager.js"></script>

    <!-- Neues Design: Schriften lokal (keine Font-CDNs), Kopf/Fuß-Styles auf allen Seiten -->
    {#- Design-Pass 3 §2.1: Bewegung (fgs-motion.js mit GSAP und Lenis) auf allen Seiten mit fgSystem außer Blogartikeln und
        Lexikoneinträgen (fgsMotion: false, Nachtrag Punkt 1). fgs-mo steht vor dem ersten Bild, damit nichts erst steht und dann
        springt; ist fgs-motion.js nach 3 s nicht gelaufen, fällt die Seite auf den ruhigen Stand zurück. -#}
    {%- set fgsBewegung = fgSystem and fgsMotion != false %}
    <script>document.documentElement.classList.add('fgd-js'{% if fgSystem %}, 'fgs-js'{% endif %});{% if fgsBewegung %}if(!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('fgs-mo');setTimeout(function(){if(!window.fgsBewegung)document.documentElement.classList.remove('fgs-mo')},3000)}{% endif %}</script>
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/marcellus-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    {#- Design-Sprint (28.10.2026): Seiten mit fgSystem nutzen nur noch das neue System (css/fg-system.css, fg-system.js). -#}
    {% if fgSystem %}<link rel="stylesheet" href="/css/fg-system.css">{% if fgsBlog %}<link rel="stylesheet" href="/css/fgs-blog.css">{% endif %}{% if fgsTools %}<link rel="stylesheet" href="/css/fgs-tools.css">{% endif %}{% else %}<link rel="stylesheet" href="/css/fg-design.css">{% endif %}

    {% if not fgDesign %}
    <!-- Ältere Seiten: Tailwind lokal kompiliert (npm run css) statt cdn.tailwindcss.com -->
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/fg-polish.css">
    <link rel="stylesheet" href="/fg-assistant.css">
    <!-- Font Awesome 6.4.0 lokal statt cdnjs -->
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    {% endif %}

    <!-- Externe Dienste werden durch consent-manager.js erst nach Einwilligung geladen. -->
    <script>
        window.FG_GOOGLE_MAPS_API_KEY = "";
        window.FG_GTM_ID = "GTM-5DVGRHB2";
    </script>

    {% if not fgDesign %}
    <style>
        /*
         * FG Real Estate – heller Premium-Hintergrund mit originalen Kratzerlinien
         * Wichtig:
         * - Nutzt wieder /images/background.svg
         * - Kein dunkler Navy-Body
         * - Keine globalen Textfarben
         * - Keine Änderungen an Karten, Formularen oder Buttons
         */
        .site-background {
            background-image:
                linear-gradient(
                    135deg,
                    rgba(245, 241, 231, 0.78) 0%,
                    rgba(231, 224, 207, 0.70) 42%,
                    rgba(214, 204, 181, 0.62) 100%
                ),
                url('/images/background.svg') !important;
            background-repeat: no-repeat !important;
            background-size: cover !important;
            background-position: center center !important;
            background-attachment: fixed !important;
            background-color: #E8E1D4 !important;
        }
    </style>
    {% endif %}
    {# Design-Pass 3 §4.1/§4.2: Leistungs- und Gebietsseiten im Design-System laden das Titelbild mit allen Breiten bis 2880 px vor
       (Filter bild). Mit Handy-Zuschnitt zwei Zeilen mit derselben Grenze 11:10 und denselben sizes wie das Makro hero. #}
    {% if not preloadImage and fgSystem and fgsHero %}
      {#- heroPreload: Schlüssel aus seitenbilder.json, z. B. die erste Folie der Diaschau auf der Startseite (§3.1) #}
      {%- set heroKey = heroPreload if heroPreload else (service.hero.name if (service and service.hero) else (("/images/gebiete/" + gebiet.heroPhoto.name) if (gebiet and gebiet.heroPhoto) else "")) %}
      {%- if heroKey %}{% set hb = heroKey | bild %}{% set heroVorgeladen = true %}
    {#- §2.6 Punkt 6: mit vollständiger AVIF-Reihe wird das AVIF vorgeladen (dieselbe Datei, die das <picture> wählt) #}
    <link rel="preload" as="image"{% if hb.avif %} type="image/avif" href="{{ hb.src | replace('.webp', '.avif') }}" imagesrcset="{{ hb.avif }}"{% else %} href="{{ hb.src }}" imagesrcset="{{ hb.srcset }}"{% endif %} imagesizes="{{ 'max(100vw, 164vh)' if (not heroPreload and service and service.hero) else '100vw' }}"{% if hb.hoch %} media="not all and (max-aspect-ratio: 11/10)"{% endif %} fetchpriority="high">
      {%- if hb.hoch %}
    <link rel="preload" as="image"{% if hb.hoch.avif %} type="image/avif" href="{{ hb.hoch.src | replace('.webp', '.avif') }}" imagesrcset="{{ hb.hoch.avif }}"{% else %} href="{{ hb.hoch.src }}" imagesrcset="{{ hb.hoch.srcset }}"{% endif %} imagesizes="{{ '(max-aspect-ratio: 4/5) 80vh, 100vw' if (gebiet or heroPreload) else '(max-aspect-ratio: 14/25) 56vh, 100vw' }}" media="(max-aspect-ratio: 11/10)" fetchpriority="high">
      {%- endif %}{% endif %}
    {% endif %}
    {# Leistungsseiten (fgd-service.njk): Titelbild aus service.hero vorladen. #}
    {% if not preloadImage and not heroVorgeladen and service and service.hero %}{# gleiche Breiten wie das Titelbild in fgd-service.njk (service.hero.widths, wenn die Quelle kleiner ist) #}{% set pW = service.hero.widths or [960, 1600, 2000] %}{% set preloadImage = "/images/seiten/" + service.hero.name + "-" + (1600 if 1600 in pW else pW | last) + ".webp" %}{% set preloadImageSrcset %}{% for w in pW %}/images/seiten/{{ service.hero.name }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}{% endif %}
    {# Seiten mit fgs-page.njk: Titelbild aus pg.hero vorladen (Filter bild, dieselben Breiten wie im Titelbild). #}
    {% if not preloadImage and not heroVorgeladen and pg and pg.hero %}{% set phB = pg.hero.name | bild %}{% set preloadImage = phB.src %}{% set preloadImageSrcset = phB.srcset %}{% endif %}
    {% if preloadImage %}{% set preloadAvif = preloadImageSrcset | avifSet if preloadImageSrcset else "" %}<link rel="preload" as="image"{% if preloadAvif %} type="image/avif" href="{{ preloadImage | replace('.webp', '.avif') }}" imagesrcset="{{ preloadAvif }}"{% else %} href="{{ preloadImage }}"{% if preloadImageSrcset %} imagesrcset="{{ preloadImageSrcset }}"{% endif %}{% endif %}{% if preloadImageSrcset %} imagesizes="100vw"{% endif %} fetchpriority="high">{% endif %}

</head>

<body class="{% if fgSystem %}fgs{% if fgsHero %} fgs-has-hero{% endif %}{% elif fgDesign %}fgd{% else %}site-background{% endif %}{% if fgSystem and fgsIndex %} fgs-indexed{% endif %}{% if bodyClass %} {{ bodyClass }}{% endif %}">
{% from "fgd-icons.njk" import icon %}
{% set currentUrl = page.url | url %}
{% if currentUrl == "/index.html" %}{% set currentUrl = "/" %}{% endif %}

{% if fgSystem %}{% include "fgs-header.njk" %}{% else %}
<a class="fgd-skip" href="#inhalt">Zum Inhalt springen</a>

{# Desktop: Telefon und E-Mail in einer schmalen Leiste über dem Menü, damit Wortmarke, 6 Menüpunkte und Bewertungs-Button in eine Zeile passen. #}
<div class="fgd-topbar">
  <div class="fgd-topbar-inner">
    <span>Schützenstraße 30, 12165 Berlin</span>
    <span class="fgd-topbar-links">
      <a href="{{ nav.phone.href }}">{{ icon("phone") | safe }}{{ nav.phone.display }}</a>
      <a href="mailto:{{ nav.email }}">{{ icon("mail") | safe }}{{ nav.email }}</a>
    </span>
  </div>
</div>

<header class="fgd-header" data-fg-site-header>
  <div class="fgd-header-bar">
    <a class="fgd-brand" href="/" aria-label="Fischer &amp; Geserich Real Estate, zur Startseite">
      <img src="/images/logo/fg-zeichen-gold.svg" alt="" width="47" height="56">
      <span class="fgd-brand-name">Fischer &amp; Geserich<small>Real Estate</small></span>
    </a>

    <nav class="fgd-nav" aria-label="Hauptnavigation">
      <ul class="fgd-nav-list">
        {% for group in nav.menu %}
        <li class="fgd-nav-item{% if group.areas %} fgd-nav-item--areas{% endif %}{% if group | navGroupCurrent(currentUrl) %} is-current{% endif %}" data-fgd-nav-item>
          <button type="button" class="fgd-nav-trigger" data-fgd-nav-trigger aria-expanded="false" aria-controls="fgd-panel-{{ loop.index }}">{{ group.label }}{{ icon("chevron") | safe }}</button>
          {% if group.areas %}
          {#- Gebiete: jede Seite aus _data/serviceArea.js, je Region eine Spalte (Brief Gebietsseiten §7). -#}
          <div class="fgd-nav-panel fgd-nav-panel--areas" id="fgd-panel-{{ loop.index }}">
            {% for item in group.items %}
            <div class="fgd-nav-area fgd-nav-area--{{ item.key }}">
              <a class="fgd-nav-area-head" href="{{ item | navHref }}"{% if item | navHref == currentUrl %} aria-current="page"{% endif %}><strong>{{ item.label }}</strong><span>{{ item.note }}</span></a>
              {% if item.key == "berlin" %}
              <ul>{% for p in serviceArea.berlin.bezirke %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul>
              {% elif item.key == "brandenburg" %}
              <div class="fgd-nav-area-split">
                <div><p>Landkreise</p><ul>{% for p in serviceArea.landkreise %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul></div>
                <div><p>Städte</p><ul>{% for p in serviceArea.towns %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul></div>
              </div>
              {% else %}
              <ul>{% for p in serviceArea[item.key].teile %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul>
              {% endif %}
            </div>
            {% endfor %}
            <p class="fgd-nav-area-all"><a href="{{ group.href }}"{% if group.href == currentUrl %} aria-current="page"{% endif %}>Alle Gebiete auf einen Blick{{ icon("arrow") | safe }}</a><span>Finanzierungen begleiten wir deutschlandweit.</span></p>
          </div>
          {% else %}
          <div class="fgd-nav-panel{% if group.towns or group.items.length > 5 %} fgd-nav-panel--wide{% endif %}" id="fgd-panel-{{ loop.index }}">
            {% for item in group.items %}
            <a href="{{ item | navHref }}"{% if item | navHref == currentUrl %} aria-current="page"{% endif %}><strong>{{ item.label }}</strong><span>{{ item.note }}</span></a>
            {% endfor %}
            {% if group.towns %}
            <div class="fgd-nav-towns">
              <p>Orte in Brandenburg</p>
              <ul>{% for town in group.towns %}<li><a href="{{ town.href }}"{% if town.href == currentUrl %} aria-current="page"{% endif %}>{{ town.label }}</a></li>{% endfor %}</ul>
            </div>
            {% endif %}
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="fgd-header-actions">
      <a class="fgd-phone" href="{{ nav.phone.href }}" aria-label="Anrufen: {{ nav.phone.display }}">{{ icon("phone") | safe }}<span class="fgd-phone-number">{{ nav.phone.display }}</span></a>
      <a class="fgd-btn fgd-btn-gold" href="{{ nav.valuation | navHref }}"><span class="fgd-cta-long">{{ nav.valuation.label }}</span><span class="fgd-cta-short">{{ nav.valuation.short }}</span></a>
      <button type="button" class="fgd-burger" data-fgd-burger aria-expanded="false" aria-controls="fgd-mobile" aria-label="Menü öffnen">{{ icon("menu", "fgd-icon-open") | safe }}{{ icon("close", "fgd-icon-close") | safe }}</button>
    </div>
  </div>

  <div class="fgd-mobile" id="fgd-mobile" hidden>
    <nav aria-label="Hauptnavigation mobil">
      {% for group in nav.menu %}
      <details>
        <summary>{{ group.label }}{{ icon("plus") | safe }}</summary>
        {% if group.areas %}
        <ul><li><a href="{{ group.href }}"{% if group.href == currentUrl %} aria-current="page"{% endif %}>Alle Gebiete</a></li></ul>
        <div class="fgd-mobile-towns">
          <p>Berlin</p>
          <ul><li>{{ serviceArea.berlin | areaLink("Übersicht Berlin", currentUrl) | safe }}</li>{% for p in serviceArea.berlin.bezirke %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul>
        </div>
        <div class="fgd-mobile-towns">
          <p>Brandenburg · Landkreise</p>
          <ul>{% for p in serviceArea.landkreise %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul>
        </div>
        <div class="fgd-mobile-towns">
          <p>Brandenburg · Städte</p>
          <ul>{% for p in serviceArea.towns %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul>
        </div>
        {% for key in ["leipzig", "dresden"] %}
        <div class="fgd-mobile-towns">
          <p>{{ serviceArea[key].name }}</p>
          <ul><li>{{ serviceArea[key] | areaLink("Übersicht " + serviceArea[key].name, currentUrl) | safe }}</li>{% for p in serviceArea[key].teile %}<li>{{ p | areaLink(null, currentUrl) | safe }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
        {% else %}
        <ul>
          {% for item in group.items %}<li><a href="{{ item | navHref }}"{% if item | navHref == currentUrl %} aria-current="page"{% endif %}>{{ item.label }}</a></li>{% endfor %}
        </ul>
        {% endif %}
        {% if group.towns %}
        <div class="fgd-mobile-towns">
          <p>Orte in Brandenburg</p>
          <ul>{% for town in group.towns %}<li><a href="{{ town.href }}">{{ town.label }}</a></li>{% endfor %}</ul>
        </div>
        {% endif %}
      </details>
      {% endfor %}
    </nav>
    <div class="fgd-mobile-contact">
      <a class="fgd-btn fgd-btn-gold" href="{{ nav.valuation | navHref }}">{{ nav.valuation.label }}{{ icon("arrow") | safe }}</a>
      <a class="fgd-mobile-line" href="{{ nav.phone.href }}">{{ icon("phone") | safe }}{{ nav.phone.display }}</a>
      <a class="fgd-mobile-line" href="mailto:{{ nav.email }}">{{ icon("mail") | safe }}{{ nav.email }}</a>
    </div>
  </div>
</header>
{% endif %}

