---
layout: base.njk
fgDesign: true
customSchema: true
---
{#- Seite im neuen Design ohne Leistungsbezug (Brief Design-Pass §4.3): Über uns, Profile, Bewertungen.
    Reihenfolge: Brotkrümel, Titelbereich auf Navy, Inhalt der Seite, FAQ, verwandte Links, Abschlussblock.
    Alles außer dem Inhalt kommt aus `pg` im Frontmatter:
      pg.crumb, pg.parent = { label, href } optional
      pg.kicker, pg.h1, pg.intro, pg.buttons = [ { label, href, line: true (Umriss), external: true, icon: "phone" | "mail" (Standard Pfeil) } ]
      pg.toc        Liste { href, label } rechts im Titelbereich (nur ohne pg.person und pg.rating)
      pg.rating     true: Google-Gesamtbewertung rechts im Titelbereich (aus _data/google.js)
      pg.person     Profilseite: Foto links, Angaben unter dem Text, Person-Markup
                    = { key ("timon" | "lennart", für Foto, Telefon, E-Mail aus kontakte.js), id, name, givenName, familyName,
                        jobTitle, description, knowsAbout [], areaServed [ { type, name, url } ], linkedin, facts [ { dt, dd } ] }
      pg.faq        Liste { q, a } (optional), pg.faqTitle
      pg.related    = { services: [ {label, href, note} ], lexikon: [slug], areas: true } (optional)
      pg.contact    "lennart" | "timon"; pg.closing = { kicker, title, text, button: "bewertung" | "gespraech", gebiet }
      pg.schema     = { type: "AboutPage" | "ProfilePage" | "WebPage" | "ContactPage", id (Anker, Standard "webpage"), about: "@id",
                        org: true (Unternehmen mit Anschrift, Telefon, E-Mail als mainEntity, für Kontakt) }
    Bewertungs-Markup (Review, AggregateRating) schreibt dieses Layout bewusst nicht: Google schließt selbst
    eingebundene Bewertungen über das eigene Unternehmen von Sternen aus (Doku geprüft am 26.10.2026). -#}
{% from "fgd-icons.njk" import icon %}
{% set pageUrl = "https://fg-realestate.de" + page.url %}
{% set faqItems = pg.faq or [] %}
{% set pk = kontakte[pg.person.key] if pg.person else null %}

{#- Update 23 B1: keine sichtbaren Brotkrumen mehr; die BreadcrumbList im JSON-LD unten bleibt. -#}

{# 1. Titelbereich #}
<section class="fgd-place-hero fgd-page-hero" aria-labelledby="seiten-titel">
  <div class="fgd-wrap {% if pg.person %}fgd-profile-grid{% else %}fgd-place-hero-grid{% endif %}">
    {% if pg.person %}
    <div class="fgd-profile-photo">
      <img src="{{ pk.photo }}" srcset="{{ pk.photoSrcset }}" sizes="(min-width: 900px) 380px, 280px" width="720" height="900" alt="Porträt von {{ pg.person.name }}" fetchpriority="high" decoding="async">
    </div>
    {% endif %}
    <div>
      <p class="fgd-kicker">{{ pg.kicker }}</p>
      {# Update 23 B9: lange Titel (über 70 Zeichen) auf dem Handy kleiner, sonst stehen sie auf sechs bis sieben Zeilen #}<h1 id="seiten-titel"{% if (pg.h1 | striptags | length) > 70 %} class="fgs-h1-lang"{% endif %}>{{ pg.h1 | safe }}</h1>
      <p class="fgd-place-answer">{{ pg.intro | safe }}</p>
      {% if pg.person and pg.person.facts %}
      <dl class="fgd-profile-facts">
        {% for f in pg.person.facts %}<div><dt>{{ f.dt }}</dt><dd>{{ f.dd | safe }}</dd></div>{% endfor %}
        {#- Ohne Direktdurchwahl gelten Büronummer und info@ (kontakte.js) -#}
        {% set pPhone = pk.phone or nav.phone %}{% set pEmail = pk.email or nav.email %}
        <div><dt>Telefon</dt><dd><a href="{{ pPhone.href }}">{{ pPhone.display }}</a>{% if not pk.phone %} (Büro){% endif %}</dd></div>
        <div><dt>E-Mail</dt><dd><a href="mailto:{{ pEmail }}">{{ pEmail }}</a></dd></div>
      </dl>
      {% endif %}
      {% if pg.buttons %}
      <div class="fgd-hero-actions">
        {% for b in pg.buttons %}<a class="fgd-btn {% if b.line %}fgd-btn-line fgd-btn-line--light{% else %}fgd-btn-gold{% endif %}" href="{{ b.href }}"{% if b.external %} target="_blank" rel="noopener"{% endif %}>{% if b.icon %}{{ icon(b.icon) | safe }}{% endif %}{{ b.label }}{% if not b.icon %}{{ icon("arrow-up-right" if b.external else "arrow") | safe }}{% endif %}</a>{% endfor %}
      </div>
      {% endif %}
    </div>
    {% if pg.rating %}
    <div class="fgd-rating">
      <div class="fgd-rating-score"><strong>{{ google.rating }}</strong><span>von 5</span></div>
      <span class="fgd-stars" role="img" aria-label="{{ google.rating }} von 5 Sternen">{% for i in range(google.ratingValue | round) %}{{ icon("star") | safe }}{% endfor %}</span>
      <p><strong>{{ google.count }} Bewertungen</strong> auf Google</p>
      <a class="fgd-btn fgd-btn-gold" href="{{ google.url }}" target="_blank" rel="noopener">Google-Profil öffnen{{ icon("arrow-up-right") | safe }}</a>
    </div>
    {% elif pg.toc and not pg.person %}
    <nav class="fgd-place-toc" aria-label="Auf dieser Seite">
      <p>Auf dieser Seite</p>
      <ol>{% for t in pg.toc %}<li><a href="{{ t.href }}">{{ t.label }}</a></li>{% endfor %}</ol>
    </nav>
    {% endif %}
  </div>
</section>

{# 2. Inhalt der Seite #}
{{ content | safe }}

{# 3. FAQ #}
{% if faqItems.length %}
{% set faqTitle = pg.faqTitle or "Häufige Fragen" %}
{% include "fgd-faq.njk" %}
{% endif %}

{# 4. Verwandte Links #}
{% if pg.related %}
<section class="fgd-section fgd-section--stone fgd-related" aria-labelledby="weiter-titel">
  <div class="fgd-wrap">
    <div class="fgd-head">
      <p class="fgd-kicker">Weiterlesen</p>
      <h2 id="weiter-titel">{{ pg.related.title or "Passend zu dieser Seite" }}</h2>
    </div>
    <div class="fgd-related-grid">
      {% if pg.related.services %}
      <div class="fgd-related-col">
        <h3>{{ pg.related.servicesTitle or "Leistungen" }}</h3>
        <ul class="fgd-linklist">
          {% for r in pg.related.services %}<li><a href="{{ r.href }}"><span><strong>{{ r.label }}</strong>{% if r.note %}<small>{{ r.note }}</small>{% endif %}</span>{{ icon("arrow") | safe }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endif %}
      <div class="fgd-related-col">
        <h3>Unsere Gebiete</h3>
        {% include "fgd-area-list.njk" %}
      </div>
      {% if pg.related.lexikon %}
      <div class="fgd-related-col">
        <h3>Im Lexikon erklärt</h3>
        <ul class="fgd-linklist">
          {% for slug in pg.related.lexikon %}{% set e = labContent.lexicon | lexEntry(slug) %}{% if e %}<li><a href="/lexikon/{{ e.slug }}/"><span><strong>{{ e.term }}</strong><small>Lexikon</small></span>{{ icon("arrow") | safe }}</a></li>{% endif %}{% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# 5. Abschlussblock #}
{% set closing = pg.closing %}
{% set kontaktKey = pg.contact %}
{% include "fgd-closing.njk" %}

{%- set schemaId = pageUrl + "#" + (pg.schema.id or "webpage") %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": {{ (pg.schema.type or "WebPage") | json | safe }},
      "@id": "{{ schemaId }}",
      "url": "{{ pageUrl }}",
      "name": {{ title | json | safe }},
      "description": {{ description | json | safe }},
      "inLanguage": "de-DE",
      "isPartOf": { "@id": "https://fg-realestate.de/#website" },
      "publisher": { "@id": "https://fg-realestate.de/#organization" },
      {% if pg.person %}"mainEntity": { "@id": "{{ pageUrl }}#person" },
      {% elif pg.schema.org %}"mainEntity": { "@id": "https://fg-realestate.de/#organization" },
      {% elif pg.schema.about %}"about": { "@id": "{{ pg.schema.about }}" },
      {% endif %}"breadcrumb": { "@id": "{{ pageUrl }}#breadcrumb" }
    },
    {% if pg.person %}{% set p = pg.person %}{
      "@type": "Person",
      "@id": "{{ pageUrl }}#person",
      "name": {{ p.name | json | safe }},
      "givenName": {{ p.givenName | json | safe }},
      "familyName": {{ p.familyName | json | safe }},
      "jobTitle": {{ p.jobTitle | json | safe }},
      "description": {{ (pk.bio or p.description) | json | safe }},
      "image": "https://fg-realestate.de{{ pk.photo }}",
      "url": "{{ pageUrl }}",
      "telephone": {{ (pk.phone or nav.phone).href | replace("tel:", "") | json | safe }},
      "email": {{ (pk.email or nav.email) | json | safe }},
      "workLocation": {
        "@type": "Place",
        "address": { "@type": "PostalAddress", "streetAddress": "Schützenstraße 30", "postalCode": "12165", "addressLocality": "Berlin", "addressCountry": "DE" }
      },
      "worksFor": { "@id": "https://fg-realestate.de/#organization" },
      "knowsAbout": {{ p.knowsAbout | json | safe }},
      "areaServed": [
        {% for a in p.areaServed %}{ "@type": "{{ a.type }}", "name": {{ a.name | json | safe }}{% if a.url %}, "url": "https://fg-realestate.de{{ a.url }}"{% endif %} }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]{% if p.linkedin %},
      "sameAs": [{{ p.linkedin | json | safe }}]{% endif %}
    },
    {% endif %}{% if pg.schema.org %}{
      "@type": ["Organization", "RealEstateAgent"],
      "@id": "https://fg-realestate.de/#organization",
      "name": "Fischer & Geserich Real Estate GmbH",
      "url": "https://fg-realestate.de/",
      "telephone": {{ nav.phone.href | replace("tel:", "") | json | safe }},
      "email": {{ nav.email | json | safe }},
      "address": { "@type": "PostalAddress", "streetAddress": "Schützenstraße 30", "postalCode": "12165", "addressLocality": "Berlin", "addressCountry": "DE" }
    },
    {% endif %}{
      "@type": "BreadcrumbList",
      "@id": "{{ pageUrl }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://fg-realestate.de/" },
        {% if pg.parent %}{ "@type": "ListItem", "position": 2, "name": {{ pg.parent.label | json | safe }}, "item": "https://fg-realestate.de{{ pg.parent.href }}" },
        {% endif %}{ "@type": "ListItem", "position": {% if pg.parent %}3{% else %}2{% endif %}, "name": {{ pg.crumb | json | safe }}, "item": "{{ pageUrl }}" }
      ]
    }{% if faqItems.length %},
    {
      "@type": "FAQPage",
      "@id": "{{ pageUrl }}#faq",
      "isPartOf": { "@id": "{{ schemaId }}" },
      "mainEntity": [
        {% for item in faqItems %}{
          "@type": "Question",
          "name": {{ item.q | json | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | striptags | json | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }{% endif %}
  ]
}
</script>
