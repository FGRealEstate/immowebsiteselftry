{% set ankaufBookingUrl = "https://outlook.office.com/bookwithme/user/72d1d477b1c94313b937eaf0288a9454@fg-realestate.de/meetingtype/CHqdXdox7UqN08gNHOu7dw2?anonymous&ismsaljsauthenabled&ep=mlink" %}
{% set financeBookingUrl = "https://outlook.office.com/bookwithme/user/72d1d477b1c94313b937eaf0288a9454@fg-realestate.de/meetingtype/E3HmmWlWKECvphgdD7qQqg2?anonymous&ismsaljsauthenabled&ep=mlink" %}
{% set mode = appointmentMode or "ankauf" %}

<section id="terminbuchung" class="container mx-auto px-4 py-10 md:py-16">
  <div class="fg-booking-shell fg-reveal">
    <div>
      <p class="fg-section-kicker">Direkte Terminbuchung</p>
      {% if mode == "finanzierung" %}
        <h2>Finanzierungserstgespräch direkt im Kalender buchen.</h2>
        <p>Wählen Sie einen freien Termin. Sie werden direkt zu unserem einheitlichen Microsoft-Bookings-Kalender weitergeleitet.</p>
      {% elif mode == "both" %}
        <h2>Welches Erstgespräch passt zu Ihrem Vorhaben?</h2>
        <p>Wählen Sie den passenden Kalender. So landet Ihr Termin direkt im richtigen Gesprächsformat.</p>
      {% else %}
        <h2>Erstgespräch zum Ankauf direkt im Kalender buchen.</h2>
        <p>Wählen Sie einen freien Termin. Sie werden direkt zu unserem einheitlichen Microsoft-Bookings-Kalender weitergeleitet.</p>
      {% endif %}
      <div class="fg-booking-benefits">
        <span><i class="fas fa-calendar-check"></i> freie Termine live auswählen</span>
        <span><i class="fas fa-video"></i> strukturierter Ersttermin</span>
        <span><i class="fas fa-clock"></i> ohne E-Mail-Pingpong</span>
      </div>
    </div>

    <div class="fg-booking-actions">
      {% if mode == "finanzierung" or mode == "both" %}
      <a href="{{ financeBookingUrl }}" target="_blank" rel="noopener noreferrer" class="btn-85 fg-booking-button">
        <i class="fas fa-euro-sign"></i><span><strong>Finanzierungserstgespräch</strong><small>Termin in Microsoft Bookings auswählen</small></span><i class="fas fa-arrow-up-right-from-square"></i>
      </a>
      {% endif %}

      {% if mode == "ankauf" or mode == "both" %}
      <a href="{{ ankaufBookingUrl }}" target="_blank" rel="noopener noreferrer" class="btn-85 fg-booking-button">
        <i class="fas fa-house-circle-check"></i><span><strong>Erstgespräch Ankauf</strong><small>Termin in Microsoft Bookings auswählen</small></span><i class="fas fa-arrow-up-right-from-square"></i>
      </a>
      {% endif %}
    </div>
  </div>
</section>
