<script>(function(){const input=document.querySelector('[data-library-search]'),cards=[...document.querySelectorAll('[data-library-card]')],count=document.querySelector('[data-library-count]'),empty=document.querySelector('[data-library-empty]');if(!input||!cards.length)return;const norm=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');function run(){const q=norm(input.value.trim());let n=0;cards.forEach(c=>{const show=!q||norm(c.dataset.search).includes(q);c.hidden=!show;if(show)n++});if(count)count.textContent=n;if(empty)empty.style.display=n?'none':'block'}input.addEventListener('input',run);run()})();</script>
