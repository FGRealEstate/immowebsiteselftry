{#- Update 44 §2.1 (07.11.2026): „Mehr dazu im Wissen“ mit den neuesten passenden Artikeln (höchstens drei), automatisch aus den
    Artikeln, die heute erscheinen (_data/blogArtikel.js); Zuordnung über die Kategorie (_data/wissen.js).
    Eingabe: wissenKats (Liste der Kategorien). Ohne passenden Artikel entfällt der Block. Darstellung seit R4 (25.11.2026) als Karten, siehe unten. -#}
{%- from "fgs-macros.njk" import textlink with context %}
{%- set wissenListe = [] %}
{%- for p in blogArtikel | sort(true, false, "datePublished") %}{% if p.katId in wissenKats and wissenListe.length < wissen.hoechstens %}{% set _ = wissenListe.push(p) %}{% endif %}{% endfor %}
{%- if wissenListe.length %}
{#- Peers Review R4 (25.11.2026): Überschrift mittig, die Artikel als Karten nebeneinander mit dem Vorschaubild der Blog-Übersicht
    (blogThumb, 720 × 480), Rubrik und Lesezeit, Titel, Zeile aus der Übersicht. Am Handy untereinander. -#}
<section class="fgs-section fgs-wissen" id="wissen" aria-labelledby="wissen-titel">
  <div class="fgs-wrap">
    <div class="fgs-head fgs-head--centre"><h2 class="fgs-h2-chapter" id="wissen-titel">Mehr dazu im Wissen</h2></div>
    <ul class="fgs-wissen-karten" role="list" style="--n: {{ wissenListe.length }}">
      {%- for p in wissenListe %}
      <li>
        <a class="fgs-wissen-karte" href="{{ p.url }}">
          <span class="fgs-wissen-bild"><img src="{{ p.slug | blogThumb }}" alt="{{ p.lead.alt }}" width="720" height="480" loading="lazy" decoding="async"></span>
          <span class="fgs-wissen-meta">{{ p.katLabel | safe }} · {{ p.minuten }} Min. Lesezeit</span>
          <h3 class="fgs-wissen-titel">{{ p.titel }}</h3>
          <span class="fgs-wissen-text">{{ p.kurz | safe }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    <p class="fgs-wissen-alle">{{ textlink("/blog/", "Alle Artikel") }}</p>
  </div>
</section>
{%- endif %}
