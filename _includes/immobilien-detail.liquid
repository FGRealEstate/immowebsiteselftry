---
layout: base.njk
---
<div class="fg-property-v3">
  <section class="fg-property-hero"><div class="fg-premium-shell"><div class="fg-property-hero-grid"><div><span class="fg-property-strategy"><i class="fas fa-house"></i>{{ vermarktungsart | default: "Immobilie" }}</span><h1>{{ titel | default: title }}</h1>{% if ort %}<p><i class="fas fa-location-dot"></i> {{ ort }}</p>{% endif %}</div><a href="/kontakt.html" class="btn-85 px-7 py-4">Objekt anfragen <i class="fas fa-arrow-right"></i></a></div></div></section>
  <section class="fg-premium-shell"><div class="fg-property-layout"><main>
    {% if hauptbild %}<section class="fg-property-gallery"><div class="fg-property-gallery-main"><img class="is-active" src="{{ hauptbild }}" alt="{{ titel | default: title }}"></div></section>{% endif %}
    {% if galerie %}<section class="fg-property-box"><h2>Weitere Ansichten</h2><div class="fg-premium-grid-3">{% for bild in galerie %}<img src="{{ bild }}" alt="{{ titel | default: title }} – weitere Ansicht" loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px">{% endfor %}</div></section>{% endif %}
    <section class="fg-property-box"><h2>Objektbeschreibung</h2><div class="fg-property-prose">{{ content }}</div></section>
  </main><aside class="fg-property-sidebar"><span class="fg-premium-kicker">{{ objektart | default: "Immobilie" }}</span><p class="fg-property-price">{{ preis | default: "Preis auf Anfrage" }}</p><div class="fg-property-kpis">{% if eckdaten.flaeche %}<div class="fg-property-kpi"><span>Wohnfläche</span><strong>{{ eckdaten.flaeche }}</strong></div>{% endif %}{% if eckdaten.zimmer %}<div class="fg-property-kpi"><span>Zimmer</span><strong>{{ eckdaten.zimmer }}</strong></div>{% endif %}{% if eckdaten.baujahr %}<div class="fg-property-kpi"><span>Baujahr</span><strong>{{ eckdaten.baujahr }}</strong></div>{% endif %}{% if provision %}<div class="fg-property-kpi"><span>Courtage</span><strong>{{ provision }}</strong></div>{% endif %}</div><a href="/kontakt.html" class="btn-85 w-full py-4 mt-6">Objekt anfragen</a><a href="/angebote.html" style="display:block;text-align:center;margin-top:16px;color:#08082f;font-weight:800">Zurück zu den Angeboten</a></aside></div></section>
</div>
