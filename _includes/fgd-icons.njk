{#- Inline-SVG-Icons für das neue Design (ersetzen Font Awesome schrittweise).
    Aufruf: {% from "fgd-icons.njk" import icon %} … {{ icon("arrow") }} -#}
{%- macro icon(name, cls="") -%}
<svg class="fgd-icon{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "arrow" -%}<path d="M4 12h15M13 6l6 6-6 6"/>
{%- elif name == "arrow-up-right" -%}<path d="M7 17 17 7M8 7h9v9"/>
{%- elif name == "phone" -%}<path d="M5 3.5h3.2l1.6 4.2-2 1.4a11 11 0 0 0 7.1 7.1l1.4-2 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5C10.8 20 4 13.2 3.5 5.1A1.5 1.5 0 0 1 5 3.5Z"/>
{%- elif name == "mail" -%}<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/>
{%- elif name == "pin" -%}<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>
{%- elif name == "chevron" -%}<path d="m6 9 6 6 6-6"/>
{%- elif name == "plus" -%}<path d="M12 5v14M5 12h14"/>
{%- elif name == "menu" -%}<path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>
{%- elif name == "close" -%}<path d="M6 6l12 12M18 6 6 18"/>
{%- elif name == "check" -%}<path d="m4.5 12.5 4.5 4.5L19.5 7"/>
{%- elif name == "chat" -%}<path d="M4 5.5h16v10.5H9.5L5 20v-4H4z"/><path d="M8 10h8M8 13h5"/>
{%- elif name == "star" -%}<path fill="currentColor" stroke="none" d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/>
{%- elif name == "instagram" -%}<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/>
{%- elif name == "linkedin" -%}<rect x="3.5" y="3.5" width="17" height="17" rx="2"/><path d="M8 10.5V16.5M8 7.6v.1M11.5 16.5v-6M11.5 13.2c0-1.7 1-2.7 2.4-2.7s2.1.9 2.1 2.6v3.4"/>
{%- elif name == "shield" -%}<path d="M12 3 5 6v5.5c0 4.4 3 8.2 7 9.5 4-1.3 7-5.1 7-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>
{%- elif name == "calendar" -%}<rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
{%- elif name == "map" -%}<path d="m3.5 6.5 5.5-2 6 2 5.5-2v13l-5.5 2-6-2-5.5 2z"/><path d="M9 4.5v13M15 6.5v13"/>
{%- elif name == "layers" -%}<path d="m12 3.5 8.5 4.5L12 12.5 3.5 8z"/><path d="m3.5 12 8.5 4.5 8.5-4.5M3.5 16l8.5 4.5 8.5-4.5"/>
{%- endif -%}
</svg>
{%- endmacro -%}
