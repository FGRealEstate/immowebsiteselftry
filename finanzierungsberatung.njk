{# F Kaufpreisrahmen-Rechner (gleiche Rechnung wie bisher in script.js) #}
<section class="fgs-section" id="rechner" aria-labelledby="rechner-titel">
  <div class="fgs-wrap fgs-formblock">
    <div class="fgs-formblock-text">
      <h2 id="rechner-titel">Wie viel Immobilie kann ich mir leisten?</h2>
      <p class="fgs-lead">Ermitteln Sie einen ersten Kaufpreisrahmen aus Rate, Eigenkapital, Sollzins, Tilgung und Kaufnebenkosten.</p>
      <p class="fgs-note">Unverbindliche Orientierung. Banken rechnen zusätzlich mit Haushaltsüberschuss, Beleihungswert, Nebenkosten, Objektqualität und individuellen Sicherheitsabschlägen.</p>
      {{ textlink("/investment-lab.html", "Alle Rechner im Investment Lab") }}
    </div>
    <div class="fgs-formblock-form">
    <div class="fgd-form-card fgd-calc" data-fgd-afford>
      <form class="fgd-form" novalidate>
        <div class="fgd-field-row">
          <label>Verfügbare Monatsrate<span class="fgd-unit"><input name="rate" value="1800" inputmode="decimal"><b>€</b></span></label>
          <label>Eigenkapital<span class="fgd-unit"><input name="equity" value="80000" inputmode="decimal"><b>€</b></span></label>
        </div>
        <div class="fgd-field-row fgd-field-row--3">
          <label>Sollzins p.&nbsp;a.<span class="fgd-unit"><input name="interest" value="4,2" inputmode="decimal"><b>%</b></span></label>
          <label>Tilgung p.&nbsp;a.<span class="fgd-unit"><input name="repay" value="2,0" inputmode="decimal"><b>%</b></span></label>
          <label>Kaufnebenkosten<span class="fgd-unit"><input name="costs" value="10,0" inputmode="decimal"><b>%</b></span></label>
        </div>
        <button type="submit" class="fgd-btn fgd-btn-navy">Kaufpreisrahmen berechnen{{ icon("arrow") | safe }}</button>
      </form>
      <div class="fgd-calc-result" data-fgd-afford-result aria-live="polite"></div>
    </div>
    </div>
  </div>
</section>

