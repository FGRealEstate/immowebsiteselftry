---
layout: base.njk
pagination:
  data: labContent.articles
  size: 1
  alias: article
  addAllPagesToCollections: true
permalink: "wissen/{{ article.slug }}/index.html"
eleventyComputed:
  title: "{{ article.title }}"
  description: "{{ article.summary }}"
---
<div class="content-detail shell">
  <nav class="breadcrumbs"><a href="/index.html">Start</a><span>&rsaquo;</span><a href="/wissen/">Wissen</a><span>›</span><span>{{ article.title }}</span></nav>
  <article class="science-article science-article-v3">
    <header class="science-hero science-hero-v3">
      <span class="lab-kicker">— {{ article.category }} —</span>
      <h1>{{ article.title }}</h1>
      <p class="lead">{% if article.lead %}{{ article.lead }}{% else %}{{ article.summary }}{% endif %}</p>
      <p class="content-meta">Fischer &amp; Geserich Real Estate GmbH · aktualisiert {{ article.updated }}</p>
    </header>

    {% if article.htmlBlocks and article.htmlBlocks.length %}
      <section class="science-section science-prose-block">
        {% for block in article.htmlBlocks %}{{ block | safe }}{% endfor %}
      </section>

    {% elif article.contentBlocks and article.contentBlocks.length %}
      {% for block in article.contentBlocks %}
        {% if block.type == "prose" %}
          <section class="science-section science-prose-block">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            {% for paragraph in block.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
          </section>

        {% elif block.type == "formula" %}
          <section class="science-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            <div class="lab-formula-card science-formula-card-v3">
              {% for f in block.formulas %}<div class="lab-formula">{{ f }}</div>{% endfor %}
              {% if block.explanation %}<p class="science-block-note">{{ block.explanation }}</p>{% endif %}
            </div>
          </section>

        {% elif block.type == "metrics" %}
          <section class="science-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            <div class="science-metric-grid">
              {% for item in block.items %}
                <div class="science-metric-card"><span>{{ item.label }}</span><strong>{{ item.value }}</strong>{% if item.note %}<small>{{ item.note }}</small>{% endif %}</div>
              {% endfor %}
            </div>
          </section>

        {% elif block.type == "table" %}
          <section class="science-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            <div class="science-table-wrap"><table class="science-table"><thead><tr>{% for h in block.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for row in block.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
            {% if block.note %}<p class="table-note">{{ block.note }}</p>{% endif %}
          </section>

        {% elif block.type == "timeline" %}
          <section class="science-section science-visual-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            {% if block.intro %}<p class="science-visual-intro">{{ block.intro }}</p>{% endif %}
            <div class="science-horizontal-timeline" style="--timeline-count: {{ block.items.length }}">
              {% for item in block.items %}
                <div class="science-horizontal-timeline-item">
                  <div class="science-horizontal-marker"><span>{{ item.label }}</span></div>
                  <div class="science-horizontal-copy"><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div>
                </div>
              {% endfor %}
            </div>
          </section>

        {% elif block.type == "lineChart" %}
          <section class="science-section science-visual-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            <div class="science-chart-card">
              <svg class="science-line-chart" viewBox="0 0 {{ block.width }} {{ block.height }}" role="img" aria-label="{{ block.title }}">
                <g class="science-chart-grid">
                  {% for y in block.yLabels %}<line x1="70" x2="700" y1="{{ y.y }}" y2="{{ y.y }}"></line><text x="62" y="{{ y.y + 4 }}" text-anchor="end">{{ y.label }}</text>{% endfor %}
                </g>
                <g class="science-chart-xlabels">
                  {% for x in block.xLabels %}<text x="{{ x.x }}" y="278" text-anchor="middle">{{ x.label }}</text>{% endfor %}
                </g>
                {% for s in block.series %}
                  <polyline class="science-chart-line {{ s.className }}" points="{{ s.points }}"></polyline>
                  {% for dot in s.dots %}<circle class="science-chart-dot {{ s.className }}" cx="{{ dot.x }}" cy="{{ dot.y }}" r="4"><title>{{ s.name }}: {{ dot.value }}</title></circle>{% endfor %}
                {% endfor %}
              </svg>
              <div class="science-chart-legend">{% for s in block.series %}<span class="{{ s.className }}"><i></i>{{ s.name }}</span>{% endfor %}</div>
              {% if block.note %}<p class="science-block-note">{{ block.note }}</p>{% endif %}
            </div>
          </section>

        {% elif block.type == "barChart" %}
          <section class="science-section science-visual-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            <div class="science-bar-chart">
              {% for item in block.items %}
                <div class="science-bar-row">
                  <div class="science-bar-label"><strong>{{ item.label }}</strong><span>{{ item.value }}</span></div>
                  <div class="science-bar-track"><span style="width: {{ item.pct }}%"></span></div>
                </div>
              {% endfor %}
            </div>
            {% if block.note %}<p class="science-block-note">{{ block.note }}</p>{% endif %}
          </section>

        {% elif block.type == "steps" %}
          <section class="science-section">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            <div class="science-process-grid">
              {% for item in block.items %}<article><span>{{ loop.index | pad2 }}</span><div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div></article>{% endfor %}
            </div>
          </section>

        {% elif block.type == "callout" %}
          <section class="science-section science-callout science-callout-{{ block.tone or 'gold' }}">
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}<p>{{ block.text }}</p>
          </section>
        {% endif %}
      {% endfor %}

    {% else %}
      <section class="science-section"><h2>Was der Begriff konkret bedeutet</h2><p>{{ article.definition or article.body }}</p></section>
      {% if article.focusPoints and article.focusPoints.length %}<section class="science-section"><h2>Was in der Praxis wirklich entscheidend ist</h2><div class="focus-grid">{% for point in article.focusPoints %}<div class="focus-point"><span>{{ loop.index | pad2 }}</span><p>{{ point }}</p></div>{% endfor %}</div></section>{% endif %}
      {% if article.formulae and article.formulae.length %}<section class="science-section"><h2>Rechenlogik</h2><div class="lab-formula-card">{% for formula in article.formulae %}<div class="lab-formula">{{ formula }}</div>{% endfor %}</div></section>{% endif %}
      {% if article.example %}<section class="lab-example-section science-section"><h2>{{ article.example.title or "Durchgerechnetes Beispiel" }}</h2><div class="lab-example-grid"><div><h3>Annahmen</h3><ul>{% for item in article.example.assumptions %}<li>{{ item }}</li>{% endfor %}</ul></div><div><h3>Rechnung</h3><ul>{% for item in article.example.steps %}<li>{{ item }}</li>{% endfor %}</ul></div></div>{% if article.example.interpretation %}<div class="lab-interpretation"><strong>Einordnung des Ergebnisses</strong><p>{{ article.example.interpretation }}</p></div>{% endif %}</section>{% endif %}
      {% if article.comparisonTable %}<section class="science-section"><h2>{{ article.comparisonTable.title }}</h2><div class="science-table-wrap"><table class="science-table"><thead><tr>{% for h in article.comparisonTable.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for row in article.comparisonTable.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% if article.comparisonTable.note %}<p class="table-note">{{ article.comparisonTable.note }}</p>{% endif %}</section>{% endif %}
      {% if article.timeline %}<section class="science-section"><h2>{{ article.timeline.title }}</h2><div class="science-timeline">{% for item in article.timeline.items %}<div class="timeline-item"><div class="timeline-label">{{ item.label }}</div><div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div></div>{% endfor %}</div></section>{% endif %}
    {% endif %}

    {% if article.decisionUse %}<section class="science-section decision-section decision-section-v3"><span class="lab-kicker">— ENTSCHEIDUNGSRELEVANZ —</span><h2>Was daraus für eine Immobilienentscheidung folgt</h2><p>{{ article.decisionUse }}</p></section>{% endif %}

    {% set related = article.body | relatedTerms(labContent.lexicon, 5) %}
    {% if related.length %}
      <section class="science-section">
        <h2>Begriffe in diesem Artikel</h2>
        <ul>{% for entry in related %}<li><a href="/lexikon/{{ entry.slug }}/">{{ entry.term }}</a> &mdash; {{ entry.definition }}</li>{% endfor %}</ul>
      </section>
    {% endif %}

    {% if article.sources and article.sources.length %}<section class="lab-source-section science-section"><h2>Quellen &amp; Rechtsgrundlagen</h2><ul>{% for source in article.sources %}<li><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label }}</a></li>{% endfor %}</ul><p class="lab-source-note">Rechts-, Steuer-, Förder- und Bankbedingungen können sich ändern. Maßgeblich ist der konkrete Einzelfall und der jeweils aktuelle Produkt- bzw. Gesetzesstand.</p></section>{% endif %}

    <aside class="article-note"><strong>Hinweis</strong><p>Die Beispiele erläutern die wirtschaftliche Systematik. Sie ersetzen keine individuelle Rechts-, Steuer-, Finanzierungs- oder Anlageberatung.</p></aside>
    <div class="article-actions"><a class="lab-btn lab-btn-gold" href="/investment-lab.html">Im Investment Lab weiterarbeiten</a><a class="lab-btn lab-btn-ghost" href="/ankaufsberatung.html">Ankaufsberatung</a></div>
  </article>

  {% if article.faq %}
    {% set faqItems = article.faq %}
    {% set faqAnchor = "faq-artikel" %}
    {% set faqTitle = "Häufige Fragen zu diesem Thema" %}
    {% include "faq-block.njk" %}
  {% endif %}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://fg-realestate.de/wissen/{{ article.slug }}/#artikel",
      "headline": {{ article.title | json | safe }},
      "description": {{ article.summary | json | safe }},
      "articleSection": {{ article.category | json | safe }},
      "url": "https://fg-realestate.de/wissen/{{ article.slug }}/",
      "inLanguage": "de-DE",
      "dateModified": {{ article.updated | json | safe }},
      "author": { "@id": "https://fg-realestate.de/#organization" },
      "publisher": { "@id": "https://fg-realestate.de/#organization" },
      "isPartOf": { "@id": "https://fg-realestate.de/#website" },
      "mainEntityOfPage": { "@id": "https://fg-realestate.de/wissen/{{ article.slug }}/" }
    },
    {
      "@type": "WebPage",
      "@id": "https://fg-realestate.de/wissen/{{ article.slug }}/",
      "url": "https://fg-realestate.de/wissen/{{ article.slug }}/",
      "name": {{ article.title | json | safe }},
      "description": {{ article.summary | json | safe }},
      "inLanguage": "de-DE",
      "isPartOf": { "@id": "https://fg-realestate.de/#website" },
      "provider": { "@id": "https://fg-realestate.de/#organization" },
      "breadcrumb": { "@id": "https://fg-realestate.de/wissen/{{ article.slug }}/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://fg-realestate.de/wissen/{{ article.slug }}/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://fg-realestate.de/" },
        { "@type": "ListItem", "position": 2, "name": "Wissen", "item": "https://fg-realestate.de/wissen/" },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json | safe }} }
      ]
    }
  ]
}
</script>
