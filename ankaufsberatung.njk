            ["06","Finanzierungssuche","Wir unterstützen Sie bei der Suche nach einer passenden Finanzierungsstruktur und vermitteln Bankkontakte."],
            ["07","Notar & After Sales","Wir begleiten Sie zum Notartermin und stehen Ihnen auch nach dem Kauf als Ansprechpartner zur Seite."]
          ] %}
          {% for step in investorSteps %}<article class="fg-timeline-step fg-reveal"><span>{{ step[0] }}</span><div><h3>{{ step[1] }}</h3><p>{{ step[2] }}</p>{% if loop.first %}<a href="#terminbuchung" class="fg-timeline-link">Termin auswählen <i class="fas fa-arrow-right"></i></a>{% endif %}</div></article>{% endfor %}
        </div>
      </div>
