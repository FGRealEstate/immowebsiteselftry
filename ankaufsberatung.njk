<div id="content-wrapper" class="transition-opacity duration-300">
  <div id="content-kapitalanleger" class="block">
    <section class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12 fg-reveal"><p class="fg-section-kicker">Von der Strategie bis zum Abschluss</p><h2 class="text-3xl md:text-5xl font-bold text-primary mb-4">Ihr Weg zum Immobilien-Portfolio</h2><p class="text-lg text-gray-600 max-w-3xl mx-auto">Sieben klare Schritte von der ersten Idee bis zum erfolgreichen Abschluss – transparent, strukturiert und kaufmännisch fundiert.</p></div>
        <div class="fg-timeline">
          {% set investorSteps = [
            ["01","Erstgespräch vereinbaren","Lernen Sie uns kennen. Wir klären Ihre Ausgangslage, Ziele und den passenden Rahmen für die Zusammenarbeit."],
            ["02","Persönliche Strategieentwicklung","Wir definieren gemeinsam Ihre Anlageziele und entwickeln einen maßgeschneiderten Fahrplan für Ihren Vermögensaufbau."],
            ["03","Objektprüfung (Due Diligence)","Wir prüfen das Objekt kaufmännisch und wirtschaftlich und analysieren Zahlen, Mietpotenziale und Renditechancen. Keine Rechts- oder Steuerberatung."],
            ["04","Objektvorstellung","Wir präsentieren Ihnen geprüfte Immobilienchancen – On-Market und, sofern verfügbar, Off-Market – passend zu Ihrem Suchprofil."],
