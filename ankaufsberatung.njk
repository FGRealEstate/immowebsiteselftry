:root{
  --fga-navy:#08082F;
  --fga-navy-2:#111145;
  --fga-gold:#D1B464;
  --fga-gold-dark:#9c7721;
  --fga-cream:#f7f4ec;
  --fga-line:rgba(8,8,47,.12);
  --fga-muted:#69707e;
  --fga-blue:#91DCFF;
}

.fg-ai-assistant{position:fixed;right:22px;bottom:22px;z-index:20050;font-family:Arial,Helvetica,sans-serif;color:var(--fga-navy)}
.fg-ai-launcher{height:56px;border:0;border-radius:999px;padding:0 20px 0 10px;background:linear-gradient(135deg,#08082F 0%,#15154b 72%,#292260 100%);color:#fff;box-shadow:0 18px 46px rgba(8,8,47,.28);display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:.01em;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease}
.fg-ai-launcher:hover{transform:translateY(-2px);box-shadow:0 23px 54px rgba(8,8,47,.34)}
.fg-ai-launcher-icon{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 30% 20%,#fff5c7 0,#e2c362 35%,#aa7d19 78%,#6a4a0c 100%);color:#08082F;box-shadow:inset 0 0 0 1px rgba(255,255,255,.45)}
.fg-ai-launcher-copy{display:flex;flex-direction:column;align-items:flex-start;line-height:1.05}.fg-ai-launcher-copy small{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#e5d5a4;margin-bottom:4px}.fg-ai-launcher-copy strong{font-size:14px}
.fg-ai-launcher::before{content:"";position:absolute;inset:-5px;border-radius:999px;border:1px solid rgba(209,180,100,.3);opacity:0;animation:fgaPulse 3.8s ease-out 1s 2;pointer-events:none}@keyframes fgaPulse{0%{opacity:0;transform:scale(.98)}20%{opacity:.8}100%{opacity:0;transform:scale(1.12)}}

.fg-ai-panel{position:absolute;right:0;bottom:68px;width:min(438px,calc(100vw - 24px));height:min(710px,calc(100vh - 118px));background:#fff;border:1px solid rgba(209,180,100,.5);border-radius:28px;box-shadow:0 28px 90px rgba(8,8,47,.34);overflow:hidden;display:grid;grid-template-rows:auto auto 1fr auto auto;transform-origin:bottom right;animation:fgaOpen .18s ease-out}
@keyframes fgaOpen{from{opacity:0;transform:translateY(8px) scale(.985)}to{opacity:1;transform:none}}
.fg-ai-panel[hidden]{display:none!important}
.fg-ai-header{background:linear-gradient(145deg,#08082F 0%,#111145 68%,#282153 100%);color:#fff;padding:16px 17px 14px;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;border-bottom:1px solid rgba(209,180,100,.32)}
.fg-ai-mark{width:42px;height:42px;border-radius:15px;display:grid;place-items:center;background:rgba(209,180,100,.14);border:1px solid rgba(209,180,100,.5);color:#e3c96f;font-size:17px}.fg-ai-title strong{display:block;font-family:"Times New Roman",Times,serif;font-size:19px;letter-spacing:.01em}.fg-ai-title span{display:flex;align-items:center;gap:6px;margin-top:3px;color:#cfd0da;font-size:10px}.fg-ai-live-dot{width:6px;height:6px;border-radius:50%;background:#7ce3b0;box-shadow:0 0 0 3px rgba(124,227,176,.1)}
.fg-ai-header-actions{display:flex;gap:4px}.fg-ai-icon-btn{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);color:#fff;display:grid;place-items:center;cursor:pointer}.fg-ai-icon-btn:hover{background:rgba(209,180,100,.16);border-color:rgba(209,180,100,.35)}

.fg-ai-nav{background:#fbfaf7;border-bottom:1px solid var(--fga-line);padding:10px 12px;display:flex;gap:7px;overflow-x:auto;scrollbar-width:none}.fg-ai-nav::-webkit-scrollbar{display:none}.fg-ai-nav button{flex:0 0 auto;border:1px solid rgba(8,8,47,.11);background:#fff;border-radius:999px;padding:8px 11px;color:#33384c;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap}.fg-ai-nav button:hover,.fg-ai-nav button.is-active{background:var(--fga-navy);color:#fff;border-color:var(--fga-navy)}.fg-ai-nav button i{color:var(--fga-gold);margin-right:5px}

.fg-ai-messages{overflow:auto;padding:17px 14px 12px;background:linear-gradient(180deg,#fff 0%,#fbfaf7 100%);scroll-behavior:smooth}.fg-ai-message{display:flex;gap:9px;margin:0 0 14px;align-items:flex-end}.fg-ai-message.is-user{justify-content:flex-end}.fg-ai-avatar{width:28px;height:28px;border-radius:10px;flex:0 0 auto;background:var(--fga-navy);color:var(--fga-gold);display:grid;place-items:center;font-size:11px}.fg-ai-bubble{max-width:86%;border-radius:18px 18px 18px 5px;background:#fff;border:1px solid rgba(8,8,47,.09);box-shadow:0 6px 18px rgba(8,8,47,.05);padding:11px 12px;font-size:12.5px;line-height:1.53;color:#343948}.fg-ai-message.is-user .fg-ai-bubble{background:var(--fga-navy);color:#fff;border:0;border-radius:18px 18px 5px 18px;box-shadow:none}.fg-ai-bubble strong{color:var(--fga-navy)}.fg-ai-message.is-user .fg-ai-bubble strong{color:#fff}.fg-ai-bubble p{margin:0 0 8px}.fg-ai-bubble p:last-child{margin-bottom:0}.fg-ai-bubble ul{padding-left:17px;margin:7px 0}.fg-ai-bubble li{margin:3px 0}.fg-ai-note{margin-top:9px;padding:8px 9px;border-radius:11px;background:#f6f2e7;border-left:3px solid var(--fga-gold);font-size:10.5px;color:#5f6571}.fg-ai-bubble .fg-ai-kicker{display:block;color:#9d761c;text-transform:uppercase;letter-spacing:.12em;font-size:9px;font-weight:800;margin-bottom:6px}.fg-ai-bubble a{color:#8b6719;font-weight:800;text-decoration:none}.fg-ai-bubble a:hover{text-decoration:underline}

.fg-ai-suggestions{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.fg-ai-chip{border:1px solid rgba(8,8,47,.14);background:#fff;color:var(--fga-navy);border-radius:999px;padding:7px 9px;font-size:10.5px;font-weight:700;cursor:pointer}.fg-ai-chip:hover{border-color:var(--fga-gold);background:#f8f4e8}.fg-ai-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.fg-ai-action{display:inline-flex;align-items:center;gap:6px;border:0;border-radius:999px;padding:9px 12px;background:var(--fga-navy);color:#fff!important;font-size:10.5px;font-weight:800;text-decoration:none!important;cursor:pointer}.fg-ai-action.is-gold{background:linear-gradient(135deg,#d9bc62,#ad7f1d);color:#08082F!important}.fg-ai-action.is-light{background:#f1eee5;color:#08082F!important;border:1px solid rgba(8,8,47,.1)}

.fg-ai-category-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.fg-ai-category-card{border:1px solid rgba(8,8,47,.1);border-radius:15px;background:#fff;padding:10px;text-align:left;cursor:pointer}.fg-ai-category-card:hover{border-color:rgba(209,180,100,.8);box-shadow:0 6px 16px rgba(8,8,47,.06)}.fg-ai-category-card i{color:#a77c1d;margin-bottom:7px}.fg-ai-category-card strong{display:block;font-size:11px}.fg-ai-category-card span{display:block;font-size:9.5px;color:#777d89;margin-top:3px;line-height:1.35}

.fg-ai-tool{margin-top:9px;padding:12px;border-radius:16px;background:#f7f5ef;border:1px solid rgba(8,8,47,.1)}.fg-ai-tool h4{font-family:"Times New Roman",Times,serif;font-size:16px;margin:0 0 4px;color:var(--fga-navy)}.fg-ai-tool>p{font-size:10px;color:#6d7380;margin:0 0 10px}.fg-ai-tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.fg-ai-field{display:flex;flex-direction:column;gap:4px}.fg-ai-field.is-full{grid-column:1/-1}.fg-ai-field label{font-size:9px;font-weight:800;color:#545a67;text-transform:uppercase;letter-spacing:.05em}.fg-ai-field input,.fg-ai-field select,.fg-ai-field textarea{width:100%;border:1px solid rgba(8,8,47,.14);background:#fff;border-radius:12px;padding:9px 10px;font:inherit;font-size:11px;color:#08082F;outline:none}.fg-ai-field input:focus,.fg-ai-field select:focus,.fg-ai-field textarea:focus{border-color:#c49d3f;box-shadow:0 0 0 3px rgba(209,180,100,.12)}.fg-ai-tool-submit{margin-top:9px;width:100%;border:0;border-radius:999px;padding:10px;background:var(--fga-navy);color:#fff;font-weight:800;font-size:11px;cursor:pointer}.fg-ai-result{margin-top:10px;background:#fff;border:1px solid rgba(8,8,47,.1);border-radius:13px;padding:10px}.fg-ai-result-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.fg-ai-result-stat{border-radius:11px;background:#faf8f2;padding:8px}.fg-ai-result-stat small{display:block;color:#7d828d;font-size:8.5px;text-transform:uppercase;letter-spacing:.05em}.fg-ai-result-stat strong{display:block;color:#08082F;font-size:14px;margin-top:3px}.fg-ai-result>p{font-size:9.5px;color:#6e7480;margin:8px 0 0}

.fg-ai-compose{padding:10px 11px 9px;border-top:1px solid var(--fga-line);background:#fff}.fg-ai-input-wrap{border:1px solid rgba(8,8,47,.14);border-radius:18px;background:#fbfbfa;display:grid;grid-template-columns:1fr auto;align-items:end;padding:5px 5px 5px 11px;gap:6px}.fg-ai-input{border:0!important;background:transparent!important;resize:none;width:100%;min-height:34px;max-height:88px;padding:8px 0 5px;outline:none!important;box-shadow:none!important;font:12px/1.4 Arial,Helvetica,sans-serif;color:#08082F}.fg-ai-send{width:38px;height:38px;border-radius:50%;border:0;background:var(--fga-navy);color:#fff;display:grid;place-items:center;cursor:pointer}.fg-ai-send:hover{background:#1a1957}.fg-ai-compose-tools{display:flex;align-items:center;justify-content:space-between;padding:6px 3px 0}.fg-ai-compose-tools span{font-size:8.5px;color:#8b9099}.fg-ai-compose-tools button{border:0;background:transparent;color:#7b621f;font-size:9px;font-weight:800;cursor:pointer;padding:2px}
.fg-ai-privacy{padding:0 13px 10px;background:#fff;color:#8a8f98;font-size:8.5px;line-height:1.35}.fg-ai-privacy i{color:#79a58b;margin-right:4px}

.fg-ai-typing{display:flex;gap:3px;padding:3px 2px}.fg-ai-typing span{width:5px;height:5px;background:#9b9faa;border-radius:50%;animation:fgaTyping 1.1s infinite}.fg-ai-typing span:nth-child(2){animation-delay:.15s}.fg-ai-typing span:nth-child(3){animation-delay:.3s}@keyframes fgaTyping{0%,70%,100%{transform:none;opacity:.4}35%{transform:translateY(-3px);opacity:1}}


.fg-ai-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin:10px 0}.fg-ai-summary>div{background:#f7f5ef;border:1px solid rgba(8,8,47,.09);border-radius:12px;padding:8px}.fg-ai-summary small{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:#8a8f98;margin-bottom:3px}.fg-ai-summary strong{display:block;font-size:10.5px;line-height:1.3;color:var(--fga-navy)}

.fg-ai-source{margin-top:8px;font-size:8.5px;color:#8a8f98}.fg-ai-source strong{font-size:8.5px;color:#777d87}
.fg-ai-warn{margin-top:8px;border-radius:11px;padding:8px 9px;background:#fff8e8;border:1px solid #ead7a1;color:#705a24;font-size:9.5px;line-height:1.4}

/* Der bestehende Desktop-Scrollbutton sitzt über dem Assistenten. */
@media(min-width:768px){.fg-back-to-top{bottom:92px!important}}

@media(max-width:767px){
  .fg-ai-assistant{right:12px;bottom:12px;left:12px}
  .fg-ai-launcher{margin-left:auto;height:52px;padding-right:15px}.fg-ai-launcher-copy small{display:none}.fg-ai-launcher-copy strong{font-size:12px}
  .fg-ai-panel{position:fixed;left:7px;right:7px;bottom:7px;width:auto;height:min(82vh,720px);border-radius:24px;transform-origin:bottom center}
  .fg-ai-header{padding:13px}.fg-ai-nav{padding:8px 9px}.fg-ai-messages{padding:13px 10px 9px}.fg-ai-bubble{max-width:91%;font-size:12px}.fg-ai-category-grid{grid-template-columns:1fr 1fr}.fg-ai-tool-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:390px){.fg-ai-summary{grid-template-columns:1fr}.fg-ai-launcher-copy{display:none}.fg-ai-launcher{width:52px;padding:7px}.fg-ai-launcher-icon{width:38px;height:38px}.fg-ai-category-grid,.fg-ai-tool-grid,.fg-ai-result-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.fg-ai-launcher::before,.fg-ai-panel,.fg-ai-typing span{animation:none!important}.fg-ai-launcher,.fg-ai-chip,.fg-ai-category-card{transition:none!important}}

.fg-ai-handoff{margin-top:5px}.fg-ai-handoff>p:first-child{margin-bottom:5px}.fg-ai-action.is-call{background:#eef7f2!important;color:#123b2a!important;border:1px solid rgba(27,108,71,.18)}.fg-ai-action.is-call i{color:#1b6c47}.fg-ai-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.fg-ai-handoff .fg-ai-note{margin-top:8px}
@media(max-width:390px){.fg-ai-summary{grid-template-columns:1fr}}

/* F&G final viewport-safe assistant positioning — 29.08.2026 */
.fg-ai-assistant{z-index:2147480000!important}
@media (min-width:768px){
  .fg-ai-panel{
    position:fixed!important;
    top:calc(var(--fg-header-height,82px) + 12px)!important;
    right:22px!important;
    bottom:90px!important;
    left:auto!important;
    width:min(438px,calc(100vw - 44px))!important;
    height:auto!important;
    max-height:none!important;
  }
  .fg-ai-messages{min-height:0!important}
}
@media (max-width:767px){
  .fg-ai-panel{
    position:fixed!important;
    top:8px!important;
    right:8px!important;
    bottom:8px!important;
    left:8px!important;
    width:auto!important;
    height:auto!important;
    max-height:none!important;
    border-radius:20px!important;
  }
  .fg-ai-nav{gap:5px!important;padding:7px!important}
  .fg-ai-nav button{flex:1 1 0!important;min-width:0!important;padding:8px 5px!important;font-size:10px!important}
  .fg-ai-nav button i{display:block!important;margin:0 auto 3px!important}
  .fg-ai-compose-tools{gap:8px!important}.fg-ai-compose-tools span{max-width:62%}
}
