    <section class="bg-white py-12 md:py-16" id="cta-investor"><div class="container mx-auto px-4 text-center fg-reveal"><p class="fg-section-kicker">Nächster Schritt</p><h2 class="text-3xl font-bold mb-4 text-primary">Investment-Gespräch vereinbaren</h2><p class="text-lg text-gray-600 max-w-3xl mx-auto mb-8">Definieren Sie im Erstgespräch Ihre Investmentstrategie und den weiteren Fahrplan.</p><a href="#terminbuchung" class="btn-85 inline-block py-3 px-8 text-lg font-bold rounded-lg shadow-xl"><i class="fas fa-calendar-check mr-2"></i> Termin für Kapitalanleger auswählen</a></div></section>
  </div>

  <div id="content-eigennutzer" class="hidden">
    <section class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12 fg-reveal"><p class="fg-section-kicker">Von der Suche bis zum Einzug</p><h2 class="text-3xl md:text-5xl font-bold text-primary mb-4">Der Weg in Ihr neues Zuhause</h2><p class="text-lg text-gray-600 max-w-3xl mx-auto">Wir helfen Ihnen, die emotionale Entscheidung für Ihr Eigenheim auf ein solides Fundament zu stellen.</p></div>
        <div class="fg-timeline">
          {% set ownerSteps = [
            ["01","Erstgespräch vereinbaren","Der erste Schritt ins eigene Zuhause: Wir lernen Ihre Wünsche, Rahmenbedingungen und Prioritäten kennen."],
            ["02","Wunschprofil & Strategie","Wir erstellen Ihr persönliches Suchprofil – von Budget und Lage bis zu Zimmeranzahl, Garten und Lebensqualität."],
            ["03","Objektprüfung (Due Diligence)","Wir analysieren die relevanten Unterlagen und wirtschaftlichen Eckdaten, damit Risiken frühzeitig sichtbar werden."],
            ["04","Objektvorstellung","Wir präsentieren Immobilien, die zu Ihrem vorab definierten Wunschprofil passen."],
            ["05","Gemeinsame Besichtigung","Wir begleiten Sie vor Ort, weisen auf Besonderheiten hin und helfen bei einer realistischen Einschätzung von Potenzial und Risiken."],
            ["06","Finanzierung & Verhandlung","Wir verhandeln den Kaufpreis und unterstützen parallel bei der Suche nach einer passenden Bankfinanzierung."],
            ["07","Notar & Einzug","Wir begleiten die Abschlussphase, die Übergabe und bleiben auch nach dem Einzug Ansprechpartner."]
          ] %}
          {% for step in ownerSteps %}<article class="fg-timeline-step fg-reveal"><span>{{ step[0] }}</span><div><h3>{{ step[1] }}</h3><p>{{ step[2] }}</p>{% if loop.first %}<a href="#terminbuchung" class="fg-timeline-link">Termin auswählen <i class="fas fa-arrow-right"></i></a>{% endif %}</div></article>{% endfor %}
        </div>
      </div>
    </section>
    <section class="bg-white py-12 md:py-16" id="cta-eigennutzer"><div class="container mx-auto px-4 text-center fg-reveal"><p class="fg-section-kicker">Nächster Schritt</p><h2 class="text-3xl font-bold mb-4 text-primary">Erstgespräch vereinbaren</h2><p class="text-lg text-gray-600 max-w-3xl mx-auto mb-8">Buchen Sie Ihr unverbindliches Gespräch zur Profilerstellung und zum weiteren Vorgehen.</p><a href="#terminbuchung" class="btn-85 inline-block py-3 px-8 text-lg font-bold rounded-lg shadow-xl"><i class="fas fa-calendar-check mr-2"></i> Termin für Eigennutzer auswählen</a></div></section>
  </div>
