<script>
function switchTab(type) {
  const investor = document.getElementById('content-kapitalanleger');
  const owner = document.getElementById('content-eigennutzer');
  const btnInvestor = document.getElementById('btn-kapitalanleger');
  const btnOwner = document.getElementById('btn-eigennutzer');
  const isInvestor = type === 'kapitalanleger';
  investor.classList.toggle('hidden', !isInvestor);
  owner.classList.toggle('hidden', isInvestor);
  btnInvestor.classList.toggle('is-active', isInvestor);
  btnOwner.classList.toggle('is-active', !isInvestor);
}
</script>
