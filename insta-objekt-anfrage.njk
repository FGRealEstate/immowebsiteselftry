---
layout: base.njk
fgDesign: true
fgSystem: true
fgsHero: false
customSchema: true
permalink: /insta-objekt-anfrage/index.html
title: "Instagram Objektanfrage | Fischer & Geserich Real Estate"
description: "Persönliche Objektanfrage an Fischer & Geserich Real Estate."
robots: "noindex, follow"
# Instagram-Landingpage: bewusst noindex und nicht in der Sitemap.
eleventyExcludeFromCollections: true
# Brief Design-Pass §4.10: neue Vorlage (vorher eigene Seite mit Tailwind-CDN, style.css, FontAwesome und Hintergrundvideo),
# Ablauf nach dem Absenden, Dankeszustand im neuen Design, bleibt noindex.
# Versand unverändert: POST an /.netlify/functions/propstack-inquiry mit denselben Feldern wie bisher (object_id = erstes
# gewähltes Objekt, object_title = alle Titel, selected_objects, zusammengesetzte message, campaign_source „Instagram Kampagne“).
# CP4 (28.10.2026, Design-Sprint-Brief 5.4): Titelzeile ohne Foto, Auswahlkarten wie die Angebotskarten (S4) ohne Etiketten und
# Häkchen auf dem Foto, Auswahl als sichtbares Kästchen unter der Karte; Schritt 2 als fgs-formblock (Text links, Formular rechts).
# Entfallen: Kicker über den H2 (Update 6 §3.0), Gold-Häkchen der Liste (Brief 3.7), Ablauf-Liste neben der H1 (gleiche Sprungmarke dreimal).
# Formular, Feldnamen, versteckte Felder, IDs und data-* für das Skript unverändert; JSON-LD unverändert.
---
{% from "fgd-icons.njk" import icon %}
{% from "fgs-macros.njk" import textlink, closing with context %}
{% set pageUrl = "https://fg-realestate.de/insta-objekt-anfrage/" %}

<section class="fgs-pagehead" aria-labelledby="seiten-titel">
  <div class="fgs-wrap">
    <nav aria-label="Brotkrümelnavigation">
      <ol class="fgs-crumbs">
        <li><a href="/">Start</a></li>
        <li aria-current="page">Objektanfrage</li>
      </ol>
    </nav>
    <p class="fgs-label">Ausgewählte Objekte, persönlich beantwortet.</p>
    <h1 id="seiten-titel">Objektinformationen direkt anfordern</h1>
    <p class="fgs-lead">Wählen Sie eine oder mehrere Immobilien aus unserer aktuellen Auswahl. Wir prüfen Ihre Anfrage persönlich und melden uns mit den passenden nächsten Schritten bei Ihnen.</p>
    <div class="fgs-btns">
      <a class="fgs-btn fgs-btn--primary" href="#anfrage">Objekte auswählen</a>
    </div>
  </div>
</section>

<section class="fgs-section fgs-insta" id="anfrage" aria-labelledby="schritt-titel">
  <div class="fgs-wrap">

    <div data-insta-step="objekte">
      <div class="fgs-offer-head">
        <h2 id="schritt-titel">Welche Immobilie möchten Sie anfragen?</h2>
        <p class="fgs-small">Schritt 1 von 2</p>
      </div>
      <p class="fgs-insta-hint">Wählen Sie bitte mindestens ein Objekt aus. Mehrfachauswahl ist möglich.</p>

      {% if propstack.properties and propstack.properties.length %}
      <div class="fgs-offer-grid">
        {#- Update 7 §3.4: Angebote mit Foto zuerst -#}
        {% for property in (propstack.properties | selectattr("main_image")).concat(propstack.properties | rejectattr("main_image")) %}
        <label class="fgs-offer fgs-pick">
          <span class="fgs-media fgs-offer-media">
            {% if property.main_image %}<img src="{{ property.main_image | propstackFoto }}"{% set _set = property.main_image | propstackSrcset %}{% if _set %} srcset="{{ _set }}" sizes="(min-width: 1100px) 380px, (min-width: 600px) 50vw, 100vw"{% endif %} alt="{{ property.title }}" width="1200" height="900" loading="lazy" decoding="async">{% else %}<span class="fgs-offer-placeholder" role="img" aria-label="Für dieses Angebot folgen die Fotos noch"><span>Foto folgt</span></span>{% endif %}
          </span>
          <span class="fgs-offer-meta">{{ [property.marketing_type, property.property_type, property.location] | select | join(" · ") }}</span>
          <strong class="fgs-offer-title">{{ property.title }}</strong>
          <span class="fgs-offer-price">{{ (property.price | eur) if property.price else "Preis auf Anfrage" }}</span>
          <span class="fgs-pick-facts">{% if property.living_space %}<span>{{ property.living_space }}</span>{% endif %}{% if property.rooms %}<span>{{ property.rooms }} Zi.</span>{% endif %}</span>
          <span class="fgs-pick-state">
            <input type="checkbox" class="js-property-choice" value="{{ property.id }}" data-id="{{ property.id }}" data-title="{{ property.title | escape }}" data-url="{{ property.url }}" data-location="{{ property.location or '' | escape }}" data-price="{{ property.price or 'Preis auf Anfrage' | escape }}" data-type="{{ property.property_type or '' | escape }}">
            <span class="is-off" aria-hidden="true">Auswählen</span><span class="is-on" aria-hidden="true">Ausgewählt</span>
          </span>
        </label>
        {% endfor %}
      </div>
      {% else %}
      <p class="fgs-note">Aktuell konnten keine öffentlichen Angebote geladen werden. Bitte hinterlassen Sie Ihre Kontaktdaten und nennen Sie die gewünschte Immobilie im Nachrichtenfeld.</p>
      {% endif %}

      <div class="fgs-pick-bar">
        <span id="selectedCount" aria-live="polite">Noch kein Objekt ausgewählt</span>
        <button class="fgs-btn fgs-btn--primary" id="continueToForm" type="button" disabled>Auswahl anfragen</button>
      </div>
    </div>

    <div class="fgs-formblock" data-insta-step="formular" hidden>
      <div class="fgs-formblock-text">
        <h2>Wohin dürfen wir die Informationen senden?</h2>
        <p class="fgs-small">Schritt 2 von 2</p>
        <p>Ihre Anfrage wird persönlich geprüft. Anschließend erhalten Sie die nächsten Informationen zu den ausgewählten Immobilien.</p>
        <div class="fgs-form-object">
          <small>Ihre ausgewählten Immobilien</small>
          <ul class="fgs-pick-list" id="selectionList"></ul>
        </div>
        <ul class="fgs-checklist fgs-checklist--one" role="list">
          <li>Diskrete Anfrage<span>Keine öffentliche Suche, keine unnötige Ablenkung.</span></li>
          <li>Persönlich geprüft<span>Ihre Anfrage wird individuell durch unser Team eingeordnet.</span></li>
          <li>Persönliche Rückmeldung<span>Wir melden uns mit den verfügbaren Informationen.</span></li>
          <li>Aktuelle Auswahl<span>Aktuelle Objekte und ausgewählte Off-Market-Hinweise.</span></li>
        </ul>
      </div>

      <div class="fgs-formblock-form">
      <div class="fgd-form-card">
        <h2>Ihre Kontaktdaten</h2>
        <p>Pflichtfelder sind mit * markiert.</p>
        <form method="post" action="/.netlify/functions/propstack-inquiry" class="fgd-form insta-inquiry-form" novalidate>
          <input type="hidden" name="object_id">
          <input type="hidden" name="object_title">
          <input type="hidden" name="selected_objects">
          <div class="fgd-field-row">
            <label>Vorname *<input name="first_name" required autocomplete="given-name"></label>
            <label>Nachname *<input name="last_name" required autocomplete="family-name"></label>
          </div>
          <div class="fgd-field-row">
            <label>E-Mail-Adresse *<input type="email" name="email" required autocomplete="email"></label>
            <label>Telefonnummer<input type="tel" name="phone" autocomplete="tel"></label>
          </div>
          <div class="fgd-field-row">
            <label>Kontakt bevorzugt
              <select name="contact_preference">
                <option value="E-Mail">per E-Mail</option>
                <option value="Telefon">per Telefon</option>
                <option value="WhatsApp">per WhatsApp</option>
              </select>
            </label>
            <label>Gewünschte Information
              <select name="urgency">
                <option value="Allgemeine Objektinformationen">Allgemeine Objektinformationen</option>
                <option value="Exposé und Unterlagen">Exposé und Unterlagen</option>
                <option value="Besichtigung gewünscht">Besichtigung gewünscht</option>
                <option value="Diskrete Rückfrage">Diskrete Rückfrage</option>
              </select>
            </label>
          </div>
          <label>Ihre Nachricht<textarea name="message" rows="5" placeholder="z. B. Rückrufwunsch, gewünschter Zeitraum oder konkrete Frage"></textarea></label>
          <label class="fgd-consent"><input type="checkbox" name="privacy_consent" value="true" required><span>Ich habe die <a href="/datenschutz.html" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Angaben zur Bearbeitung meiner Anfrage zu. *</span></label>
          <div class="fgd-status is-error" data-insta-error hidden>Die Anfrage konnte nicht übermittelt werden. Bitte prüfen Sie Ihre Angaben oder versuchen Sie es erneut.</div>
          <div class="fgs-pick-actions">
            <button type="submit" class="fgd-btn fgd-btn-navy">Objektinformationen anfragen{{ icon("arrow") | safe }}</button>
            <button type="button" class="fgs-pick-back" id="backToObjects">Zurück zur Auswahl</button>
          </div>
        </form>
        <div class="fgd-form-done" data-insta-done tabindex="-1" hidden>
          <h3>Vielen Dank, Ihre Anfrage ist da</h3>
          <p>Wir prüfen Ihre Auswahl persönlich und melden uns mit den Informationen zu den ausgewählten Immobilien. Wenn es eilt, erreichen Sie uns unter <a href="{{ nav.phone.href }}">{{ nav.phone.display }}</a>.</p>
          {{ textlink("/angebote.html", "Alle aktuellen Angebote") }}
        </div>
      </div>
      </div>
    </div>

  </div>
</section>

{% call closing({ kontakt: "lennart", satz: "Fragen zu einem Objekt klären wir gern persönlich", button: "gespraech" }) %}
  <p>Rufen Sie uns an oder schreiben Sie uns. Das erste Gespräch kostet Sie nichts.</p>
{% endcall %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{ pageUrl }}",
  "url": "{{ pageUrl }}",
  "name": "Instagram Objektanfrage | Fischer & Geserich Real Estate",
  "description": "Persönliche Objektanfrage an Fischer & Geserich Real Estate.",
  "inLanguage": "de-DE",
  "isPartOf": { "@id": "https://fg-realestate.de/#website" },
  "publisher": { "@id": "https://fg-realestate.de/#organization" }
}
</script>

<script>
/* Instagram-Objektanfrage: Auswahl (Schritt 1), Kontaktdaten (Schritt 2). Versand wie bisher an propstack-inquiry. */
(function () {
  var choices = [].slice.call(document.querySelectorAll('.js-property-choice'));
  var continueButton = document.getElementById('continueToForm');
  var selectedCount = document.getElementById('selectedCount');
  var stepObjects = document.querySelector('[data-insta-step="objekte"]');
  var stepForm = document.querySelector('[data-insta-step="formular"]');
  var selectionList = document.getElementById('selectionList');
  var backButton = document.getElementById('backToObjects');
  var form = document.querySelector('.insta-inquiry-form');
  var error = document.querySelector('[data-insta-error]');
  var done = document.querySelector('[data-insta-done]');
  var anchor = document.getElementById('anfrage');

  function escapeHtml(value) {
    return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }
  function getSelectedObjects() {
    return choices.filter(function (c) { return c.checked; }).map(function (c) {
      return { id: c.dataset.id || c.value, title: c.dataset.title || 'Ausgewählte Immobilie', url: c.dataset.url || '', location: c.dataset.location || '', price: c.dataset.price || '', type: c.dataset.type || '' };
    });
  }
  function renderSelection() {
    var selected = getSelectedObjects(), count = selected.length;
    selectedCount.textContent = count === 0 ? 'Noch kein Objekt ausgewählt' : count === 1 ? '1 Objekt ausgewählt' : count + ' Objekte ausgewählt';
    continueButton.disabled = count === 0;
    selectionList.innerHTML = selected.map(function (item) {
      var parts = [item.location, item.price].filter(Boolean).join(' · ');
      return '<li>' + escapeHtml(item.title) + (parts ? ' <span>(' + escapeHtml(parts) + ')</span>' : '') + '</li>';
    }).join('');
  }
  function show(step) {
    stepObjects.hidden = step !== 'objekte';
    stepForm.hidden = step !== 'formular';
    anchor.scrollIntoView({ block: 'start' });
  }

  choices.forEach(function (c) { c.addEventListener('change', renderSelection); });
  renderSelection();

  continueButton.addEventListener('click', function () {
    var selected = getSelectedObjects();
    if (!selected.length) return;
    form.elements.object_id.value = selected[0].id;
    form.elements.object_title.value = selected.map(function (i) { return i.title; }).join(' | ');
    form.elements.selected_objects.value = JSON.stringify(selected);
    form.hidden = false; done.hidden = true; error.hidden = true;
    show('formular');
  });
  backButton.addEventListener('click', function () { error.hidden = true; show('objekte'); });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var selected = getSelectedObjects();
    if (!selected.length) { show('objekte'); return; }
    if (!form.reportValidity()) return;
    var submitButton = form.querySelector('button[type="submit"]');
    var original = submitButton.innerHTML;
    var fd = new FormData(form);
    error.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Wird übermittelt …';
    var readableSelection = selected.map(function (item, index) {
      return (index + 1) + '. ' + item.title + '\n' +
        '   Objekt-ID: ' + item.id + '\n' +
        '   Ort: ' + (item.location || '-') + '\n' +
        '   Preis: ' + (item.price || '-') + '\n' +
        '   Link: ' + (location.origin + item.url);
    }).join('\n\n');
    var customerMessage = String(fd.get('message') || '').trim();
    var urgency = String(fd.get('urgency') || '').trim();
    var combinedMessage = [
      'Instagram Objektanfrage', '',
      'Ausgewählte Immobilien:', readableSelection, '',
      'Gewünschte Information:', urgency || '-', '',
      'Nachricht des Interessenten:', customerMessage || '-'
    ].join('\n');
    try {
      var payload = {
        first_name: fd.get('first_name'), last_name: fd.get('last_name'), email: fd.get('email'), phone: fd.get('phone'),
        contact_preference: fd.get('contact_preference'), message: combinedMessage,
        privacy_consent: fd.get('privacy_consent') === 'true',
        object_id: selected[0].id, object_title: selected.map(function (i) { return i.title; }).join(' | '),
        selected_objects: selected, source_url: location.href, campaign_source: 'Instagram Kampagne'
      };
      var res = await fetch('/.netlify/functions/propstack-inquiry', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
      });
      var result = await res.json().catch(function () { return {}; });
      if (!res.ok || !result.success) throw new Error(result.error || 'Übermittlung fehlgeschlagen');
      form.reset();
      choices.forEach(function (c) { c.checked = false; });
      renderSelection();
      form.hidden = true;
      done.hidden = false;
      done.focus();
    } catch (err) {
      console.error('INSTA OBJEKTANFRAGE FEHLER:', err);
      error.hidden = false;
    } finally {
      submitButton.disabled = false;
      submitButton.innerHTML = original;
    }
  });
})();
</script>
