  { href: "/kaufen.html", bild: "kaufen-hero", alt: "Canaletto-Blick in Dresden: die Augustusbrücke über die Elbe, dahinter Frauenkirche und Hofkirche im warmen Licht, vorn die Elbwiesen", titel: "Immobilie kaufen", zeile: "Suchprofil anlegen oder ein Objekt vor dem Kauf prüfen lassen." },
  { href: "/mieten.html", bild: "mieten-hero", alt: "Chamissoplatz in Berlin-Kreuzberg im Sommer von oben, ringsum Altbauten", titel: "Immobilie mieten", zeile: "Mietgesuch mit Ihren Suchkriterien anlegen." },
  { href: "/vermieten.html", bild: "vermieten-hero", alt: "Altbau-Wohnhäuser von Riehmers Hofgarten an der Hagelberger Straße in Berlin-Kreuzberg, rechts ein Baum", titel: "Immobilie vermieten", zeile: "Miethöhe, Vermarktung und Auswahl der Mieter." },
  { href: "/finanzierungsberatung.html", bild: "finanzierung-hero", alt: "Glasfassade eines Bürohauses in der Wilhelmstraße in Berlin-Mitte, in den Fenstern spiegeln sich Wolken", titel: "Finanzierung prüfen", zeile: "Finanzierungsrahmen, Eigenkapital, Monatsrate und passende Banken." },
  { href: "/ankaufsberatung.html", bild: "ankauf-hero", alt: "Das Eckhaus Kurfürstendamm 190 in Berlin-Charlottenburg mit grüner Kuppel an einem sonnigen Junitag", titel: "Ankaufsberatung", zeile: "Objekt, Lage, Rendite, Risiken und Finanzierung vor dem Kauf prüfen." }
] %}
{% call rail({ id: "vorhaben", titel: "Ihr Anliegen", text: "Wählen Sie, worum es geht. Das Formular fragt dann nur, was wir dafür brauchen." }) %}
  {%- for v in vorhaben %}
