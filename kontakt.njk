{% from "fgs-macros.njk" import rail, card, textlink with context %}
{% from "fgd-icons.njk" import icon %}

{# S3 Kontakt: links Formular (Felder, data-Attribute und Versand wie bisher), rechts Anschrift, Karte und Anfahrt #}
<section class="fgs-section" id="schreiben" aria-labelledby="formular-titel">
  <div class="fgs-wrap fgs-contact">
    <div class="fgs-contact-form">
      <h2 id="formular-titel">Schreiben Sie uns oder rufen Sie an</h2>
      <p class="fgs-lead">Ihre Nachricht geht direkt an uns. Ihr Ansprechpartner aus der Region meldet sich bei Ihnen.</p>
      <div class="fgd-form-card" id="kontaktformular">
        <h3>Kontaktformular</h3>
        <p>Pflichtfelder sind mit * markiert.</p>
        <form method="post" action="/.netlify/functions/propstack-lead?frage=Sonstiges" class="fgd-form" data-fgd-lead-form novalidate>
          <label>Thema *
            <select name="concern" required>
              <option value="">Bitte wählen</option>
              <option value="Verkauf">Verkauf</option>
              <option value="Kauf">Kauf</option>
              <option value="Finanzierung">Finanzierung</option>
              <option value="Vermietung">Vermietung</option>
              <option value="Sonstiges" data-endpoint="website-question">Sonstiges</option>
            </select>
          </label>
          <div class="fgd-field-row">
            <label>Vorname *<input name="first_name" required autocomplete="given-name"></label>
            <label>Nachname *<input name="last_name" required autocomplete="family-name"></label>
          </div>
          <div class="fgd-field-row">
            <label>E-Mail *<input name="email" type="email" required autocomplete="email"></label>
            <label>Telefon<input name="phone" type="tel" autocomplete="tel" placeholder="für Rückfragen"></label>
          </div>
          <label>Nachricht *<textarea name="message" rows="5" maxlength="3000" required placeholder="Worum geht es? Zum Beispiel Objekt, Ort und Zeitrahmen"></textarea></label>
          <label class="fgd-hp" aria-hidden="true">Website<input name="company_website" tabindex="-1" autocomplete="off"></label>
          <label class="fgd-consent"><input type="checkbox" name="privacy_consent" value="true" required><span>Ich habe die <a href="/datenschutz.html" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Angaben zur Bearbeitung meiner Anfrage zu. *</span></label>
          <div class="fgd-status" data-fgd-lead-status hidden></div>
          <button type="submit" class="fgd-btn fgd-btn-navy">Nachricht senden{{ icon("arrow") | safe }}</button>
        </form>
        <div class="fgd-form-done" data-fgd-lead-done tabindex="-1" hidden>
          <h3>Vielen Dank, Ihre Nachricht ist da</h3>
          <p>Ihr Ansprechpartner meldet sich bei Ihnen. Wenn es eilt, erreichen Sie uns unter <a href="{{ nav.phone.href }}">{{ nav.phone.display }}</a>.</p>
        </div>
      </div>
      <p class="fgs-note">Ihre Angaben nutzen wir nur, um Ihre Anfrage zu bearbeiten. Wie wir mit Ihren Daten umgehen, steht in der <a href="/datenschutz.html">Datenschutzerklärung</a>.</p>
    </div>

    <div class="fgs-contact-info">
      <h3>Fischer &amp; Geserich Real Estate GmbH</h3>
      <dl class="fgs-contact-list">
        <div><dt>Telefon</dt><dd><a href="{{ nav.phone.href }}">{{ nav.phone.display }}</a></dd></div>
        <div><dt>E-Mail</dt><dd><a href="mailto:{{ nav.email }}">{{ nav.email }}</a></dd></div>
        <div><dt>Geschäftsanschrift</dt><dd>Schützenstraße 30 · 12165 Berlin</dd></div>
        <div><dt>Persönliche Termine</dt><dd>Nach vorheriger Vereinbarung</dd></div>
      </dl>
      {# Statische Karte wie auf Über uns, kein Google-Maps-Embed; der Routenlink öffnet Google Maps erst auf Klick #}
      <figure class="fgs-map">
        <img src="/images/ueber-uns/buero-karte-900.webp" srcset="/images/ueber-uns/buero-karte-600.webp 600w, /images/ueber-uns/buero-karte-900.webp 900w, /images/ueber-uns/buero-karte-1200.webp 1200w" sizes="(min-width: 900px) 30vw, 100vw" width="1200" height="800" alt="Kartenausschnitt von Berlin-Steglitz: Das Büro von Fischer &amp; Geserich liegt in der Schützenstraße 30." loading="lazy" decoding="async">
      </figure>
      <a class="fgs-link" href="https://www.google.com/maps/dir/?api=1&amp;destination=Sch%C3%BCtzenstra%C3%9Fe%2030%2C%2012165%20Berlin" target="_blank" rel="noopener">Route bei Google Maps{% include "fgs-arrow.njk" %}</a>

      {# Anfahrt: Ziel der Links kontakt.html#anfahrt auf anderen Seiten #}
      <h3 id="anfahrt">So erreichen Sie unser Büro in Berlin-Steglitz</h3>
      <p>Unser Büro liegt in der Schützenstraße 30 in 12165 Berlin. Persönliche Termine finden nach vorheriger Vereinbarung statt.</p>
      <ul class="fgs-checklist fgs-checklist--one" role="list">
        <li><strong>S+U Rathaus Steglitz</strong><span>S1 und U9. Von dort sind es etwa 9 Minuten zu Fuß, rund 670 Meter.</span></li>
        <li><strong>Bus</strong><span>Haltestelle Carmerplatz mit den Linien 186, 188 und 283, Haltestelle Händelplatz mit der Linie 285. Beide liegen wenige Gehminuten vom Büro entfernt.</span></li>
      </ul>
      <p class="fgs-note">Geprüft am 26.10.2026 in der <a href="https://www.vbb.de/fahrinfo" target="_blank" rel="noopener">VBB-Fahrinfo</a>. Dort finden Sie auch Ihre aktuelle Verbindung.</p>
    </div>
  </div>
</section>

{# Ansprechpartner je Region als zwei Porträtkarten (Brief 5.5). Lennart: Berlin und Brandenburg, Timon: Leipzig, Dresden und Finanzierung #}
<section class="fgs-section" id="ansprechpartner" aria-labelledby="ansprechpartner-titel">
  <div class="fgs-wrap">
    <div class="fgs-head">
      <h2 id="ansprechpartner-titel">Ihr Ansprechpartner in der Region</h2>
      <p>Berlin und Brandenburg betreut Lennart Geserich, Leipzig und Dresden Timon Fischer. Bei Fragen zur Finanzierung ist Timon Fischer Ihr Ansprechpartner, unabhängig von der Region.</p>
    </div>
    <ul class="fgs-cards2" role="list">
      {{ card({ href: kontakte.lennart.profile | navHref, bild: "/images/team/lennart-geserich-hell" | bild, alt: "Porträt von Lennart Geserich", label: "Berlin · Brandenburg", titel: kontakte.lennart.name, zeile: kontakte.lennart.role }) }}
      {{ card({ href: kontakte.timon.profile | navHref, bild: "/images/team/timon-fischer-hell" | bild, alt: "Porträt von Timon Fischer", label: "Leipzig · Dresden", titel: kontakte.timon.name, zeile: kontakte.timon.role }) }}
    </ul>
  </div>
</section>

