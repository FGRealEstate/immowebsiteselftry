---
layout: base.njk
pagination:
  data: labContent.locations
  size: 1
  alias: location
  addAllPagesToCollections: true
permalink: "standorte/{{ location.slug }}/index.html"
eleventyComputed:
  title: "Immobilienstandort {{ location.name }}"
  description: "Kaufpreise, Mieten, Renditeorientierung, Chancen und Risiken für {{ location.name }}."
---
<div class="content-detail shell">
  <nav class="breadcrumbs"><a href="/index.html">Start</a><span>&rsaquo;</span><a href="/standorte/">Standorte</a><span>›</span><span>{{ location.name }}</span></nav>
  <article class="science-article location-page">
    <header>
      <span class="lab-kicker">{{ location.region }}</span>
      <h1>Standortanalyse {{ location.name }}</h1>
      <p class="lead">Orientierungswerte und qualitative F&amp;G-Einordnung. Angezeigt werden ausschließlich hinterlegte Marktwerte – keine automatisch hochgerechneten Objektpreis-Bandbreiten.</p>
    </header>
    <div class="lab-location-keyfacts-v2">
      <article><span>Kaufpreisorientierung</span><strong>{{ location.price }}</strong></article>
      <article><span>Mietniveau</span><strong>{{ location.rent }}</strong></article>
      <article><span>Renditeorientierung</span><strong>{{ location.yield }}</strong></article>
    </div>
    <div class="lab-location-analysis-grid">
      <section><h2>Chancen</h2><p>{{ location.chance }}</p></section>
      <section><h2>Risiken</h2><p>{{ location.risk }}</p></section>
      <section><h2>Infrastruktur</h2><p>{{ location.infra }}</p></section>
      <section><h2>Perspektive</h2><p>{{ location.future }} {{ location.population }}</p></section>
    </div>
    <section><h2>F&amp;G-Einordnung</h2><p>{{ location.view }}</p></section>
    {% if location.source %}<p class="lab-location-source">Quelle/Orientierung: <a href="{{ location.source }}" target="_blank" rel="noopener noreferrer">externe Marktquelle</a>. Datenstand und Methodik vor Verwendung prüfen.</p>{% endif %}
    <a class="lab-btn lab-btn-gold" href="/investment-lab.html">Standort im Investment Lab vergleichen</a>
  </article>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateAgent",
      "@id": "https://fg-realestate.de/#organization",
      "name": "Fischer & Geserich Real Estate GmbH",
      "url": "https://fg-realestate.de/",
      "areaServed": { "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/#place" }
    },
    {
      "@type": "Place",
      "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/#place",
      "name": {{ location.name | json | safe }},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": {{ location.name | json | safe }},
        "addressCountry": "DE"
      },
      {#-
        O-112 — die Orientierungswerte standen bisher nur im sichtbaren Text.
        Als additionalProperty sind Kaufpreis-, Miet- und Renditeorientierung
        einzeln adressierbar; die Werte sind identisch mit den drei Kacheln
        oben, weil beide aus derselben Datei kommen.
      -#}
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Kaufpreisorientierung", "value": {{ location.price | json | safe }}, "unitText": "EUR/m²" },
        { "@type": "PropertyValue", "name": "Mietniveau", "value": {{ location.rent | json | safe }}, "unitText": "EUR/m²" },
        { "@type": "PropertyValue", "name": "Renditeorientierung", "value": {{ location.yield | json | safe }}, "unitText": "%" },
        { "@type": "PropertyValue", "name": "Chancen", "value": {{ location.chance | json | safe }} },
        { "@type": "PropertyValue", "name": "Risiken", "value": {{ location.risk | json | safe }} },
        { "@type": "PropertyValue", "name": "Infrastruktur", "value": {{ location.infra | json | safe }} },
        { "@type": "PropertyValue", "name": "Ausblick", "value": {{ location.future | json | safe }} },
        { "@type": "PropertyValue", "name": "Einwohnerentwicklung", "value": {{ location.population | json | safe }} },
        { "@type": "PropertyValue", "name": "F&G-Einordnung", "value": {{ location.view | json | safe }} }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/",
      "url": "https://fg-realestate.de/standorte/{{ location.slug }}/",
      "name": {{ ("Standortanalyse " + location.name) | json | safe }},
      "description": {{ location.chance | json | safe }},
      "inLanguage": "de-DE",
      "isPartOf": { "@id": "https://fg-realestate.de/#website" },
      "about": { "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/#place" },
      "dateModified": {{ location.updated | json | safe }},
      "provider": { "@id": "https://fg-realestate.de/#organization" },
      "breadcrumb": { "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://fg-realestate.de/" },
        { "@type": "ListItem", "position": 2, "name": "Standorte", "item": "https://fg-realestate.de/standorte/" },
        { "@type": "ListItem", "position": 3, "name": {{ location.name | json | safe }} }
      ]
    }
  ]
}
</script>
