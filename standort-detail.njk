---
layout: base.njk
pagination:
  data: labContent.locations
  size: 1
  alias: location
permalink: "standorte/{{ location.slug }}/index.html"
eleventyComputed:
  title: "Immobilienstandort {{ location.name }}"
  description: "Kaufpreise, Mieten, Renditeorientierung, Chancen und Risiken für {{ location.name }}."
---
<div class="fg-location-detail">
  <section class="fg-location-detail-hero">
    <div class="fg-location-shell">
      <nav class="fg-location-breadcrumbs" aria-label="Brotkrümelnavigation">
        <a href="/investment-lab.html">Investment Lab</a>
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <a href="/standorte/">Standorte</a>
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">{{ location.name }}</span>
      </nav>

      <div class="fg-location-detail-heading">
        <div>
          <p class="fg-location-kicker">{{ location.region }}</p>
          <h1>Standortanalyse <span>{{ location.name }}</span></h1>
        </div>
        <a class="fg-location-all-link" href="/standorte/">Alle Standorte <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section class="fg-location-detail-content">
    <div class="fg-location-shell">
      <div class="fg-location-keyfacts">
        <article>
          <span>Kaufpreis</span>
          <strong>{{ location.priceValue or location.price }}</strong>
          {% if location.priceNote %}<small>{{ location.priceNote }}</small>{% endif %}
        </article>
        <article>
          <span>Mietniveau</span>
          <strong>{{ location.rentValue or location.rent }}</strong>
          {% if location.rentNote %}<small>{{ location.rentNote }}</small>{% endif %}
        </article>
        <article>
          <span>Rendite</span>
          <strong>{{ location.yieldValue or location.yield }}</strong>
          {% if location.yieldNote %}<small>{{ location.yieldNote }}</small>{% endif %}
        </article>
      </div>

      <div class="fg-location-analysis-grid">
        <article>
          <span class="fg-location-analysis-icon"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i></span>
          <h2>Chancen</h2>
          <p>{{ location.chance }}</p>
        </article>
        <article>
          <span class="fg-location-analysis-icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
          <h2>Risiken</h2>
          <p>{{ location.risk }}</p>
        </article>
        <article>
          <span class="fg-location-analysis-icon"><i class="fas fa-train-subway" aria-hidden="true"></i></span>
          <h2>Infrastruktur</h2>
          <p>{{ location.infra }}</p>
        </article>
        <article>
          <span class="fg-location-analysis-icon"><i class="fas fa-compass" aria-hidden="true"></i></span>
          <h2>Perspektive</h2>
          <p>{{ location.future }}</p>
          {% if location.population %}<p>{{ location.population }}</p>{% endif %}
        </article>
      </div>

      <section class="fg-location-verdict">
        <p class="fg-location-kicker">F&amp;G-Einordnung</p>
        <h2>Was für diesen Standort entscheidend ist.</h2>
        <p>{{ location.view }}</p>
      </section>

      <section class="fg-location-service-area">
        <div>
          <p class="fg-location-kicker">Unser Tätigkeitsgebiet</p>
          <h2>Regional vor Ort. Deutschlandweit finanzieren.</h2>
        </div>
        <p>{{ serviceArea.text }}</p>
      </section>

      <div class="fg-location-actions">
        <a class="btn-85 px-7 py-4" href="/investment-lab.html">Standort im Investment Lab vergleichen <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        <a class="fg-location-secondary-action" href="/kontakt.html">Standort besprechen</a>
      </div>
    </div>
  </section>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "City",
  "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/#place",
  "name": {{ location.name | json | safe }},
  "description": {{ location.view | json | safe }},
  "url": "https://fg-realestate.de/standorte/{{ location.slug }}/",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": {{ location.name | json | safe }},
    "addressCountry": "DE"
  },
  "mainEntityOfPage": { "@id": "https://fg-realestate.de/standorte/{{ location.slug }}/" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Kaufpreisorientierung", "value": {{ (location.priceValue or location.price) | json | safe }} },
    { "@type": "PropertyValue", "name": "Mietniveau", "value": {{ (location.rentValue or location.rent) | json | safe }} },
    { "@type": "PropertyValue", "name": "Renditeorientierung", "value": {{ (location.yieldValue or location.yield) | json | safe }} }
  ]
}
</script>
