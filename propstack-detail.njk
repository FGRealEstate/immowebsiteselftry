---
layout: base.njk
fgDesign: true
fgSystem: true
fgsHero: false
customSchema: true
pagination:
  data: propstack.properties
  size: 1
  alias: property
permalink: "angebote/{{ property.slug }}/index.html"
eleventyComputed:
  title: "{{ property.seite_titel or property.title }}"
  description: "{{ property.title }}{% if property.location %} in {{ property.location }}{% endif %}: Eckdaten, Bilder{% if property.is_investment %}, Investmentkennzahlen und interaktive Szenariorechnung{% endif %}."
  canonicalPath: "{{ property.url }}"
  ogImage: "{{ (property.main_image | propstackOg | safe) if property.main_image else '' }}"
  ogImageAlt: "{% if property.main_image %}{{ property.title }}{% endif %}"
---
{#- Objektseite im neuen Design (Brief Design-Pass §4.5): Ansprechpartner je Region, Links „Finanzierung prüfen“
    und „Ankaufsberatung“, Abschlussblock. Daten unverändert aus _data/propstack.js (property.*).
    Ansprechpartner: Leipzig und Dresden → Timon, sonst Lennart (Brief §4.0).
    Galerie ohne Vorschaubilder: Propstack liefert nur große Bilder, 16 Vorschaubilder hätten die Seite gebremst.
    Der Investment-Check erscheint nur bei Kapitalanlagen zum Kauf mit bekannter Kaltmiete: ohne Miete
    rechnete er bisher mit 0 € und zeigte jeden Cashflow negativ.
    CP4 (28.10.2026, Design-Sprint-Brief 5.4): Design-System über fgs-listing.njk, S8 als Abschluss. Der Investment-Check steht
    hell wie der Kaufpreisrahmen-Rechner (Navy nur im Abschlussband), Rechnung und data-*-Felder unverändert.
    Entfallen: Kicker über den H2 (Update 6 §3.0), Gold-Häkchen in der Ausstattung und Symbole an Ort, Telefon, E-Mail (Brief 3.7).
    CP5 (28.10.2026, Brief 5.5): Galerie über die volle Breite, S6 mit Preis, Fläche, Zimmer (bei Kapitalanlagen Kaltmiete und
    Bruttorendite, sonst Preis / m²), Beschreibung, Eckdaten, Ausstattung, Investment-Check, Gebietsblock, S8 mit „Objekt anfragen“.
    Miete / m² passt nicht mehr in die Zahlenreihe und steht oben in den Eckdaten; Preis / m² steht dort ohnehin („Preis/qm“).
    Die Seitenleiste mit Eckdaten-Karte und Ansprechpartner-Karte entfällt; Telefon und Porträt stehen im S8, die E-Mail im Fuß
    (kontakte.js hat keine eigene Adresse je Person). -#}
{% from "fgs-listing.njk" import listingTitle, gallery, galleryScript, listingFacts, areaBlock %}
{% from "fgs-macros.njk" import faktSymbol, pic %}
{% from "fgs-macros.njk" import textlink, closing with context %}
{% set loc = (property.location or "") | lower %}
{#- Teil B 4 (31.10.2026): Ansprechpartner aus _data/propstack.js (findKontakt), sonst die bisherige Ortsregel #}
{% set kontaktKey = property.kontakt or ("timon" if ("leipzig" in loc or "dresden" in loc) else "lennart") %}
{% set pageUrl = "https://fg-realestate.de" + property.url %}
{% set showCheck = property.is_investment and property.marketing_type == "Kauf" and property.cold_rent_raw and property.purchase_price_raw %}
{#- Update 27 A1: Ort unter dem Titel mit Ortsteil („Westend, Berlin“), ohne ihn die Stadt -#}
{% set ortZeile = (property.ortsteil ~ ", " ~ property.location) if (property.ortsteil and property.location and property.ortsteil != property.location) else (property.ortsteil or property.location) %}
{% set meta %}{{ [ortZeile, property.property_type, ("Nr. " ~ property.unit_number) if property.unit_number else ""] | select | join(" · ") }}{% if property.project_url %}{% if property.location or property.property_type or property.unit_number %} · {% endif %}Teil von <a href="{{ property.project_url }}">{{ property.project_name }}</a>{% endif %}{% endset %}
{% set k1 = { href: property.request_url, label: "Objekt anfragen" } %}
{% if property.marketing_type != "Miete" %}{% set knoepfe = [k1, { href: "/finanzierungsberatung", label: "Finanzierung prüfen" }] %}{% else %}{% set knoepfe = [k1] %}{% endif %}
{% if property.project_url %}{% set crumbs = [{ href: "/angebote", label: "Angebote" }, { href: property.project_url, label: property.project_name }] %}{% else %}{% set crumbs = [{ href: "/angebote", label: "Angebote" }] %}{% endif %}

{% set fakten = [{ wert: (property.price | eur) if property.price else "auf Anfrage", label: "Kaltmiete / Monat" if property.marketing_type == "Miete" else "Kaufpreis" }] %}
{% set mehr = [] %}
{% set mitMiete = property.is_investment and property.cold_rent %}
{% if property.living_space %}{% set fakten = fakten.concat([{ wert: property.living_space, label: "Wohnfläche" }]) %}{% endif %}
{% if property.rooms %}{% set fakten = fakten.concat([{ wert: property.rooms, label: "Zimmer" }]) %}{% endif %}
{#- Preis / m² steht bei Kapitalanlagen nur in den Eckdaten (propstack.js liefert ihn dort als „Preis/qm“) -#}
{% if property.price_per_sqm and property.marketing_type != "Miete" and not mitMiete %}{% set fakten = fakten.concat([{ wert: property.price_per_sqm | eur, label: "Preis / m²" }]) %}{% endif %}
{% if mitMiete %}{% set fakten = fakten.concat([{ wert: property.cold_rent | eur, label: "Kaltmiete / Monat" }]) %}{% endif %}
{% if property.is_investment and property.gross_yield %}{% set fakten = fakten.concat([{ wert: property.gross_yield, label: "Bruttorendite" }]) %}{% endif %}
{% if property.is_investment and property.rent_per_sqm %}{% set mehr = mehr.concat([{ wert: property.rent_per_sqm | eur, label: "Miete / m²" }]) %}{% endif %}

{#- Update 68 §3/§4 (18.11.2026): Kontaktkarte, neue Abschnitte und Finanzierungsrechner -#}
{%- set kontakt = kontakte[kontaktKey] %}
{%- set kontaktTel = kontakt.phone or nav.phone %}
{%- set rf = finanzierung.vorgaben %}
{%- set rfFehlt = [] %}
{%- if rf.eigenkapital_prozent_vom_kaufpreis === null %}{% set _ = rfFehlt.push("Eigenkapital in Prozent vom Kaufpreis") %}{% endif %}
{%- if rf.sollzins_prozent === null %}{% set _ = rfFehlt.push("Sollzins") %}{% endif %}
{%- if rf.tilgung_prozent === null %}{% set _ = rfFehlt.push("Tilgung") %}{% endif %}
{%- if rf.notar_grundbuch_prozent === null %}{% set _ = rfFehlt.push("Notar und Grundbuch") %}{% endif %}
{%- set rechnerVoll = rfFehlt.length == 0 %}
{%- set grest = finanzierung.grunderwerbsteuer[property.bundesland] if property.bundesland else null %}
{%- set zeigeRechner = property.marketing_type == "Kauf" and property.purchase_price_raw and grest and (rechnerVoll or freigaben.finanzrechner) %}
{%- set energieLabels = [] %}{% for e in (property.energie or []) %}{% set _ = energieLabels.push(e.label) %}{% endfor %}
{%- set planIndex = property.gallery.indexOf(property.grundrisse[0]) if (property.grundrisse and property.grundrisse.length and property.gallery) else -1 %}
{#- Update 27 A3 (01.11.2026): erster Bildschirm. Das Titelbild (= erstes Galeriebild) über die volle Breite, 16 : 9 am Desktop,
    4 : 3 auf dem Handy; darunter Titel, Ort und die zwei Buttons, dann die Eckdaten. Vorher stand oben nur der Titel auf Beige. -#}
{%- set faktenHtml %}{{ listingFacts(fakten, property.title, true) }}{% endset %}
<section class="fgs-listing-top" aria-labelledby="seitentitel">
  {{ gallery(property.gallery, property.title, "Für dieses Angebot folgen die Fotos noch", property.cover, ((property.ortsteil or property.location or " ") if property.cover_design else false), property.grundrisse) }}
  <div class="fgs-wrap">
    {{ listingTitle({
      kicker: property.strategy ~ ((" · " ~ property.marketing_type) if property.marketing_type else ""),
      titel: property.h1_titel or property.title,
      leitzeile: property.leitzeile if property.h1_titel else null,
      meta: meta,
      buttons: knoepfe,
      fakten: faktenHtml
    }) }}
  </div>
</section>

<section class="fgs-section fgs-listing" aria-label="Angaben zum Objekt">
  <div class="fgs-wrap">
  {#- Update 68 §3.2: ab 1024 px rechts die Kontaktkarte (position: sticky unter dem Kopf), links die Abschnitte; darunter über
      die volle Breite der Gebietsblock. Unter 1024 px keine Karte, dort zeigt die Leiste unten „Anfragen“ und „Anrufen“. -#}
  <div class="fgs-listing-raster">
    <div class="fgs-listing-haupt">
    {%- if zeigeRechner %}
    {#- Update 68 §4: Finanzierungsrechner, eigenes JavaScript ohne Drittanbieter. Sätze aus _data/finanzierung.json (Grunderwerbsteuer
        je Land mit Quelle); Vorgaben von Timon. Fehlen sie, bleiben die Felder leer (kein erfundener Sollzins), Notar und Grundbuch
        zählen nicht mit und der rote Hinweis steht da; dann baut nur die Testumgebung den Block (freigaben.finanzrechner). -#}
    <section class="fgs-listing-block fgs-cols fgs-rechner" id="finanzierung" aria-labelledby="rechner-titel" data-finanzrechner data-objekt-id="{{ property.id }}" data-objekt="{{ property.title }}" data-grest="{{ grest.satz }}" data-provision="{{ property.provision_prozent or 0 }}"{% if rf.eigenkapital_prozent_vom_kaufpreis !== null %} data-ek-prozent="{{ rf.eigenkapital_prozent_vom_kaufpreis }}"{% endif %}{% if rf.notar_grundbuch_prozent !== null %} data-notar="{{ rf.notar_grundbuch_prozent }}"{% endif %}>
      <div class="fgs-cols-head"><h2 id="rechner-titel">Finanzierung durchrechnen</h2></div>
      <div class="fgs-cols-body">
        {%- if not rechnerVoll %}
        <p class="fgs-rechner-platzhalter" role="note">Platzhalter, von Timon fehlen noch: {{ rfFehlt | join(", ") }}</p>
        {%- endif %}
        <div class="fgd-form fgs-rechner-felder">
          <label>Kaufpreis<span class="fgd-unit"><input data-r="kaufpreis" inputmode="decimal" autocomplete="off" value="{{ property.purchase_price_raw | deZahl }}"><b>€</b></span></label>
          <label>Eigenkapital<span class="fgd-unit"><input data-r="eigenkapital" inputmode="decimal" autocomplete="off" value="{{ ((property.purchase_price_raw * rf.eigenkapital_prozent_vom_kaufpreis / 100) | round | deZahl) if rf.eigenkapital_prozent_vom_kaufpreis !== null }}"><b>€</b></span></label>
          <label>Sollzins p.&nbsp;a.<span class="fgd-unit"><input data-r="sollzins" inputmode="decimal" autocomplete="off" value="{{ (rf.sollzins_prozent | deZahl(2)) if rf.sollzins_prozent !== null }}"><b>%</b></span></label>
          <label>Anfängliche Tilgung<span class="fgd-unit"><input data-r="tilgung" inputmode="decimal" autocomplete="off" value="{{ (rf.tilgung_prozent | deZahl(2)) if rf.tilgung_prozent !== null }}"><b>%</b></span></label>
        </div>
        <div class="fgs-rechner-rate" aria-live="polite"><span class="fgs-rechner-rate-label">Monatliche Rate</span><strong data-r-aus="rate">–</strong></div>
        <dl class="fgs-rechner-posten">
          <div><dt>Grunderwerbsteuer ({{ grest.land }}, {{ grest.satz | deZahl(1) }}&nbsp;%)</dt><dd data-r-aus="grest">–</dd></div>
          <div><dt>Notar und Grundbuch{% if rf.notar_grundbuch_prozent !== null %} ({{ rf.notar_grundbuch_prozent | deZahl(1) }}&nbsp;%){% endif %}</dt><dd data-r-aus="notar">{% if rf.notar_grundbuch_prozent === null %}<span class="fgs-rechner-fehlt">Zahl von Timon fehlt</span>{% else %}–{% endif %}</dd></div>
          <div><dt>Maklerprovision{% if property.provision_prozent %} ({{ property.provision_prozent | deZahl(2) }}&nbsp;%){% endif %}</dt><dd data-r-aus="makler">{{ "provisionsfrei" if not property.provision_prozent else "–" }}</dd></div>
          <div class="fgs-rechner-summe"><dt>Kaufnebenkosten</dt><dd data-r-aus="nebenkosten">–</dd></div>
          <div class="fgs-rechner-summe"><dt>Gesamtkosten</dt><dd data-r-aus="gesamt">–</dd></div>
          <div class="fgs-rechner-summe"><dt>Darlehen</dt><dd data-r-aus="darlehen">–</dd></div>
        </dl>
        <p class="fgs-note">Unverbindliche Beispielrechnung. Ihre persönlichen Konditionen rechnet Timon Fischer mit Ihnen durch.</p>
        <div class="fgs-btns"><a class="fgs-btn fgs-btn--primary" href="/finanzierungsberatung#anfrage" data-r-anfrage>Finanzierung mit Timon Fischer prüfen</a></div>
      </div>
    </section>
    {%- endif %}
    {% if property.descriptions and property.descriptions.length %}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="objekt-lage">
      <div class="fgs-cols-head"><h2 id="objekt-lage">Objekt und Lage</h2></div>
      <div class="fgs-cols-body">
        {% for d in property.descriptions %}{% if d.value %}<div class="fgs-listing-text"><h3>{{ d.label }}</h3><div>{{ d.value | exposeText | safe }}</div></div>{% endif %}{% endfor %}
        <p class="fgs-note">Zwischenverkauf und Änderungen vorbehalten.</p>
      </div>
    </section>
    {% endif %}
    {#- Update 68 §3.4: Angaben, die jetzt im Abschnitt „Energieausweis“ stehen (z. B. Effizienzklasse), nicht doppelt -#}
    {% if mehr.length or (property.details and property.details.length) %}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="eckdaten-titel">
      <div class="fgs-cols-head"><h2 id="eckdaten-titel">Eckdaten</h2></div>
      <div class="fgs-cols-body">
        <dl class="fgs-listing-details">
          {% for d in mehr %}<div><dt>{{ d.label }}</dt><dd>{{ d.wert }}</dd></div>{% endfor %}
          {% for d in property.details %}{% if d.value and not (d.label in energieLabels) %}<div><dt>{{ d.label }}</dt><dd>{{ d.value | eur }}</dd></div>{% endif %}{% endfor %}
        </dl>
      </div>
    </section>
    {% endif %}
    {%- if property.energie and property.energie.length %}
    {#- Update 68 §3.4: Pflichtangaben nach § 87 GEG, nur mit Daten aus Propstack -#}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="energie-titel">
      <div class="fgs-cols-head"><h2 id="energie-titel">Energieausweis</h2></div>
      <div class="fgs-cols-body">
        <dl class="fgs-listing-details">
          {% for e in property.energie %}<div><dt>{{ e.label }}</dt><dd>{{ e.wert }}</dd></div>{% endfor %}
        </dl>
      </div>
    </section>
    {%- endif %}
    {%- if property.kosten and property.kosten.length %}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="kosten-titel">
      <div class="fgs-cols-head"><h2 id="kosten-titel">Kosten</h2></div>
      <div class="fgs-cols-body">
        <dl class="fgs-listing-details">
          {% for k in property.kosten %}<div><dt>{{ k.label }}</dt><dd>{{ k.wert }}</dd></div>{% endfor %}
        </dl>
      </div>
    </section>
    {%- endif %}
    {%- if planIndex > -1 %}
    {#- Grundriss: In Propstack als Bild der Galerie mit Kennzeichen Grundriss, nicht als Dokument. Der Link öffnet ihn im Großbild. -#}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="unterlagen-titel">
      <div class="fgs-cols-head"><h2 id="unterlagen-titel">Unterlagen</h2></div>
      <div class="fgs-cols-body">
        <ul class="fgs-unterlagen" role="list">
          <li><a href="{{ property.grundrisse[0] | propstackFoto(1600) }}" data-gallery-zeige="{{ planIndex }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 4.5h15v15h-15zM4.5 11h6M13.5 11h6M11 4.5v4M11 13v6.5"/></svg>Grundriss ansehen</a></li>
        </ul>
      </div>
    </section>
    {%- endif %}
    {%- if property.tour %}
    {#- 3D-Rundgang: Vorschaubild mit Abspielknopf, das iframe des Anbieters lädt erst nach dem Klick (§5: kein Drittinhalt ohne Klick) -#}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="tour-titel">
      <div class="fgs-cols-head"><h2 id="tour-titel">3D-Rundgang</h2></div>
      <div class="fgs-cols-body">
        <div class="fgs-tour fgs-media" data-tour="{{ property.tour }}">
          {%- if property.cover and property.cover.url %}<img src="{{ property.cover.url | propstackFoto }}" alt="" width="1200" height="800" loading="lazy" decoding="async">{% endif %}
          <button type="button" class="fgs-tour-start" data-tour-start><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false" fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"/></svg><span>3D-Rundgang starten</span></button>
        </div>
        <p class="fgs-note">Beim Start lädt der Rundgang vom Anbieter ({{ property.tour | tourAnbieter }}).</p>
      </div>
    </section>
    {%- endif %}
    {% if property.features and property.features.length %}
    <section class="fgs-listing-block fgs-cols" aria-labelledby="ausstattung">
      <div class="fgs-cols-head"><h2 id="ausstattung">Was das Objekt mitbringt</h2></div>
      <div class="fgs-cols-body">
        <ul class="fgs-listing-features" role="list">
          {% for f in property.features %}{% if f.value %}<li>{{ f.label }}{% if f.value != "Ja" %}: {{ f.value }}{% endif %}</li>{% endif %}{% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}
    {% if showCheck %}
    <section class="fgs-listing-block fgs-cols fgs-invest" aria-labelledby="investment-check" data-investment-cockpit data-price="{{ property.purchase_price_raw or 0 }}" data-rent="{{ property.cold_rent_raw or 0 }}" data-costs="{{ property.investment_defaults.monthly_non_recoverable or 0 }}" data-equity="{{ property.investment_defaults.equity_percent or 20 }}" data-interest="{{ property.investment_defaults.interest_percent or 3.5 }}" data-repayment="{{ property.investment_defaults.repayment_percent or 2 }}" data-acquisition="{{ property.investment_defaults.acquisition_cost_percent or 10 }}">
      <div class="fgs-cols-head"><h2 id="investment-check">Was passiert, wenn Sie die Finanzierung verändern?</h2></div>
      <div class="fgs-cols-body">
        <p class="fgs-invest-intro">Die Rechnung ist eine Orientierung auf Basis der verfügbaren Objektdaten. Ändern Sie Zins, Tilgung oder Eigenkapital und Cashflow, Eigenkapitalbedarf und Restschuld rechnen sich sofort neu.</p>
        <div class="fgs-invest-fields">
          <label>Kaufpreis (€)<input type="number" min="0" step="1000" inputmode="numeric" data-invest-price></label>
          <label>Kaltmiete / Monat (€)<input type="number" min="0" step="10" inputmode="numeric" data-invest-rent></label>
          <label>Nicht umlagefähig / Monat (€)<input type="number" min="0" step="10" inputmode="numeric" data-invest-costs></label>
          <label>Sollzins (%)<input type="number" min="0" step="0.1" inputmode="decimal" data-invest-interest></label>
          <label>Tilgung (%)<input type="number" min="0" step="0.1" inputmode="decimal" data-invest-repayment></label>
          <label>Kaufnebenkosten (%)<input type="number" min="0" step="0.1" inputmode="decimal" data-invest-acquisition></label>
          <label class="fgs-invest-range">Eigenkapital in Prozent des Kaufpreises: <b data-invest-equity-label></b><input type="range" min="0" max="60" step="1" data-invest-equity></label>
        </div>
        <dl class="fgs-invest-results">
          <div><dt>Bruttorendite</dt><dd data-invest-yield>–</dd></div>
          <div><dt>Cashflow / Monat</dt><dd data-invest-cashflow>–</dd></div>
          <div><dt>Eigenkapitalbedarf</dt><dd data-invest-equity-amount>–</dd></div>
          <div><dt>Restschuld nach 10 Jahren</dt><dd data-invest-debt10>–</dd></div>
        </dl>
        <div class="fgs-invest-chart">
          <p class="fgs-small">Restschuld in Jahren</p>
          <div class="fgs-invest-bars" data-debt-bars aria-hidden="true"></div>
          <div class="fgs-invest-bar-labels" aria-hidden="true"><span>Start</span><span>5</span><span>10</span><span>15</span><span>20</span></div>
        </div>
        <p class="fgs-note"><strong data-cashflow-copy>–</strong> Vor Steuern; vereinfachte Annuitätenrechnung ohne individuelle Steuerwirkung. Die Vorgaben für Zins, Tilgung und Nebenkosten sind Annahmen, keine Finanzierungszusage.</p>
        {{ textlink("/investment-lab", "Mehr Szenarien im Investment Lab") }}
        {#- Update 7, Frage 27: Textlink zur Ankaufsberatung am Ende des Investment-Checks, Wortlaut aus dem Update #}
        <p class="fgs-invest-ankauf">Sie möchten das Objekt vor dem Kauf prüfen lassen? {{ textlink("/ankaufsberatung", "Zur Ankaufsberatung") }}</p>
      </div>
    </section>
    {% endif %}
    </div>
    <aside class="fgs-listing-kontakt" aria-label="Ansprechpartner für dieses Objekt">
      <div class="fgs-kontaktkarte">
        <div class="fgs-kontaktkarte-kopf">
          {{ pic(("/images/team/" + (kontakt.name | slugify) + "-navy") | bild, "", "72px") }}
          <div><p class="fgs-kontaktkarte-name">{{ kontakt.name }}</p><p class="fgs-small">{{ kontakt.role }}</p></div>
        </div>
        <a class="fgs-btn fgs-btn--primary" href="{{ property.request_url }}">Objekt anfragen</a>
        <a class="fgs-btn fgs-btn--secondary" href="{{ kontaktTel.href }}" aria-label="Anrufen: {{ kontaktTel.display }}">{{ faktSymbol("telefon") }}Anrufen</a>
        <p class="fgs-small fgs-kontaktkarte-tel">{{ kontaktTel.display }}</p>
      </div>
    </aside>
  </div>

    {{ areaBlock(property.area, "lage-markt", property.preisart, property.marketing_type == "Kauf") }}
  </div>
</section>

{% call closing({ kontakt: kontaktKey, satz: "Fragen zu diesem Objekt?", knopf: { href: property.request_url, label: "Objekt anfragen" } }) %}
  <p>Wir beantworten Ihre Fragen zu Objekt, Lage und Finanzierung persönlich. Das erste Gespräch kostet Sie nichts.</p>
{% endcall %}

{{ galleryScript() }}

{%- if zeigeRechner %}
<script>
/* Update 68 §4: Finanzierungsrechner. Monatliche Rate = Darlehen × (Sollzins + Tilgung) ÷ 12; Darlehen = Gesamtkosten − Eigenkapital.
   GA4 (über GTM): finanzierung_rechner einmal je Seitenaufruf bei der ersten Eingabe, finanzierung_anfrage beim Knopf, beide mit
   objekt_id. Die Werte gehen über sessionStorage (nicht über die Adresse, damit sie nicht in page_location landen) an das
   Anfrageformular der Finanzierungsberatung, das sie als versteckte Felder mitschickt. */
(function () {
  var root = document.querySelector('[data-finanzrechner]');
  if (!root) return;
  var feld = function (n) { return root.querySelector('[data-r="' + n + '"]'); };
  var aus = function (n) { return root.querySelector('[data-r-aus="' + n + '"]'); };
  var zahl = function (el) { var t = String(el.value || '').replace(/\s|€|%/g, '').replace(/\./g, '').replace(',', '.'); var n = parseFloat(t); return isFinite(n) && n >= 0 ? n : null; };
  var eur = function (n) { return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n); };
  var grest = Number(root.dataset.grest) || 0, prov = Number(root.dataset.provision) || 0;
  var notar = root.dataset.notar !== undefined ? Number(root.dataset.notar) : null;
  /* Update 71 §1.1: Eigenkapital ist eine Vorgabe in Prozent vom Kaufpreis; das Feld zeigt den Eurobetrag. Ändert man den Kaufpreis,
     zieht der Betrag mit, bis man selbst ein Eigenkapital eintippt. */
  var ekProzent = root.dataset.ekProzent !== undefined ? Number(root.dataset.ekProzent) : null, ekEigen = false;
  var werte = {};
  function rechnen() {
    var kp = zahl(feld('kaufpreis')), ek = zahl(feld('eigenkapital')) || 0, zins = zahl(feld('sollzins')), tilg = zahl(feld('tilgung'));
    werte = { kaufpreis: kp, eigenkapital: ek, sollzins: zins, tilgung: tilg, rate: null };
    if (kp === null) { ['grest', 'nebenkosten', 'gesamt', 'darlehen', 'rate'].forEach(function (n) { aus(n).textContent = '–'; }); return; }
    var g = kp * grest / 100, nt = notar !== null ? kp * notar / 100 : 0, mk = kp * prov / 100, nk = g + nt + mk, ges = kp + nk, dl = Math.max(0, ges - ek);
    aus('grest').textContent = eur(g);
    if (notar !== null) aus('notar').textContent = eur(nt);
    if (prov) aus('makler').textContent = eur(mk);
    aus('nebenkosten').textContent = eur(nk);
    aus('gesamt').textContent = eur(ges);
    aus('darlehen').textContent = eur(dl);
    if (zins !== null && tilg !== null) { werte.rate = dl * (zins + tilg) / 100 / 12; aus('rate').textContent = eur(werte.rate); }
    else aus('rate').textContent = '–';
  }
  var gemeldet = false;
  root.addEventListener('input', function (ev) {
    if (ev.target === feld('eigenkapital')) ekEigen = true;
    else if (ev.target === feld('kaufpreis') && ekProzent !== null && !ekEigen) {
      var kpNeu = zahl(feld('kaufpreis'));
      feld('eigenkapital').value = kpNeu === null ? '' : new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Math.round(kpNeu * ekProzent / 100));
    }
    rechnen();
    if (gemeldet) return;
    gemeldet = true;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'finanzierung_rechner', objekt_id: root.dataset.objektId });
  });
  var knopf = root.querySelector('[data-r-anfrage]');
  if (knopf) knopf.addEventListener('click', function () {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'finanzierung_anfrage', objekt_id: root.dataset.objektId });
    var de = function (n, s) { return n === null || n === undefined ? '' : new Intl.NumberFormat('de-DE', { minimumFractionDigits: s, maximumFractionDigits: s }).format(n); };
    try {
      sessionStorage.setItem('fgFinanzrechner', JSON.stringify({
        'Objekt-ID': root.dataset.objektId, 'Objekt': root.dataset.objekt, 'Objektseite': location.pathname,
        'Rechner Kaufpreis': werte.kaufpreis !== null ? de(werte.kaufpreis, 0) + ' €' : '',
        'Rechner Eigenkapital': de(werte.eigenkapital, 0) + ' €',
        'Rechner Sollzins': werte.sollzins !== null ? de(werte.sollzins, 2) + ' %' : '',
        'Rechner Tilgung': werte.tilgung !== null ? de(werte.tilgung, 2) + ' %' : '',
        'Rechner Monatsrate': werte.rate !== null ? de(werte.rate, 0) + ' €' : ''
      }));
    } catch (e) {}
  });
  rechnen();
})();
</script>
{%- endif %}

<script>
(function () {
  var root = document.querySelector('[data-investment-cockpit]');
  if (!root) return;
  var q = function (s) { return root.querySelector(s); };
  var num = function (x) { return Math.max(0, Number(x) || 0); };
  var eur = function (n) { return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n); };
  var pct = function (n) { return new Intl.NumberFormat('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(n) + ' %'; };
  var f = { price: q('[data-invest-price]'), rent: q('[data-invest-rent]'), costs: q('[data-invest-costs]'), interest: q('[data-invest-interest]'), repayment: q('[data-invest-repayment]'), acq: q('[data-invest-acquisition]'), equity: q('[data-invest-equity]') };
  f.price.value = root.dataset.price || 0; f.rent.value = root.dataset.rent || 0; f.costs.value = Math.round(Number(root.dataset.costs) || 0);
  f.interest.value = root.dataset.interest || 3.5; f.repayment.value = root.dataset.repayment || 2; f.acq.value = root.dataset.acquisition || 10; f.equity.value = root.dataset.equity || 20;
  function debtAfter(principal, rate, annual, years) { var m = rate / 100 / 12, p = annual / 12, d = principal; for (var k = 0; k < years * 12; k++) d = Math.max(0, d * (1 + m) - p); return d; }
  function calc() {
    var price = num(f.price.value), rent = num(f.rent.value), costs = num(f.costs.value), interest = num(f.interest.value), rep = num(f.repayment.value), acq = num(f.acq.value), eq = num(f.equity.value);
    var loan = price * (1 - eq / 100), equityAmount = price * eq / 100 + price * acq / 100, annual = loan * (interest + rep) / 100, cash = rent - costs - annual / 12;
    q('[data-invest-equity-label]').textContent = pct(eq);
    q('[data-invest-yield]').textContent = pct(price ? rent * 12 / price * 100 : 0);
    q('[data-invest-cashflow]').textContent = (cash >= 0 ? '+ ' : '− ') + eur(Math.abs(cash));
    q('[data-invest-equity-amount]').textContent = eur(equityAmount);
    q('[data-invest-debt10]').textContent = eur(debtAfter(loan, interest, annual, 10));
    q('[data-cashflow-copy]').textContent = (cash >= 0 ? 'Positiver' : 'Negativer') + ' Cashflow: ' + (cash >= 0 ? '+ ' : '− ') + eur(Math.abs(cash)) + ' pro Monat.';
    var bars = q('[data-debt-bars]'); bars.innerHTML = '';
    [0, 5, 10, 15, 20].forEach(function (y) { var d = y ? debtAfter(loan, interest, annual, y) : loan, b = document.createElement('i'); b.style.height = (loan ? Math.max(3, d / loan * 100) : 3) + '%'; b.title = y + ' Jahre: ' + eur(d); bars.appendChild(b); });
  }
  Object.keys(f).forEach(function (key) { if (f[key]) f[key].addEventListener('input', calc); });
  calc();
})();
</script>

