---
layout: base.njk
pagination:
  data: propstack.properties
  size: 1
  alias: property
permalink: "angebote/{{ property.slug }}/index.html"
eleventyComputed:
  title: "{{ property.title }} | Fischer & Geserich Real Estate"
  description: "{{ property.title }}{% if property.location %} in {{ property.location }}{% endif %}: Eckdaten, Bilder{% if property.is_investment %}, Investmentkennzahlen und interaktive Szenariorechnung{% endif %}."
  canonicalPath: "{{ property.url }}"
---
<div class="fg-property-v3">
<section class="fg-property-hero"><div class="fg-premium-shell"><div class="fg-property-hero-grid"><div><span class="fg-property-strategy"><i class="fas {% if property.is_investment %}fa-chart-line{% else %}fa-house{% endif %}"></i>{{ property.strategy }}{% if property.marketing_type %} · {{ property.marketing_type }}{% endif %}</span><h1>{{ property.title }}</h1>{% if property.location %}<p><i class="fas fa-location-dot"></i> {{ property.location }}</p>{% endif %}</div><a href="{{ property.request_url }}" class="btn-85 px-7 py-4">Objekt anfragen <i class="fas fa-arrow-right"></i></a></div></div></section>
<section class="fg-premium-shell"><div class="fg-property-layout"><main>
{% if property.gallery and property.gallery.length %}<section class="fg-property-gallery"><div class="fg-property-gallery-main" data-property-gallery>{% for image in property.gallery %}<img src="{{ image }}" alt="{{ property.title }} – Bild {{ loop.index }}" class="{% if loop.first %}is-active{% endif %}">{% endfor %}{% if property.gallery.length > 1 %}<button class="prev" type="button" data-gallery-prev aria-label="Vorheriges Bild"><i class="fas fa-chevron-left"></i></button><button class="next" type="button" data-gallery-next aria-label="Nächstes Bild"><i class="fas fa-chevron-right"></i></button><span class="fg-property-gallery-count"><b data-gallery-current>1</b> / {{ property.gallery.length }}</span>{% endif %}</div></section>{% endif %}
{% if property.is_investment and property.marketing_type == 'Kauf' %}<section class="fg-invest-mini" data-investment-cockpit data-price="{{ property.purchase_price_raw or 0 }}" data-rent="{{ property.cold_rent_raw or 0 }}" data-costs="{{ property.investment_defaults.monthly_non_recoverable or 0 }}" data-equity="{{ property.investment_defaults.equity_percent or 20 }}" data-interest="{{ property.investment_defaults.interest_percent or 3.5 }}" data-repayment="{{ property.investment_defaults.repayment_percent or 2 }}" data-acquisition="{{ property.investment_defaults.acquisition_cost_percent or 10 }}"><div class="fg-invest-mini-head"><div><p class="fg-premium-kicker fg-premium-kicker-light">Investment Check · interaktiv</p><h2>Was passiert, wenn Sie die Finanzierung verändern?</h2><p>Die Rechnung ist eine Orientierung auf Basis der aktuell verfügbaren Objektdaten. Regler und Felder verändern Cashflow, Eigenkapitalbedarf und Restschuld sofort.</p></div><span class="fg-property-strategy"><i class="fas fa-flask"></i> Live-Szenario</span></div><div class="fg-invest-controls"><div class="fg-invest-control"><label>Kaufpreis €</label><input type="number" min="0" step="1000" data-invest-price></div><div class="fg-invest-control"><label>Kaltmiete / Monat €</label><input type="number" min="0" step="10" data-invest-rent></div><div class="fg-invest-control"><label>Nicht umlagefähig / Monat €</label><input type="number" min="0" step="10" data-invest-costs></div><div class="fg-invest-control"><label>Sollzins %</label><input type="number" min="0" step="0.1" data-invest-interest></div><div class="fg-invest-control"><label>Tilgung %</label><input type="number" min="0" step="0.1" data-invest-repayment></div><div class="fg-invest-control"><label>Kaufnebenkosten %</label><input type="number" min="0" step="0.1" data-invest-acquisition></div><div class="fg-invest-control fg-invest-slider"><label>Eigenkapitalquote Kaufpreis: <b data-invest-equity-label></b></label><input type="range" min="0" max="60" step="1" data-invest-equity></div></div><div class="fg-invest-results"><div class="fg-invest-result"><span>Bruttorendite</span><strong data-invest-yield>–</strong></div><div class="fg-invest-result"><span>Cashflow / Monat</span><strong data-invest-cashflow>–</strong></div><div class="fg-invest-result"><span>Eigenkapitalbedarf</span><strong data-invest-equity-amount>–</strong></div><div class="fg-invest-result"><span>Restschuld nach 10 J.</span><strong data-invest-debt10>–</strong></div></div><div class="fg-invest-charts"><div class="fg-invest-chart"><h3>Restschuldverlauf</h3><div class="fg-debt-bars" data-debt-bars></div><div class="fg-debt-labels"><span>Start</span><span>5 J.</span><span>10 J.</span><span>15 J.</span><span>20 J.</span></div></div><div class="fg-invest-chart"><h3>Monatlicher Cashflow</h3><div class="fg-cashflow-gauge"><i data-cashflow-gauge></i></div><strong data-cashflow-copy>–</strong><p style="color:#aeb3c3;font-size:.78rem;margin-top:8px">Vor Steuern; vereinfachte Annuitätenrechnung ohne individuelle Steuerwirkung.</p></div></div><a class="fg-invest-link" href="/investment-lab.html">Mehr Szenarien im Investment Lab <i class="fas fa-arrow-right"></i></a></section>{% endif %}
{% if property.descriptions and property.descriptions.length %}<section class="fg-property-box"><h2>Objekt &amp; Lage</h2>{% for description in property.descriptions %}{% if description.value %}<div class="fg-property-prose"><h3>{{ description.label }}</h3>{{ description.value | safe }}</div>{% endif %}{% endfor %}</section>{% endif %}
{% if property.features and property.features.length %}<section class="fg-property-box"><h2>Ausstattung</h2><div class="fg-premium-grid-3">{% for feature in property.features %}{% if feature.value %}<article class="fg-premium-card"><h3>{{ feature.label }}</h3><p>{{ feature.value }}</p></article>{% endif %}{% endfor %}</div></section>{% endif %}
</main><aside class="fg-property-sidebar"><span class="fg-premium-kicker">{{ property.strategy }}</span><p class="fg-property-price">{{ property.price or 'Preis auf Anfrage' }}</p><div class="fg-property-kpis">{% if property.living_space %}<div class="fg-property-kpi"><span>Wohnfläche</span><strong>{{ property.living_space }}</strong></div>{% endif %}{% if property.rooms %}<div class="fg-property-kpi"><span>Zimmer</span><strong>{{ property.rooms }}</strong></div>{% endif %}{% if property.price_per_sqm %}<div class="fg-property-kpi"><span>Preis / m²</span><strong>{{ property.price_per_sqm }}</strong></div>{% endif %}{% if property.is_investment and property.cold_rent %}<div class="fg-property-kpi"><span>Kaltmiete</span><strong>{{ property.cold_rent }}</strong></div>{% endif %}{% if property.is_investment and property.gross_yield %}<div class="fg-property-kpi"><span>Bruttorendite</span><strong>{{ property.gross_yield }}</strong></div>{% endif %}{% if property.is_investment and property.rent_per_sqm %}<div class="fg-property-kpi"><span>Miete / m²</span><strong>{{ property.rent_per_sqm }}</strong></div>{% endif %}</div>{% if property.details and property.details.length %}<h2 style="font-size:1.5rem;margin:24px 0 14px">Eckdaten</h2><dl>{% for detail in property.details %}{% if detail.value %}<div style="display:flex;justify-content:space-between;gap:18px;padding:10px 0;border-bottom:1px solid #edf0f3"><dt style="color:#737b88">{{ detail.label }}</dt><dd style="margin:0;text-align:right;font-weight:800;color:#08082f">{{ detail.value }}</dd></div>{% endif %}{% endfor %}</dl>{% endif %}<a href="{{ property.request_url }}" class="btn-85 w-full py-4 mt-6">Objekt anfragen</a><a href="/angebote.html" style="display:block;text-align:center;margin-top:16px;color:#08082f;font-weight:800">Zurück zu den Angeboten</a></aside></div></section></div>
<script>
(function(){const gallery=document.querySelector('[data-property-gallery]');if(gallery){const slides=[...gallery.querySelectorAll('img')],cur=gallery.querySelector('[data-gallery-current]');let i=0;const show=n=>{slides[i]?.classList.remove('is-active');i=(n+slides.length)%slides.length;slides[i]?.classList.add('is-active');if(cur)cur.textContent=i+1};gallery.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>show(i-1));gallery.querySelector('[data-gallery-next]')?.addEventListener('click',()=>show(i+1));}
const root=document.querySelector('[data-investment-cockpit]');if(!root)return;const q=s=>root.querySelector(s),num=x=>Math.max(0,Number(x)||0),eur=n=>new Intl.NumberFormat('de-DE',{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(n),pct=n=>new Intl.NumberFormat('de-DE',{minimumFractionDigits:1,maximumFractionDigits:1}).format(n)+' %';const f={price:q('[data-invest-price]'),rent:q('[data-invest-rent]'),costs:q('[data-invest-costs]'),interest:q('[data-invest-interest]'),repayment:q('[data-invest-repayment]'),acq:q('[data-invest-acquisition]'),equity:q('[data-invest-equity]')};f.price.value=root.dataset.price||0;f.rent.value=root.dataset.rent||0;f.costs.value=root.dataset.costs||0;f.interest.value=root.dataset.interest||3.5;f.repayment.value=root.dataset.repayment||2;f.acq.value=root.dataset.acquisition||10;f.equity.value=root.dataset.equity||20;function debtAfter(principal,annualRate,annualPayment,years){const m=annualRate/100/12,p=annualPayment/12;let d=principal;for(let k=0;k<years*12;k++)d=Math.max(0,d*(1+m)-p);return d}function calc(){const price=num(f.price.value),rent=num(f.rent.value),costs=num(f.costs.value),interest=num(f.interest.value),rep=num(f.repayment.value),acq=num(f.acq.value),eq=num(f.equity.value);const loan=price*(1-eq/100),equityAmount=price*eq/100+price*acq/100,annualPayment=loan*(interest+rep)/100,monthlyDebt=annualPayment/12,cash=rent-costs-monthlyDebt,yieldV=price?rent*12/price*100:0,debt10=debtAfter(loan,interest,annualPayment,10);q('[data-invest-equity-label]').textContent=pct(eq);q('[data-invest-yield]').textContent=pct(yieldV);q('[data-invest-cashflow]').textContent=(cash>=0?'+ ':'− ')+eur(Math.abs(cash));q('[data-invest-equity-amount]').textContent=eur(equityAmount);q('[data-invest-debt10]').textContent=eur(debt10);q('[data-cashflow-copy]').textContent=(cash>=0?'Positiver':'Negativer')+' Cashflow: '+(cash>=0?'+ ':'− ')+eur(Math.abs(cash))+' / Monat';const gauge=q('[data-cashflow-gauge]');gauge.style.width=Math.max(5,Math.min(100,50+cash/10))+'%';const bars=q('[data-debt-bars]');bars.innerHTML='';[0,5,10,15,20].forEach(y=>{const d=y?debtAfter(loan,interest,annualPayment,y):loan,b=document.createElement('i');b.style.height=(loan?Math.max(4,d/loan*100):4)+'%';b.title=y+' Jahre: '+eur(d);bars.appendChild(b)})}Object.values(f).forEach(el=>el?.addEventListener('input',calc));calc();})();
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"RealEstateListing",
  "name":{{ property.title | dump | safe }},
  "url":"https://fg-realestate.de{{ property.url }}",
  "description":{{ property.title | dump | safe }},
  "offers":{
    "@type":"Offer",
    "url":"https://fg-realestate.de{{ property.url }}",
    "availability":"https://schema.org/InStock"{% if property.purchase_price_raw %},
    "price":{{ property.purchase_price_raw }},
    "priceCurrency":"EUR"{% endif %}
  },
  "seller":{"@id":"https://fg-realestate.de/#organization"}{% if property.main_image %},
  "image":{{ property.gallery | dump | safe }}{% endif %}
}
</script>
