---
layout: base.njk
pagination:
  data: propstack.properties
  size: 1
  alias: property
  addAllPagesToCollections: true
permalink: "angebote/{{ property.slug }}/index.html"
---

<section class="bg-primary text-white py-16 md:py-24">
    <div class="container mx-auto px-4 text-center">

        {% if property.marketing_type or property.property_type %}
        <p class="text-secondary mb-3 font-semibold uppercase tracking-wide">
            {{ property.marketing_type }}{% if property.marketing_type and property.property_type %} · {% endif %}{{ property.property_type }}
        </p>
        {% endif %}

        <h1 class="text-4xl md:text-5xl font-extrabold mb-4 leading-tight">
            {{ property.title }}
        </h1>

        {% if property.location %}
        <p class="text-lg text-secondary">
            <i class="fas fa-map-marker-alt mr-2"></i>{{ property.location }}
        </p>
        {% endif %}

    </div>
</section>

<section class="container mx-auto px-4 py-16">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">

        <div class="lg:col-span-2 space-y-8">

            {% if property.gallery and property.gallery.length %}
            <section class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div id="property-slider" class="relative w-full bg-white">

                    <div class="relative w-full h-[360px] md:h-[520px] lg:h-[620px] bg-white flex items-center justify-center overflow-hidden">

                        {% for image in property.gallery %}
                        <img
                            src="{{ image }}"
                            alt="{{ property.title }}"
                            class="property-slide absolute inset-0 w-full h-full object-contain bg-white {% if loop.first %}opacity-100 pointer-events-auto{% else %}opacity-0 pointer-events-none{% endif %} transition-opacity duration-500"
                        >
                        {% endfor %}

                        {% if property.gallery.length > 1 %}
                        <button
                            type="button"
                            id="slider-prev"
                            class="absolute left-4 md:left-6 top-1/2 -translate-y-1/2 bg-white/95 text-primary rounded-full w-11 h-11 md:w-12 md:h-12 shadow-lg flex items-center justify-center hover:bg-secondary transition"
                            aria-label="Vorheriges Bild">
                            <i class="fas fa-chevron-left"></i>
                        </button>

                        <button
                            type="button"
                            id="slider-next"
                            class="absolute right-4 md:right-6 top-1/2 -translate-y-1/2 bg-white/95 text-primary rounded-full w-11 h-11 md:w-12 md:h-12 shadow-lg flex items-center justify-center hover:bg-secondary transition"
                            aria-label="Nächstes Bild">
                            <i class="fas fa-chevron-right"></i>
                        </button>

                        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-primary/85 text-white px-4 py-2 rounded-full text-sm shadow-lg">
                            <span id="slider-current">1</span> / {{ property.gallery.length }}
                        </div>
                        {% endif %}

                    </div>
                </div>
            </section>
            {% endif %}

            {% if property.descriptions and property.descriptions.length %}
            <section class="bg-white rounded-xl shadow-xl p-8 md:p-10">
                <h2 class="text-3xl font-bold text-primary mb-8">
                    Beschreibung
                </h2>

                <div class="space-y-8">
                    {% for description in property.descriptions %}
                    {% if description.value %}
                    <div>
                        <h3 class="text-xl font-bold text-primary mb-3">
                            {{ description.label }}
                        </h3>

                        <div class="text-gray-700 leading-relaxed text-lg prose max-w-none">
                            {{ description.value | safe }}
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {% if property.features and property.features.length %}
            <section class="bg-white rounded-xl shadow-xl p-8 md:p-10">
                <h2 class="text-3xl font-bold text-primary mb-8">
                    Ausstattung
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for feature in property.features %}
                    {% if feature.value %}
                    <div class="bg-gray-50 rounded-lg p-4 flex items-start gap-3">
                        <i class="fas fa-check-circle text-accent mt-1"></i>

                        <div class="text-gray-700">
                            <strong class="text-primary">{{ feature.label }}</strong>
                            {% if feature.value and feature.value != "Ja" %}
                            <span>: {{ feature.value }}</span>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </section>
            {% endif %}

        </div>

        <aside class="lg:col-span-1">
            <div class="bg-white rounded-xl shadow-xl p-8 sticky top-8 border-t-4 border-accent">

                {% if property.price %}
                <div class="mb-8">
                    <p class="text-gray-500 mb-1">Kaufpreis</p>
                    <p class="text-3xl font-extrabold text-primary">
                        {{ property.price }}
                    </p>
                </div>
                {% endif %}

                <div class="grid grid-cols-2 gap-4 mb-8">

                    {% if property.living_space %}
                    <div class="bg-gray-50 rounded-lg p-4 text-center">
                        <i class="fas fa-ruler-combined text-accent mb-2"></i>
                        <p class="font-bold text-primary">{{ property.living_space }}</p>
                        <p class="text-sm text-gray-500">Wohnfläche</p>
                    </div>
                    {% endif %}

                    {% if property.rooms %}
                    <div class="bg-gray-50 rounded-lg p-4 text-center">
                        <i class="fas fa-bed text-accent mb-2"></i>
                        <p class="font-bold text-primary">{{ property.rooms }}</p>
                        <p class="text-sm text-gray-500">Zimmer</p>
                    </div>
                    {% endif %}

                    {% if property.bedrooms %}
                    <div class="bg-gray-50 rounded-lg p-4 text-center">
                        <i class="fas fa-door-closed text-accent mb-2"></i>
                        <p class="font-bold text-primary">{{ property.bedrooms }}</p>
                        <p class="text-sm text-gray-500">Schlafzimmer</p>
                    </div>
                    {% endif %}

                    {% if property.bathrooms %}
                    <div class="bg-gray-50 rounded-lg p-4 text-center">
                        <i class="fas fa-bath text-accent mb-2"></i>
                        <p class="font-bold text-primary">{{ property.bathrooms }}</p>
                        <p class="text-sm text-gray-500">Badezimmer</p>
                    </div>
                    {% endif %}

                </div>

                {% if property.details and property.details.length %}
                <h2 class="text-2xl font-bold text-primary mb-6">
                    Eckdaten
                </h2>

                <div class="space-y-4 text-gray-700">
                    {% for detail in property.details %}
                    {% if detail.value %}
                    <div class="flex justify-between gap-6 border-b border-gray-100 pb-3">
                        <span>{{ detail.label }}</span>
                        <strong class="text-right text-primary">{{ detail.value }}</strong>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}

                <a href="{{ property.request_url }}" class="btn-85 block text-center text-primary font-bold py-4 mt-8 rounded-lg shadow-md">
                    Objekt anfragen
                </a>

                <a href="/angebote.html" class="block text-center text-primary mt-5 font-semibold hover:underline">
                    Zurück zu den Angeboten
                </a>

            </div>
        </aside>

    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const slides = document.querySelectorAll(".property-slide");
    const prevButton = document.getElementById("slider-prev");
    const nextButton = document.getElementById("slider-next");
    const currentLabel = document.getElementById("slider-current");

    if (!slides.length) return;

    let currentIndex = 0;

    function showSlide(index) {
        slides[currentIndex].classList.remove("opacity-100", "pointer-events-auto");
        slides[currentIndex].classList.add("opacity-0", "pointer-events-none");

        currentIndex = (index + slides.length) % slides.length;

        slides[currentIndex].classList.remove("opacity-0", "pointer-events-none");
        slides[currentIndex].classList.add("opacity-100", "pointer-events-auto");

        if (currentLabel) {
            currentLabel.textContent = currentIndex + 1;
        }
    }

    if (prevButton) {
        prevButton.addEventListener("click", function () {
            showSlide(currentIndex - 1);
        });
    }

    if (nextButton) {
        nextButton.addEventListener("click", function () {
            showSlide(currentIndex + 1);
        });
    }

    document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowLeft") {
            showSlide(currentIndex - 1);
        }

        if (event.key === "ArrowRight") {
            showSlide(currentIndex + 1);
        }
    });
});
</script>

{# ------------------------------------------------------------------
   O-114 / F-334 — strukturierte Daten fuer Objektdetailseiten.
   Adressfelder und Geokoordinaten nur, wenn Propstack `hide_address`
   nicht gesetzt hat; sonst bleibt es bei der oeffentlichen Lageangabe.
   ------------------------------------------------------------------ #}
{%- set r = property.raw -%}
{%- set base = "https://fg-realestate.de/angebote/" + property.slug + "/" -%}
{%- set avail = "https://schema.org/InStock" -%}
{%- if property.status == "Reserviert" %}{% set avail = "https://schema.org/LimitedAvailability" %}{% endif -%}
{%- if property.status == "Verkauft" or property.status == "Vermietet" %}{% set avail = "https://schema.org/SoldOut" %}{% endif -%}
{%- set accType = "Accommodation" -%}
{%- if property.property_type == "Wohnen" %}{% set accType = "Apartment" %}{% endif -%}
{%- if property.property_type == "Haus" %}{% set accType = "House" %}{% endif -%}
{%- set descText = property.descriptions[0].value if property.descriptions and property.descriptions.length else property.title -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateListing",
      "@id": "{{ base }}#angebot",
      "url": "{{ base }}",
      "name": {{ property.title | json | safe }},
      "description": {{ descText | json | safe }},
      "inLanguage": "de-DE",
      "isPartOf": { "@id": "https://fg-realestate.de/#website" },
      "provider": { "@id": "https://fg-realestate.de/#organization" },
      "breadcrumb": { "@id": "{{ base }}#breadcrumb" },
      "about": { "@id": "{{ base }}#objekt" }{% if property.main_image %},
      "image": {{ property.gallery | json | safe }}{% endif %}{% if property.price_raw %},
      "offers": { "@id": "{{ base }}#offer" }{% endif %}
    },
    {
      "@type": "{{ accType }}",
      "@id": "{{ base }}#objekt",
      "name": {{ property.title | json | safe }},
      "url": "{{ base }}",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "DE",
        "addressLocality": {{ (r.city or property.location) | json | safe }}{% if r.region %},
        "addressRegion": {{ r.region | json | safe }}{% endif %}{% if not r.hide_address %}{% if r.zip_code %},
        "postalCode": {{ r.zip_code | json | safe }}{% endif %}{% if r.street %},
        "streetAddress": {{ (r.street + (" " + r.house_number if r.house_number else "")) | json | safe }}{% endif %}{% endif %}
      }{% if not r.hide_address and r.lat and r.lng %},
      "geo": { "@type": "GeoCoordinates", "latitude": {{ r.lat }}, "longitude": {{ r.lng }} }{% endif %}{% if property.living_space_raw %},
      "floorSize": { "@type": "QuantitativeValue", "value": {{ property.living_space_raw }}, "unitCode": "MTK" }{% endif %}{% if property.rooms_raw %},
      "numberOfRooms": {{ property.rooms_raw }}{% endif %}{% if property.bedrooms_raw %},
      "numberOfBedrooms": {{ property.bedrooms_raw }}{% endif %}{% if property.bathrooms_raw %},
      "numberOfBathroomsTotal": {{ property.bathrooms_raw }}{% endif %}{% if r.floor and r.floor.value %},
      "floorLevel": {{ r.floor.value | string | json | safe }}{% endif %}{% if r.build_year and r.build_year.value %},
      "yearBuilt": {{ r.build_year.value }}{% endif %}{% if property.main_image %},
      "photo": {{ property.main_image | json | safe }}{% endif %},
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Vermarktungsart", "value": {{ property.marketing_type | json | safe }} },
        { "@type": "PropertyValue", "name": "Objektart", "value": {{ property.property_type | json | safe }} }{% if r.number_of_floors and r.number_of_floors.value %},
        { "@type": "PropertyValue", "name": "Etagenzahl", "value": {{ r.number_of_floors.value }} }{% endif %}{% if property.status %},
        { "@type": "PropertyValue", "name": "Status", "value": {{ property.status | json | safe }} }{% endif %}{% if property.price_per_sqm %},
        { "@type": "PropertyValue", "name": "Preis pro Quadratmeter", "value": {{ property.price_per_sqm | json | safe }} }{% endif %}{% if r.energy_efficiency_class and r.energy_efficiency_class.value %},
        { "@type": "PropertyValue", "name": "Energieeffizienzklasse", "value": {{ r.energy_efficiency_class.value | json | safe }} }{% endif %}{% if r.thermal_characteristic and r.thermal_characteristic.value %},
        { "@type": "PropertyValue", "name": "Energieverbrauchskennwert", "value": {{ r.thermal_characteristic.value }}, "unitText": "kWh/(m²·a)" }{% endif %}{% if property.project_name %},
        { "@type": "PropertyValue", "name": "Projekt", "value": {{ property.project_name | json | safe }} }{% endif %}
      ]
    }{% if property.price_raw %},
    {
      "@type": "Offer",
      "@id": "{{ base }}#offer",
      "url": "{{ base }}",
      "price": {{ property.price_raw }},
      "priceCurrency": "EUR",
      "availability": "{{ avail }}",
      "businessFunction": "{% if property.marketing_type == "Miete" %}http://purl.org/goodrelations/v1#LeaseOut{% else %}http://purl.org/goodrelations/v1#Sell{% endif %}",
      "itemOffered": { "@id": "{{ base }}#objekt" },
      "seller": { "@id": "https://fg-realestate.de/#organization" }
    }{% endif %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ base }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://fg-realestate.de/" },
        { "@type": "ListItem", "position": 2, "name": "Angebote", "item": "https://fg-realestate.de/angebote.html" },
        { "@type": "ListItem", "position": 3, "name": {{ property.title | json | safe }} }
      ]
    }
  ]
}
</script>
